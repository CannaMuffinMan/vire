define check with fails, got, want
  if got != want
    return fails + 1
  end
  return fails
end

define blank
end

define area with w, h
  return w * h
end

define numbers with fails
  let fails be check with fails, (5 / 2), 2.5
  let fails be check with fails, (4 / 2), 2
  let fails be check with fails, (escape with "Vire" + "</p>"), "Vire</p>"
  let fails be check with fails, (area with (1 + 2), 4), 12
  let fails be check with fails, blank, none
  return fails
end

define records with fails
  let row be parse with json with {"n": 2.5}
  let fails be check with fails, (row at "n"), 2.5
  let fails be check with fails, (join with (split with "a,b", ","), "-"), "a-b"
  let fails be check with fails, (kind with [1]), "list"
  let fails be check with fails, (has with {"ok": true}, "ok"), true
  let fails be check with fails, term, "term"
  return fails
end

define trouble with fails
  try
    number with "nope"
    return fails + 1
  miss problem
  end
  try
    let unused be 1 / 0
    return fails + 1
  miss problem
  end
  return fails
end

define guard with fails
  try
    read with "count.vire"
    return fails + 1
  miss problem
    if (find with problem, "data or site") < 0
      return fails + 1
    end
  end
  try
    fetch with "http://127.0.0.1:9/"
    return fails + 1
  miss problem
    if (find with problem, "private") < 0
      return fails + 1
    end
  end
  try
    write with "nope.exe", "x"
    return fails + 1
  miss problem
  end
  if (length with text with now) < 16
    return fails + 1
  end
  return fails
end

define tools with fails
  let fails be check with fails, (replace with "a-b-a", "a", "c"), "c-b-c"
  let fails be check with fails, (begins with "vire", "vi"), true
  let fails be check with fails, (ends with "vire", "re"), true
  let fails be check with fails, (round with 2.5), 3
  write with "data/log.txt", "one"
  append with "data/log.txt", "two"
  let fails be check with fails, (read with "data/log.txt"), "onetwo"
  let fails be check with fails, (exists with "data/log.txt"), true
  erase with "data/log.txt"
  let fails be check with fails, (exists with "data/log.txt"), false
  try
    copy with "data/log.txt", "bad.exe"
    return fails + 1
  miss problem
  end
  let n be pick with 4
  if n < 0
    return fails + 1
  end
  if n > 3
    return fails + 1
  end
  return fails
end

define picture with fails
  term
  open with "sheet"
  sheet with 40, 20
  ink with 1, 2, 3
  fill with 4, 5, 6, 7
  stroke with 8, 9, 10, 11
  dot with 12, 13, 2
  let row be marks at 0
  let fails be check with fails, (row at "kind"), "fill"
  let fails be check with fails, (row at "a"), 4
  let fails be check with fails, (row at "r"), 1
  let fails be check with fails, (row at "blue"), 3
  let fails be check with fails, (length with marks), 3
  let drawn be marks at 1
  let fails be check with fails, (drawn at "kind"), "stroke"
  let spot be marks at 2
  let fails be check with fails, (spot at "kind"), "dot"
  return fails
end
