use "src/rt-schema.vire"

define proveOk with tag, got
  if (got at 0) == "ok"
    say tag + " PASS"
    return 0
  end
  say tag + " FAIL got " + (got at 0) + " " + (got at 1)
  return 1
end

define proveBad with tag, got, needle
  if (got at 0) != "bad"
    say tag + " FAIL expected reject got " + (got at 0)
    return 1
  end
  let why be got at 1
  if (find with why, needle) < 0
    say tag + " FAIL why=" + why + " need " + needle
    return 1
  end
  say tag + " REJECT " + why
  return 0
end

define fillText with n, ch
  let s be ""
  let i be 0
  while i < n
    let s be s + ch
    let i be i + 1
  end
  return s
end

define main
  let fails be 0
  let health be schema_health
  let good be {"ok": true, "service": "fcgcpa", "payments": false}
  let fails be fails + (proveOk with "HEALTH valid", (schema_check with good, health))

  let badType be {"ok": 1, "service": "fcgcpa", "payments": false}
  let fails be fails + (proveBad with "TYPE mismatch", (schema_check with badType, health), "type mismatch")

  let missing be {"ok": true, "payments": false}
  let fails be fails + (proveBad with "MISSING required", (schema_check with missing, health), "missing required")

  let extra be {"ok": true, "service": "fcgcpa", "payments": false, "x": 1}
  let fails be fails + (proveBad with "UNKNOWN field", (schema_check with extra, health), "unknown field")

  let longName be fillText with 40, "a"
  let longBody be {"ok": true, "service": longName, "payments": false}
  let fails be fails + (proveBad with "OVERSIZE string", (schema_check with longBody, health), "oversize string")

  let listShape be {"type": "list", "item": {"type": "number"}, "max": 8}
  let xs be [1, 2, 3, 4, 5, 6, 7, 8, 9]
  let fails be fails + (proveBad with "OVERSIZE array", (schema_check with xs, listShape), "oversize array")

  let deepArr be 0
  let deepShape be {"type": "number"}
  let di be 0
  while di < 20
    let deepArr be [deepArr]
    let deepShape be {"type": "list", "item": deepShape}
    let di be di + 1
  end
  let fails be fails + (proveBad with "ADV too-deep array", (schema_check with deepArr, deepShape), "too-deep nesting")

  let deepObj be 0
  let deepMapShape be {"type": "number"}
  let di be 0
  while di < 20
    let deepObj be {"n": deepObj}
    let deepMapShape be {"type": "map", "fields": {"n": deepMapShape}}
    let di be di + 1
  end
  let fails be fails + (proveBad with "ADV too-deep object", (schema_check with deepObj, deepMapShape), "too-deep nesting")

  let optShape be {"type": "map", "fields": {"ok": {"type": "bool"}, "note": {"type": "text", "need": false, "max": 8}}}
  let fails be fails + (proveOk with "OPTIONAL absent", (schema_check with {"ok": true}, optShape))

  let rangeShape be {"type": "number", "min": 0, "max": 10}
  let fails be fails + (proveBad with "NUMBER range", (schema_check with (0 - 1), rangeShape), "number out of range")
  let fails be fails + (proveBad with "NUMBER high", (schema_check with 11, rangeShape), "number out of range")
  let fails be fails + (proveOk with "NUMBER mid", (schema_check with 5, rangeShape))

  try
    parse with "{not json"
    say "ADV bad json FAIL lived"
    let fails be fails + 1
  miss why
    say "ADV bad json REJECT json is not valid"
  end

  let two be [[0]]
  let twoShape be {"type": "list", "item": {"type": "list", "item": {"type": "number"}}}
  let fails be fails + (proveOk with "DEPTH two lists", (schema_check with two, twoShape))

  let parsed be schema_parse with "{\"ok\":true,\"service\":\"fcgcpa\",\"payments\":false}", health
  let fails be fails + (proveOk with "HEALTH json parse", parsed)

  if fails == 0
    say "SCHEMA PROVE pass"
  else
    say "SCHEMA PROVE fails " + (text with fails)
  end
end
