~ Couch Potato night-city shell. Static HTML and CSS. No embeds, audio, or payments.
~ The program folder is the sandbox. write only allows site/ and data/.

define lines with parts
  return join with parts, "\n"
end

define markup
  return lines with [
    "<!DOCTYPE html>",
    "<html lang=\"en\">",
    "<head>",
    "<meta charset=\"utf-8\">",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "<title>Couch Potato App — Forever Couch Gang</title>",
    "<meta name=\"description\" content=\"Watch across streams in one Forever Couch Gang feed. Build your space in Night City.\">",
    "<link rel=\"stylesheet\" href=\"app.css\">",
    "</head>",
    "<body>",
    "<div class=\"nebula-bg\" aria-hidden=\"true\"></div>",
    "<input id=\"city-shut\" class=\"city-shut\" type=\"checkbox\">",
    "<label class=\"rail\" for=\"city-shut\" aria-controls=\"fcg-hud-nav\" aria-label=\"Retract city nav\">",
    "<span class=\"rail-open\">STOW</span>",
    "<span class=\"rail-shut\">OPEN</span>",
    "</label>",
    "<aside id=\"fcg-hud-nav\" class=\"panel\">",
    "<div class=\"head\">",
    "<p class=\"brand\">Forever Couch Gang</p>",
    "<div class=\"live\"><span class=\"dot\" aria-hidden=\"true\"></span>Node // live</div>",
    "</div>",
    "<nav class=\"scroll\" aria-label=\"City systems\">",
    "<div class=\"group\">",
    "<p class=\"group-label\">Identity</p>",
    "<a class=\"link\" href=\"/login\"><span>Profile</span></a>",
    "<a class=\"link is-live\" href=\"/\"><span class=\"reticle\" aria-hidden=\"true\"></span><span>Home</span></a>",
    "<a class=\"link\" href=\"/create-profile\"><span>Space</span></a>",
    "<a class=\"link\" href=\"/link_social\"><span>Socials</span></a>",
    "<a class=\"link\" href=\"/partner-apply\"><span>Partner</span></a>",
    "<a class=\"link\" href=\"/settings\"><span>Settings</span></a>",
    "</div>",
    "<div class=\"group\">",
    "<p class=\"group-label\">Watch</p>",
    "<a class=\"link\" href=\"/mscb\"><span>MSCB</span></a>",
    "<a class=\"link\" href=\"/ecosystem\"><span>Watch feed</span></a>",
    "<a class=\"link\" href=\"/rewards\"><span>Rewards</span></a>",
    "<a class=\"link\" href=\"/couch-cred\"><span>Couch Cred</span></a>",
    "<a class=\"link\" href=\"/governance\"><span>Governance</span></a>",
    "<a class=\"link\" href=\"/block-coding\"><span>Build</span></a>",
    "<a class=\"link\" href=\"/billing\"><span>Tiers</span></a>",
    "</div>",
    "<div class=\"group\">",
    "<p class=\"group-label\">Shop</p>",
    "<a class=\"link\" href=\"https://shop.forevercouchgang.space\"><span>Merch</span><span class=\"ext\">EXT</span></a>",
    "</div>",
    "<div class=\"group\">",
    "<p class=\"group-label\">Legal</p>",
    "<a class=\"link\" href=\"/terms\"><span>Terms</span></a>",
    "<a class=\"link\" href=\"/privacy\"><span>Privacy</span></a>",
    "<button type=\"button\" class=\"link\"><span>Report a bug</span></button>",
    "</div>",
    "</nav>",
    "<div class=\"tier\" aria-label=\"Tier status\">",
    "<div class=\"tier-row\"><span class=\"tier-key\">Tier</span><span class=\"tier-name\">NEWCOMER</span></div>",
    "<div class=\"tier-stats\">0 cred · 1.0x · max</div>",
    "<div class=\"meter\" aria-hidden=\"true\"><span style=\"width:8%\"></span></div>",
    "</div>",
    "</aside>",
    "<main>",
    "<section class=\"hero\">",
    "<div class=\"glass\">",
    "<div class=\"node-pill\">Node // live</div>",
    "<h1 class=\"heading-glow hero-title\">Forever Couch Gang</h1>",
    "<h2 class=\"heading-glow hero-sub\">Your space is yours to build</h2>",
    "<p class=\"hero-copy\">Jack into a luxurious holographic theater — cozy neon pirate vibes, volumetric light sweeps, and live holograms.</p>",
    "<div class=\"hero-actions\">",
    "<a class=\"cta-button cta-start\" href=\"/register\">Get Started</a>",
    "<a class=\"cta-button\" href=\"/block-coding\">Enter the Couchverse</a>",
    "</div>",
    "</div>",
    "<svg class=\"hero-beam\" aria-hidden=\"true\">",
    "<defs>",
    "<linearGradient id=\"beam\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"0\">",
    "<stop offset=\"0%\" stop-color=\"rgba(0,240,255,0.0)\"></stop>",
    "<stop offset=\"50%\" stop-color=\"rgba(0,240,255,0.35)\"></stop>",
    "<stop offset=\"100%\" stop-color=\"rgba(255,0,170,0.0)\"></stop>",
    "</linearGradient>",
    "</defs>",
    "<rect x=\"0\" y=\"0\" width=\"100%\" height=\"4\" fill=\"url(#beam)\">",
    "<animate attributeName=\"y\" from=\"20\" to=\"98%\" dur=\"12s\" repeatCount=\"indefinite\"></animate>",
    "</rect>",
    "</svg>",
    "</section>",
    "</main>",
    "</body>",
    "</html>",
    ""
  ]
end

define surface
  return lines with [
    "@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&family=Space+Grotesk:wght@400;500;600;700&display=swap');",
    "",
    ":root {",
    "  --fcg-base: #030507;",
    "  --fcg-surface: #0d131a;",
    "  --fcg-raised: #121922;",
    "  --fcg-border: #1c2836;",
    "  --fcg-text: #e0e6ed;",
    "  --fcg-muted: #7a8d9f;",
    "  --fcg-teal: #00f0ff;",
    "  --fcg-teal-dim: rgba(0, 240, 255, 0.1);",
    "  --fcg-teal-glow: rgba(0, 240, 255, 0.25);",
    "  --fcg-pink: #ff0055;",
    "  --fcg-pink-dim: rgba(255, 0, 85, 0.1);",
    "  --fcg-pink-glow: rgba(255, 0, 85, 0.25);",
    "  --fcg-lime: #b6ff5c;",
    "  --fcg-gold: #fce205;",
    "  --nightcity-radius: 0px;",
    "  --nightcity-base: var(--fcg-base, #030507);",
    "  --nightcity-surface: rgba(4, 10, 18, 0.82);",
    "  --nightcity-border: rgba(0, 240, 255, 0.32);",
    "  --nightcity-teal: var(--fcg-teal, #00f0ff);",
    "  --nightcity-pink: var(--fcg-pink, #ff0055);",
    "  --nightcity-lime: var(--fcg-lime, #b6ff5c);",
    "  --nightcity-text: var(--fcg-text, #e0e6ed);",
    "  --bg: var(--fcg-base, #030507);",
    "  --text: var(--fcg-text, #e0e6ed);",
    "  --accent: var(--fcg-teal, #00f0ff);",
    "  --accent2: var(--fcg-pink, #ff0055);",
    "  --accent3: var(--fcg-pink, #ff0055);",
    "  --glass: rgba(13, 19, 26, 0.9);",
    "  --glass-border: rgba(0, 240, 255, 0.32);",
    "  --heading-glow: 0 0 22px rgba(0, 240, 255, 0.35), 2px 0 0 rgba(255, 0, 85, 0.22);",
    "  --blur: 14px;",
    "  --radius: 0;",
    "}",
    "",
    "* { box-sizing: border-box; font-family: inherit; }",
    "html, body { min-height: 100%; width: 100%; overflow-x: hidden; -webkit-text-size-adjust: 100%; }",
    "body {",
    "  margin: 0;",
    "  font-family: 'Space Grotesk', system-ui, -apple-system, Segoe UI, sans-serif;",
    "  letter-spacing: 0.01em;",
    "  color: #e0e6ed;",
    "  background-color: var(--fcg-base);",
    "  background-image:",
    "    linear-gradient(rgba(0, 240, 255, 0.025) 1px, transparent 1px),",
    "    linear-gradient(90deg, rgba(0, 240, 255, 0.025) 1px, transparent 1px),",
    "    radial-gradient(ellipse 70% 38% at 8% 0%, rgba(0, 240, 255, 0.06), transparent 60%),",
    "    radial-gradient(ellipse 60% 35% at 100% 100%, rgba(255, 0, 85, 0.045), transparent 60%);",
    "  background-size: 40px 40px, 40px 40px, 100% 100%, 100% 100%;",
    "  background-attachment: fixed;",
    "}",
    "button, input, textarea, section { border-radius: var(--nightcity-radius); }",
    "img, video, canvas, svg:not(.hero-beam) { max-width: 100%; height: auto; }",
    "* { scrollbar-width: thin; scrollbar-color: #00f0ff #030507; }",
    "::-webkit-scrollbar { width: 7px; height: 7px; }",
    "::-webkit-scrollbar-track { background: #030507; }",
    "::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #00f0ff, #ff0055); border: 1px solid #1c2836; }",
    "",
    ".nebula-bg {",
    "  position: fixed;",
    "  inset: 0;",
    "  pointer-events: none;",
    "  background:",
    "    radial-gradient(circle at 12% 86%, rgba(0,240,255,0.06) 0%, transparent 48%),",
    "    radial-gradient(circle at 84% 16%, rgba(255,0,85,0.045) 0%, transparent 46%);",
    "  z-index: 0;",
    "}",
    "",
    ".city-shut {",
    "  position: absolute;",
    "  width: 1px;",
    "  height: 1px;",
    "  padding: 0;",
    "  margin: -1px;",
    "  overflow: hidden;",
    "  clip: rect(0, 0, 0, 0);",
    "  border: 0;",
    "}",
    "",
    ".rail {",
    "  position: fixed;",
    "  z-index: 101;",
    "  left: 276px;",
    "  top: 16px;",
    "  display: grid;",
    "  place-items: center;",
    "  width: 36px;",
    "  height: 64px;",
    "  padding: 0;",
    "  writing-mode: vertical-rl;",
    "  text-orientation: mixed;",
    "  border: 1px solid var(--fcg-teal-glow);",
    "  background: rgba(3, 5, 7, 0.92);",
    "  color: var(--fcg-teal);",
    "  cursor: pointer;",
    "  font-family: 'Share Tech Mono', ui-monospace, monospace;",
    "  font-size: 0.62rem;",
    "  letter-spacing: 0.16em;",
    "  text-transform: uppercase;",
    "  transition: left 320ms cubic-bezier(0.22, 1, 0.36, 1);",
    "}",
    ".rail:hover, .rail:focus-visible { border-color: var(--fcg-teal); box-shadow: 0 0 16px var(--fcg-teal-glow); }",
    ".rail-shut { display: none; }",
    ".city-shut:checked ~ .rail { left: 10px; }",
    ".city-shut:checked ~ .rail .rail-open { display: none; }",
    ".city-shut:checked ~ .rail .rail-shut { display: inline; }",
    "",
    ".panel {",
    "  --hud-w: 252px;",
    "  position: fixed;",
    "  z-index: 100;",
    "  left: 16px;",
    "  top: 16px;",
    "  width: var(--hud-w);",
    "  max-height: calc(100vh - 32px);",
    "  display: flex;",
    "  flex-direction: column;",
    "  padding: 0;",
    "  background: linear-gradient(180deg, rgba(18, 25, 34, 0.94), rgba(3, 5, 7, 0.96));",
    "  border: 1px solid rgba(0, 240, 255, 0.28);",
    "  box-shadow: 0 0 0 1px rgba(255, 0, 85, 0.08) inset, 0 18px 40px rgba(0, 0, 0, 0.45);",
    "  opacity: 1;",
    "  pointer-events: auto;",
    "  transform: none;",
    "  transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease;",
    "}",
    ".city-shut:checked ~ .panel {",
    "  opacity: 0;",
    "  pointer-events: none;",
    "  transform: translateX(calc(-100% - 28px));",
    "}",
    ".head { padding: 14px 14px 12px; border-bottom: 1px solid rgba(0, 240, 255, 0.16); }",
    ".brand {",
    "  margin: 0;",
    "  font-family: 'Orbitron', system-ui, sans-serif;",
    "  font-size: 0.72rem;",
    "  font-weight: 800;",
    "  letter-spacing: 0.16em;",
    "  text-transform: uppercase;",
    "  color: var(--fcg-teal);",
    "  text-shadow: 0 0 14px var(--fcg-teal-glow);",
    "}",
    ".live {",
    "  display: flex;",
    "  align-items: center;",
    "  gap: 0.45rem;",
    "  margin-top: 0.45rem;",
    "  font-family: 'Share Tech Mono', ui-monospace, monospace;",
    "  font-size: 0.62rem;",
    "  letter-spacing: 0.16em;",
    "  text-transform: uppercase;",
    "  color: var(--fcg-muted);",
    "}",
    ".dot {",
    "  width: 0.42rem;",
    "  height: 0.42rem;",
    "  border-radius: 50%;",
    "  background: var(--fcg-lime);",
    "  box-shadow: 0 0 8px var(--fcg-lime);",
    "}",
    ".scroll {",
    "  flex: 1 1 auto;",
    "  overflow-y: auto;",
    "  padding: 10px 10px 8px;",
    "  scrollbar-width: thin;",
    "  scrollbar-color: var(--fcg-teal) var(--fcg-base);",
    "}",
    ".scroll::-webkit-scrollbar { width: 6px; }",
    ".scroll::-webkit-scrollbar-track { background: var(--fcg-base); }",
    ".scroll::-webkit-scrollbar-thumb { background: linear-gradient(180deg, var(--fcg-teal), var(--fcg-pink)); border: 1px solid var(--fcg-border); }",
    ".group { margin: 0 0 12px; }",
    ".group-label {",
    "  margin: 0 6px 6px;",
    "  font-family: 'Share Tech Mono', ui-monospace, monospace;",
    "  font-size: 0.58rem;",
    "  letter-spacing: 0.2em;",
    "  text-transform: uppercase;",
    "  color: var(--fcg-pink);",
    "}",
    ".link {",
    "  position: relative;",
    "  display: flex;",
    "  align-items: center;",
    "  gap: 8px;",
    "  width: 100%;",
    "  padding: 7px 10px 7px 14px;",
    "  margin: 0 0 2px;",
    "  color: var(--fcg-text);",
    "  text-decoration: none;",
    "  text-align: left;",
    "  font-family: 'Space Grotesk', system-ui, sans-serif;",
    "  font-size: 0.78rem;",
    "  font-weight: 600;",
    "  letter-spacing: 0.04em;",
    "  border: 1px solid transparent;",
    "  background: transparent;",
    "  cursor: pointer;",
    "  transition: color 0.16s ease, background 0.16s ease;",
    "}",
    ".link::before {",
    "  content: '';",
    "  position: absolute;",
    "  left: 4px;",
    "  top: 8px;",
    "  bottom: 8px;",
    "  width: 2px;",
    "  background: rgba(0, 240, 255, 0.18);",
    "}",
    ".link:hover, .link:focus-visible { color: var(--fcg-teal); background: rgba(0, 240, 255, 0.05); }",
    ".link.is-live { color: var(--fcg-teal); background: rgba(0, 240, 255, 0.07); }",
    ".link.is-live::before { background: var(--fcg-teal); box-shadow: 0 0 8px var(--fcg-teal); }",
    ".reticle {",
    "  position: absolute;",
    "  inset: 3px 4px;",
    "  pointer-events: none;",
    "  border: 1px solid rgba(0, 240, 255, 0.55);",
    "  clip-path: polygon(0 0, 10px 0, 10px 1px, 1px 1px, 1px 10px, 0 10px, 0 calc(100% - 10px), 1px calc(100% - 10px), 1px calc(100% - 1px), 10px calc(100% - 1px), 10px 100%, 0 100%, 100% 100%, 100% calc(100% - 10px), calc(100% - 1px) calc(100% - 10px), calc(100% - 1px) calc(100% - 1px), calc(100% - 10px) calc(100% - 1px), calc(100% - 10px) 100%, calc(100% - 10px) 0, calc(100% - 10px) 1px, calc(100% - 1px) 1px, calc(100% - 1px) 10px, 100% 10px, 100% 0);",
    "}",
    ".ext {",
    "  margin-left: auto;",
    "  font-family: 'Share Tech Mono', ui-monospace, monospace;",
    "  font-size: 0.58rem;",
    "  letter-spacing: 0.12em;",
    "  color: var(--fcg-muted);",
    "}",
    ".tier {",
    "  padding: 10px 12px 12px;",
    "  border-top: 1px solid rgba(0, 240, 255, 0.16);",
    "  background: rgba(0, 240, 255, 0.04);",
    "}",
    ".tier-row { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }",
    ".tier-key {",
    "  font-family: 'Share Tech Mono', ui-monospace, monospace;",
    "  font-size: 0.58rem;",
    "  letter-spacing: 0.18em;",
    "  text-transform: uppercase;",
    "  color: var(--fcg-muted);",
    "}",
    ".tier-name {",
    "  font-family: 'Orbitron', system-ui, sans-serif;",
    "  font-size: 0.72rem;",
    "  font-weight: 800;",
    "  letter-spacing: 0.08em;",
    "  text-transform: uppercase;",
    "  color: var(--fcg-teal);",
    "}",
    ".tier-stats {",
    "  margin-top: 6px;",
    "  font-family: 'Share Tech Mono', ui-monospace, monospace;",
    "  font-size: 0.64rem;",
    "  letter-spacing: 0.08em;",
    "  text-transform: uppercase;",
    "  color: var(--fcg-text);",
    "}",
    ".meter { margin-top: 8px; height: 3px; background: var(--fcg-border); overflow: hidden; }",
    ".meter > span { display: block; height: 100%; background: linear-gradient(90deg, var(--fcg-teal), var(--fcg-pink)); }",
    "",
    "main { position: relative; z-index: 1; min-height: 100vh; }",
    ".hero {",
    "  min-height: 100vh;",
    "  display: grid;",
    "  place-items: center;",
    "  position: relative;",
    "  padding: 4rem 1rem 2rem;",
    "}",
    ".glass {",
    "  position: relative;",
    "  overflow: hidden;",
    "  text-align: center;",
    "  padding: 2.2rem;",
    "  z-index: 1;",
    "  max-width: 980px;",
    "  width: 100%;",
    "  background: var(--glass);",
    "  border: 1px solid rgba(0, 255, 255, 0.32);",
    "  backdrop-filter: blur(var(--blur));",
    "  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);",
    "  box-shadow: 0 0 28px rgba(0, 240, 255, 0.12);",
    "}",
    ".glass::before {",
    "  content: '';",
    "  position: absolute;",
    "  inset: 0;",
    "  pointer-events: none;",
    "  background-image: repeating-linear-gradient(to bottom, rgba(130, 255, 255, 0.07) 0, rgba(130, 255, 255, 0.07) 1px, rgba(130, 255, 255, 0) 1px, rgba(130, 255, 255, 0) 4px);",
    "  opacity: 0.12;",
    "}",
    ".glass::after {",
    "  content: '';",
    "  position: absolute;",
    "  top: -120%;",
    "  left: -20%;",
    "  width: 140%;",
    "  height: 220%;",
    "  pointer-events: none;",
    "  background: linear-gradient(110deg, rgba(0,240,255,0) 35%, rgba(0,240,255,0.06) 50%, rgba(255,0,85,0.045) 58%, rgba(255,0,85,0) 72%);",
    "  transform: rotate(8deg);",
    "  animation: none;",
    "}",
    ".node-pill {",
    "  display: inline-flex;",
    "  padding: 0.35rem 0.8rem;",
    "  clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);",
    "  border: 1px solid rgba(0, 240, 255, 0.45);",
    "  background: rgba(0, 240, 255, 0.12);",
    "  color: #9dffc4;",
    "  font-size: 0.72rem;",
    "  text-transform: uppercase;",
    "  letter-spacing: 0.08em;",
    "  font-family: 'Orbitron', system-ui, sans-serif;",
    "  font-weight: 700;",
    "  margin-bottom: 1rem;",
    "}",
    ".heading-glow {",
    "  font-family: 'Orbitron', system-ui, sans-serif;",
    "  letter-spacing: 0.08em;",
    "  text-shadow: var(--heading-glow);",
    "}",
    ".hero-title {",
    "  font-size: clamp(3rem, 10vw, 8rem);",
    "  margin: 0;",
    "  background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent));",
    "  background-size: 200% 100%;",
    "  -webkit-background-clip: text;",
    "  background-clip: text;",
    "  color: transparent;",
    "  animation: shine 4s infinite linear;",
    "}",
    ".hero-sub {",
    "  color: var(--accent2);",
    "  margin: 0.5rem 0 1.5rem;",
    "  font-size: clamp(1rem, 2vw, 1.4rem);",
    "  letter-spacing: 0.12em;",
    "  text-transform: uppercase;",
    "}",
    ".hero-copy { max-width: 900px; margin: 0 auto 2rem; opacity: 0.9; }",
    ".hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }",
    ".cta-button {",
    "  position: relative;",
    "  overflow: hidden;",
    "  display: inline-block;",
    "  padding: 12px 20px;",
    "  text-decoration: none;",
    "  border: 1px solid rgba(0, 240, 255, 0.4);",
    "  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);",
    "  background: rgba(255, 0, 85, 0.12);",
    "  box-shadow: 0 0 22px rgba(0, 240, 255, 0.2);",
    "  color: var(--accent);",
    "  cursor: pointer;",
    "  font-family: 'Orbitron', system-ui, sans-serif;",
    "  letter-spacing: 0.04em;",
    "  font-weight: 700;",
    "}",
    ".cta-start { font-size: 1rem; padding: 0.72rem 1.35rem; }",
    ".cta-button::after {",
    "  content: '';",
    "  position: absolute;",
    "  inset: -6px;",
    "  border-radius: 16px;",
    "  border: 1px solid rgba(255,0,85,0.35);",
    "  filter: blur(6px);",
    "  opacity: 0;",
    "  transition: opacity 200ms ease;",
    "}",
    ".cta-button:hover::after { opacity: 1; }",
    ".cta-button::before {",
    "  content: '';",
    "  position: absolute;",
    "  inset: 0;",
    "  pointer-events: none;",
    "  background: linear-gradient(120deg, rgba(255,255,255,0) 28%, rgba(255,255,255,0.28) 45%, rgba(255,255,255,0) 62%);",
    "  transform: translateX(-130%);",
    "  animation: holoButtonSweep 3.8s ease-in-out infinite;",
    "}",
    ".hero-beam { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }",
    "",
    "@keyframes shine { 0% { background-position: 0% } 100% { background-position: 200% } }",
    "@keyframes holoButtonSweep {",
    "  0%, 42% { transform: translateX(-130%); opacity: 0; }",
    "  50% { opacity: 0.9; }",
    "  62% { transform: translateX(130%); opacity: 0.9; }",
    "  70%, 100% { transform: translateX(130%); opacity: 0; }",
    "}",
    "",
    "@media (max-width: 900px) {",
    "  .panel {",
    "    --hud-w: 228px;",
    "    left: 12px;",
    "    top: 12px;",
    "    max-height: calc(100vh - 24px);",
    "    opacity: 0;",
    "    pointer-events: none;",
    "    transform: translateX(calc(-100% - 28px));",
    "  }",
    "  .rail { left: 10px; top: 12px; }",
    "  .rail-open { display: none; }",
    "  .rail-shut { display: inline; }",
    "  .city-shut:checked ~ .panel { opacity: 1; pointer-events: auto; transform: none; }",
    "  .city-shut:checked ~ .rail { left: 248px; }",
    "  .city-shut:checked ~ .rail .rail-open { display: inline; }",
    "  .city-shut:checked ~ .rail .rail-shut { display: none; }",
    "}",
    "@media (prefers-reduced-motion: reduce) {",
    "  .rail, .panel, .link, .cta-button, .cta-button::before, .hero-title { animation: none; transition: none; }",
    "}",
    "html[data-motion='reduce'] *, html[data-motion='reduce'] *::before, html[data-motion='reduce'] *::after {",
    "  animation: none !important;",
    "  transition: none !important;",
    "  scroll-behavior: auto !important;",
    "}",
    ""
  ]
end

define main
  let page be markup
  let css be surface
  try
    write with "sites/cpa/index.html", page
    write with "sites/cpa/app.css", css
    say "wrote sites/cpa/index.html"
    say "wrote sites/cpa/app.css"
  miss problem
    say problem
    write with "site/index.html", page
    write with "site/app.css", css
    say "wrote site/index.html"
    say "wrote site/app.css"
  end
end
