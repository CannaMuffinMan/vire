~ Forever Couch Gang public home. Static port of landing-page HomeCyber.
~ listen serves site/ inside the program folder (GET/HEAD, allowlisted types only).
define main
  let page be 
"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#030507\">\n<title>Forever Couch Gang — Build Your Space</title>\n<meta name=\"description\" content=\"Build a custom creator profile, connect your communities, and bring stream chat together with Forever Couch Gang.\">\n<link rel=\"stylesheet\" href=\"site.css\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&amp;family=Share+Tech+Mono&amp;family=Space+Grotesk:wght@400;500;600;700&amp;display=swap\">\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"grid\" aria-hidden=\"true\"></div>\n  <div class=\"scanlines\" aria-hidden=\"true\"></div>\n\n  <header class=\"navWrap\">\n    <nav class=\"nav\" aria-label=\"Primary\">\n      <a href=\"#top\" class=\"brand\">Forever Couch Gang</a>\n      <div class=\"navLinks\">\n        <a href=\"#raid\">Sept Raid</a>\n        <a href=\"#Mascot\">Mascot</a>\n        <a href=\"#watch\">Watch / Couch Cred</a>\n        <a href=\"#space\">Your Space</a>\n        <a href=\"#one-stack\">One Stack</a>\n        <a href=\"#couchy\">Couchy</a>\n        <a href=\"#mscb\">MSCB</a>\n        <a href=\"#chain\">Chain</a>\n        <a href=\"#defense\">Defense</a>\n        <a href=\"#partners\">Partners</a>\n        <a href=\"/whitepaper\">Whitepaper</a>\n      </div>\n    </nav>\n  </header>\n\n  <div class=\"stage\">\n    <section class=\"hero\" id=\"top\">\n      <div>\n        <p class=\"kicker\">Live network · not shutting down · build your night city</p>\n        <h1 class=\"title\">Your space is yours to build.</h1>\n        <p class=\"lead\">Forever Couch Gang is a cyberpunk social layer on our own chain. No cookie-cutter profiles. You assemble the room, the identity, and the signal. Watch across platforms, build Couch Cred reputation, talk through one Multi-Stream Chat Bridge, and unlock Couchy as you climb tiers. Viewer-economy issuance is on hold.</p>\n        <div class=\"ctaCol\">\n          <a class=\"join\" href=\"https://forevercouchgang.space/?joinFx=1\">JOIN THE CITY</a>\n          <div class=\"resume\">\n            <label>Already have the BIP39 12 words from an unfinished Join? Enter them here. Do not click Join again.</label>\n            <input type=\"password\" autocomplete=\"off\" placeholder=\"12 BIP39 words, separated by spaces\">\n            <button type=\"button\">Save this wallet as my account</button>\n          </div>\n          <aside id=\"chat-sub-giveaway\" class=\"giveaway\">\n            <p class=\"gk\">chat sub goal - two Pro Unlimited tiers</p>\n            <p>Help the chat sub goal on <a href=\"#\">chat.com/cannamuffinman</a>. Direct chat subs count toward the goal; gifted chat subs do not.</p>\n            <ol>\n              <li><strong>Goal hits by October 31, 2026 (ET):</strong> all FCG.space users with chat linked get <strong>3 months of Pro Unlimited</strong> from the grant date (city-wide linked pool - not a personal &quot;you subbed, you get 3mo&quot; reward).</li>\n              <li><strong>Goal misses by October 31, 2026 (ET):</strong> only <strong>direct chat subscribers</strong> who also have chat linked on FCG get <strong>1 month of Pro Unlimited</strong> to claim. Gifted chat subs are out. Linked-only users who never direct-subbed do not get the miss-path month.</li>\n            </ol>\n            <p class=\"fine\">Footnote: Pro Unlimited is an FCG.space perk - not chat cash, not an investment, not mining / watch-to-earn (mining stays on hold). Grant is not automatic in-app yet; claim path on stream / raid board when eligible. Promo ends October 31, 2026 (ET).</p>\n            <a class=\"go\" href=\"#\">Subscribe on chat (helps the goal)</a>\n          </aside>\n          <a class=\"ghostLink\" href=\"https://app.forevercouchgang.space/login?recover=1\">Already have your .fcgbc / passkey? Unlock — same wallet (cache wipe ≠ new account)</a>\n          <a class=\"ghostLink\" href=\"#watch\">See viewer-economy status</a>\n        </div>\n      </div>\n\n      <aside class=\"Mascot\" id=\"Mascot\" aria-label=\"Mascot, Gang partner and mascot\">\n        <p class=\"tag\">Mascot online</p>\n        <h2 class=\"name\">Mascot</h2>\n        <p class=\"role\">Gang partner · official V-Tuber mascot</p>\n        <p class=\"note\">Her Live2D signal is now wired into every landing-page route.</p>\n        <p class=\"hint\"><span>From the city</span>Move your pointer — she follows the signal locally, without tracking you.</p>\n        <div class=\"stageBox\">\n          <div class=\"veil\">\n            <p class=\"vk\">Live2D signal locked</p>\n            <h3 class=\"vt\">She’s here.</h3>\n            <p class=\"vb\">Mascot now flaps, smiles, follows focus, and travels through the night city.</p>\n            <button class=\"replay\" type=\"button\">Replay epic reveal</button>\n          </div>\n        </div>\n        <nav class=\"socials\" aria-label=\"Mascot socials\">\n          <a class=\"primary\" href=\"#\">Watch on Twitch</a>\n          <a class=\"link\" href=\"#\">chat</a>\n          <a class=\"link\" href=\"#\">X</a>\n          <a class=\"link\" href=\"#\">YouTube</a>\n        </nav>\n      </aside>\n    </section>\n\n    <div class=\"board\">\n      <section class=\"raid span12\" id=\"raid\">\n        <p class=\"rk\">chat sub goal - ends October 31, 2026 (ET)</p>\n        <h2>Two tiers: hit 3 months / miss 1 month (direct only)</h2>\n        <p class=\"rlead\">Help the goal by <strong>directly subscribing</strong> to <a href=\"#\">chat.com/cannamuffinman</a>. Gifted chat subs do not count toward the goal and are out of the miss-path month.</p>\n        <ol>\n          <li><strong>Goal hits by October 31, 2026 (ET):</strong> all forevercouchgang.space / FCG.space users with chat linked get <strong>3 months of Pro Unlimited</strong> from the grant date (city-wide linked pool - not a personal &quot;you subbed, you get 3mo&quot; reward).</li>\n          <li><strong>Goal misses by October 31, 2026 (ET):</strong> only <strong>direct chat subscribers</strong> who also have chat linked on FCG get <strong>1 month of Pro Unlimited</strong> to claim. Gifted out. Linked-only users who never direct-subbed do not get the miss-path month. Do not read this as everyone getting 3 months on a miss.</li>\n        </ol>\n        <div class=\"meterBlock\">\n          <div class=\"countRow\">\n            <span class=\"count\">-</span>\n            <span class=\"goal\">/ 1,000 direct subs</span>\n          </div>\n          <div class=\"bar\" aria-hidden=\"true\"><div class=\"fill\"></div></div>\n          <p class=\"status\">Loading the raid counter...</p>\n        </div>\n        <ol class=\"steps\">\n          <li>Sub direct on chat to help the goal - gifted subs do not count.</li>\n          <li>Link chat on your FCG.space account (required for both tiers).</li>\n          <li>Claim path on stream / Discord - grant is not automatic in-app yet.</li>\n        </ol>\n        <p class=\"fine\">Footnote: Pro Unlimited is an FCG.space perk - not chat cash, not an investment, and not mining / watch-to-earn (mining stays on hold). Ends October 31, 2026 (ET).</p>\n        <div class=\"actions\">\n          <a class=\"primary\" href=\"#\">Sub on chat (helps the goal)</a>\n          <a class=\"secondary\" href=\"https://www.forevercouchgang.space\">Join FCG</a>\n        </div>\n      </section>\n\n      <section class=\"section span6\" id=\"watch\">\n        <p class=\"tag\">Viewer economy — currently on hold</p>\n        <h2>Viewer-economy issuance is on hold</h2>\n        <p>Proof-of-Rot is designed to recognize real watch time — not bots, not fake clicks. Issuance is currently disabled until we can stand behind live activity tracking. Couch Cred still tracks real presence.</p>\n        <div class=\"cards\">\n          <article class=\"card\">\n            <h3>Issuance on hold</h3>\n            <p>Verified viewing is designed as Proof-of-Rot. Live issuance is currently disabled.</p>\n          </article>\n          <article class=\"card\">\n            <h3>Anti-farm by design</h3>\n            <p>FCGBDS sits in front of the faucet so bot farms do not drain the viewer economy.</p>\n          </article>\n          <article class=\"card\">\n            <h3>Design utility</h3>\n            <p>When live, activity is meant for in-app features and platform perks. No live issuance while this hold is in place.</p>\n          </article>\n        </div>\n        <div class=\"links\">\n          <a href=\"/utility-overview\">Utility &amp; Proof-of-Rot</a>\n          <a href=\"/whitepaper\">Whitepaper</a>\n        </div>\n      </section>\n\n      <section class=\"section span6\" id=\"space\">\n        <p class=\"tag\">Identity</p>\n        <h2>Build your own profile — not a template</h2>\n        <p>Your space is yours to build. Layout, widgets, vibe, and how people enter your room are yours. No factory skins with a different username slapped on. If it looks like everyone else, you have not finished building yet.</p>\n        <div class=\"cards\">\n          <article class=\"card\">\n            <h3>Construct, don't pick a skin</h3>\n            <p>Assemble modules, art, and links into a space that only you would ship.</p>\n          </article>\n          <article class=\"card\">\n            <h3>Tied to your .fcgbc</h3>\n            <p>The same encrypted identity file that logs you in owns the space you build.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"section span12\" id=\"one-stack\">\n        <p class=\"tag\">One stack · owned space</p>\n        <h2>Your space shouldn't die when someone else gets acquired.</h2>\n        <p class=\"subhead\">Bento built a louder home than a flat link list — then Linktree bought it and shut it down. Forever Couch Gang is the couch-culture home base you actually own: custom profile, links + vibes, creator tools, and multi-stream chat in one product.</p>\n        <p>Most creators duct-tape four apps: a link hub, a one-pager, a storefront, and a chat bridge. FCG is built as one stack for the Gang — Couch Potato profiles, Multi-Stream Chat Bridge, CouchCred, and more — without pretending to be YouTube, Twitch, or chat.</p>\n        <p>If you're rebuilding after Bento (or tired of renting four logins), start here. We're not them. We're the night city next door.</p>\n        <div class=\"links\">\n          <a href=\"https://forevercouchgang.space/?joinFx=1\">Join FCG</a>\n          <a href=\"https://app.forevercouchgang.space\">Open the app</a>\n          <a href=\"#mscb\">See how viewers hang / MSCB</a>\n        </div>\n        <p class=\"footnote\">Independent product. Not affiliated with Linktree or Bento. Shutdown / acquisition details are public reporting — verify before you migrate anything important.</p>\n      </section>\n\n      <section class=\"section span12\" id=\"couchy\">\n        <p class=\"tag\">Still being built · tiers already mapped</p>\n        <h2>Every tier comes with Couchy</h2>\n        <p>Couchy is the FCG operator: chat, stream tools, and later code and animation. Every profile tier includes access. Higher tiers mean more power and more usage — more context, more actions, more of the city under your hands. The product is still under construction. The contract is not: if you have a tier, you get Couchy.</p>\n        <div class=\"cards\">\n          <article class=\"card\">\n            <h3>Entry</h3>\n            <p>Public / starter Couchy with tight usage so anyone can talk to the city.</p>\n          </article>\n          <article class=\"card\">\n            <h3>Mid tiers</h3>\n            <p>More tokens, longer memory, stream-side commands as they come online.</p>\n          </article>\n          <article class=\"card\">\n            <h3>High tiers</h3>\n            <p>Max power and usage — operator-grade Couchy as horizons finish shipping.</p>\n          </article>\n        </div>\n      </section>\n\n      <section class=\"section span12\" id=\"mscb\">\n        <p class=\"tag\">One chat. Every platform.</p>\n        <h2>Multi-Stream Chat Bridge</h2>\n        <p>MSCB pulls Twitch, YouTube, chat, and more into one conversation so the gang is not split by logo. Link your accounts to your Forever Couch Gang identity and talk as one person across the night city.</p>\n        <div class=\"links\">\n          <a href=\"/mscb\">Open full MSCB</a>\n        </div>\n      </section>\n\n      <section class=\"section span4\" id=\"chain\">\n        <p class=\"tag\">FCGBC</p>\n        <h2>Our chain. Our rules. Your keys.</h2>\n        <p>$FCGC lives on the Forever Couch Gang blockchain. Wallets, encrypted .fcgbc recovery, and on-chain utility are built here — not rented from a casino chain and rebranded.</p>\n        <div class=\"links\">\n          <a href=\"/utility-overview\">Tokenomics</a>\n          <a href=\"/whitepaper\">Security &amp; chain</a>\n        </div>\n      </section>\n\n      <section class=\"section span4\" id=\"defense\">\n        <p class=\"tag\">FCGBDS</p>\n        <h2>Bot Defense System</h2>\n        <p>When a viewer faucet is live, bots will try to steal the couch. FCGBDS scores traffic and can enforce blocks after an observe window — it is not a silent fail-closed wall on every path. Mining is currently on hold.</p>\n        <div class=\"links\">\n          <a href=\"/bot-defense-system\">Bot Defense System</a>\n          <a href=\"https://github.com/cannamuffinman/fcgbds\">View on GitHub</a>\n        </div>\n      </section>\n\n      <section class=\"section span12\" id=\"studio\">\n        <p class=\"tag\">Shop · spots · plans</p>\n        <h2>Studio extras</h2>\n        <p>Official merch and sponsored spots appear here when those catalogs are connected. Plans are live in the app.</p>\n      </section>\n\n      <section class=\"section span4\" id=\"partners\">\n        <p class=\"tag\">Platforms &amp; brands</p>\n        <h2>Partnerships, not rent</h2>\n        <p>Creators, platforms, and brands plug into the same viewer economy and identity layer. We build bridges. We do not become someone else's widget farm.</p>\n        <div class=\"links\">\n          <a href=\"/partners\">Partners</a>\n          <a href=\"/partnerships\">Partnerships</a>\n          <a href=\"/creator-partnership-program\">Creator program</a>\n          <a href=\"/b2b\">B2B</a>\n          <a href=\"/privacy\">Privacy</a>\n          <a href=\"/terms\">Terms</a>\n          <button type=\"button\">Report a bug</button>\n        </div>\n      </section>\n    </div>\n  </div>\n</div>\n</body>\n</html>\n"
  let css be 
":root {\n  --fcg-clip: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);\n  --fcg-clip-chip: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);\n  --fcg-base: #030507;\n  --fcg-surface: #0d131a;\n  --fcg-raised: #121922;\n  --fcg-border: #1c2836;\n  --fcg-text: #e0e6ed;\n  --fcg-muted: #7a8d9f;\n  --fcg-teal: #00f0ff;\n  --fcg-teal-dim: rgba(0, 240, 255, 0.1);\n  --fcg-teal-glow: rgba(0, 240, 255, 0.25);\n  --fcg-pink: #ff0055;\n  --fcg-pink-dim: rgba(255, 0, 85, 0.1);\n  --fcg-pink-glow: rgba(255, 0, 85, 0.25);\n  --fcg-lime: #b6ff5c;\n  --fcg-gold: #fce205;\n  --fcg-gold-dim: rgba(252, 226, 5, 0.1);\n  --fcg-danger: #ff2a2a;\n  --font-orbitron: \"Orbitron\", sans-serif;\n  --font-space-grotesk: \"Space Grotesk\", \"Segoe UI\", Arial, Helvetica, sans-serif;\n  --font-share-tech-mono: \"Share Tech Mono\", ui-monospace, \"Courier New\", monospace;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n  min-width: 0;\n}\n\nhtml {\n  width: 100%;\n  overflow-x: hidden;\n  text-size-adjust: 100%;\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  min-height: 100%;\n  width: 100%;\n  overflow-x: hidden;\n  background: var(--fcg-base);\n  color: var(--fcg-text);\n  font-family: var(--font-space-grotesk);\n  background-image:\n    linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px),\n    radial-gradient(ellipse 100% 100% at 50% -20%, rgba(0, 240, 255, 0.08) 0%, transparent 50%),\n    radial-gradient(ellipse 80% 50% at 100% 100%, rgba(255, 0, 85, 0.05) 0%, transparent 60%);\n  background-size: 40px 40px, 40px 40px, 100% 100%, 100% 100%;\n  background-attachment: fixed;\n  background-position: center top;\n}\n\na:not([class]) {\n  color: var(--fcg-teal);\n  text-decoration: none;\n}\n\n::-webkit-scrollbar { width: 6px; }\n::-webkit-scrollbar-track { background: var(--fcg-base); }\n::-webkit-scrollbar-thumb { background: var(--fcg-border); }\n::-webkit-scrollbar-thumb:hover { background: var(--fcg-teal); }\n\n.page {\n  position: relative;\n  min-height: 100svh;\n  width: 100%;\n  color: var(--fcg-text);\n  overflow-x: hidden;\n  background:\n    radial-gradient(50vw 40vh at 6% -8%, rgba(255, 0, 85, 0.08), transparent 55%),\n    radial-gradient(46vw 36vh at 100% 4%, rgba(0, 240, 255, 0.08), transparent 50%),\n    linear-gradient(180deg, var(--fcg-base) 0%, var(--fcg-surface) 40%, var(--fcg-base) 100%);\n}\n\n.scanlines {\n  pointer-events: none;\n  position: fixed;\n  inset: 0;\n  z-index: 1;\n  background: repeating-linear-gradient(\n    180deg,\n    rgba(255, 255, 255, 0.028) 0 1px,\n    transparent 1px 3px\n  );\n  mix-blend-mode: overlay;\n  opacity: 0.12;\n}\n\n.grid {\n  pointer-events: none;\n  position: fixed;\n  inset: 0;\n  z-index: 0;\n  background-image:\n    linear-gradient(rgba(0, 240, 255, 0.025) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0, 240, 255, 0.025) 1px, transparent 1px);\n  background-size: 40px 40px;\n}\n\n.navWrap {\n  position: sticky;\n  top: 0;\n  z-index: 40;\n  width: 100%;\n  border-bottom: 1px solid rgba(0, 240, 255, 0.28);\n  background: rgba(3, 5, 7, 0.9);\n  backdrop-filter: blur(14px);\n}\n\n.nav {\n  width: 100%;\n  padding: 0.85rem 2vw;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.7rem;\n}\n\n.brand {\n  font-family: var(--font-orbitron), sans-serif;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--fcg-teal);\n  text-shadow: 0 0 16px rgba(0, 240, 255, 0.45);\n  text-decoration: none;\n  font-size: clamp(0.78rem, 1.1vw, 1rem);\n}\n\n.navLinks {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n}\n\n.navLinks a {\n  color: var(--fcg-text);\n  text-decoration: none;\n  font-size: clamp(0.62rem, 0.85vw, 0.78rem);\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 0.5rem 0.85rem;\n  border: 1px solid rgba(255, 0, 85, 0.35);\n  clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);\n  background: rgba(255, 0, 85, 0.06);\n}\n\n.navLinks a:hover,\n.navLinks a:focus-visible {\n  border-color: var(--fcg-teal);\n  color: var(--fcg-teal);\n  box-shadow: 0 0 18px rgba(0, 240, 255, 0.25);\n}\n\n.stage {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  padding: 1.2vw 2vw 3vw;\n  display: grid;\n  gap: 1.2vw;\n}\n\n.hero {\n  min-height: calc(100svh - 4.4rem);\n  display: grid;\n  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.75fr);\n  gap: 3vw;\n  align-items: center;\n  padding: clamp(1.4rem, 3vw, 3.4rem);\n  border: 1px solid rgba(0, 240, 255, 0.32);\n  background:\n    linear-gradient(135deg, rgba(255, 0, 85, 0.08), transparent 42%),\n    linear-gradient(180deg, rgba(13, 19, 26, 0.94), rgba(3, 5, 7, 0.96));\n}\n\n.kicker {\n  margin: 0 0 0.8rem;\n  color: var(--fcg-pink);\n  font-size: clamp(0.72rem, 1vw, 0.9rem);\n  font-weight: 800;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  text-shadow: 0 0 12px rgba(255, 0, 85, 0.4);\n}\n\n.title {\n  margin: 0;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: clamp(2.1rem, 5.4vw, 5.4rem);\n  line-height: 0.96;\n  text-transform: uppercase;\n  color: #ffffff;\n  text-shadow:\n    2px 0 0 rgba(255, 0, 85, 0.25),\n    -2px 0 0 rgba(0, 240, 255, 0.2),\n    0 0 22px rgba(0, 240, 255, 0.25);\n}\n\n.lead {\n  margin: 1.1rem 0 0;\n  max-width: 62ch;\n  color: var(--fcg-text);\n  line-height: 1.65;\n  font-size: clamp(1rem, 1.25vw, 1.25rem);\n}\n\n.ctaCol {\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 1rem;\n  justify-content: center;\n  margin-top: 1.2rem;\n}\n\n.join {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: min(28rem, 100%);\n  min-height: 4.75rem;\n  padding: 1.15rem 2.4rem;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: clamp(1.1rem, 2vw, 1.7rem);\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: #00fff0;\n  text-decoration: none;\n  text-shadow: 0 0 16px rgba(0, 255, 240, 0.55);\n  background:\n    linear-gradient(rgba(0, 255, 240, 0.18) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(0, 255, 240, 0.12) 1px, transparent 1px),\n    rgba(255, 0, 85, 0.12);\n  background-size: 14px 14px, 14px 14px, auto;\n  border: 2px solid #00fff0;\n  box-shadow: 0 0 22px rgba(0, 255, 240, 0.25);\n}\n\n.join:focus-visible {\n  outline: 2px solid #ff0055;\n  outline-offset: 4px;\n}\n\n.ghostLink {\n  color: var(--fcg-teal);\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  text-decoration: none;\n  font-size: 0.82rem;\n  border-bottom: 1px solid rgba(0, 240, 255, 0.45);\n  width: fit-content;\n}\n\n.resume {\n  width: 100%;\n  max-width: 28rem;\n  display: grid;\n  gap: 0.5rem;\n}\n\n.resume label {\n  color: #d9f7ff;\n  font-size: 0.75rem;\n  text-align: center;\n}\n\n.resume input {\n  width: 100%;\n  background: rgba(0, 0, 0, 0.4);\n  border: 1px solid #00f0ff;\n  color: #ffffff;\n  padding: 0.5rem 0.75rem;\n  border-radius: 0.25rem;\n  font: inherit;\n}\n\n.resume button {\n  width: 100%;\n  padding: 0.5rem;\n  font-weight: 700;\n  border-radius: 0.25rem;\n  border: 0;\n  background: #00f0ff;\n  color: #000000;\n  cursor: pointer;\n}\n\n.giveaway {\n  margin-top: 12px;\n  padding: 12px 14px;\n  border-radius: 10px;\n  border: 1px solid rgba(83, 252, 24, 0.45);\n  background: rgba(8, 20, 12, 0.72);\n  color: #e8ffe8;\n  max-width: 540px;\n}\n\n.giveaway .gk {\n  margin: 0;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: #53fc18;\n}\n\n.giveaway p {\n  margin: 8px 0;\n  font-size: 14px;\n  line-height: 1.45;\n}\n\n.giveaway a {\n  color: #53fc18;\n  font-weight: 700;\n}\n\n.giveaway ol {\n  margin: 0 0 8px;\n  padding-left: 20px;\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.giveaway li { margin-bottom: 6px; }\n\n.giveaway .fine {\n  margin: 0 0 10px;\n  font-size: 11px;\n  line-height: 1.4;\n  opacity: 0.85;\n}\n\n.giveaway .go {\n  display: inline-block;\n  background: #53fc18;\n  color: #041008;\n  font-weight: 800;\n  text-decoration: none;\n  padding: 8px 14px;\n  border-radius: 8px;\n  font-size: 13px;\n}\n\n.Mascot {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding: 1rem 1rem 1.1rem;\n  border: 1px solid rgba(168, 85, 247, 0.45);\n  background:\n    radial-gradient(ellipse at 50% 18%, rgba(168, 85, 247, 0.22), transparent 46%),\n    linear-gradient(180deg, rgba(12, 6, 22, 0.92), rgba(4, 2, 10, 0.96));\n  box-shadow:\n    0 0 0 1px rgba(0, 240, 255, 0.08) inset,\n    0 18px 40px rgba(0, 0, 0, 0.35);\n}\n\n.Mascot .tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  margin: 0 0 0.3rem;\n  color: #c084fc;\n  font-family: var(--font-share-tech-mono), ui-monospace, monospace;\n  font-size: 0.62rem;\n  font-weight: 800;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n}\n\n.Mascot .name {\n  margin: 0;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: clamp(1.4rem, 2.2vw, 2rem);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: #f4e8ff;\n  text-shadow: 0 0 18px rgba(168, 85, 247, 0.55);\n}\n\n.Mascot .role {\n  margin: 0.35rem 0 0;\n  color: #00f0ff;\n  font-family: var(--font-share-tech-mono), ui-monospace, monospace;\n  font-size: 0.78rem;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  text-shadow: 0 0 12px rgba(0, 240, 255, 0.45);\n}\n\n.Mascot .note {\n  margin: 0.4rem 0 0.7rem;\n  color: var(--fcg-muted);\n  font-size: 0.86rem;\n  line-height: 1.45;\n}\n\n.Mascot .hint {\n  margin: 0 0 0.85rem;\n  color: #00f0ff;\n  font-size: 0.8rem;\n  line-height: 1.45;\n}\n\n.Mascot .hint span {\n  display: block;\n  color: #ff0055;\n  font-size: 0.62rem;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  font-weight: 800;\n  margin-bottom: 0.2rem;\n}\n\n.Mascot .stageBox {\n  position: relative;\n  isolation: isolate;\n  height: min(58vh, 520px);\n  overflow: hidden;\n  background: #050208;\n}\n\n.Mascot .veil {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: flex-end;\n  padding: 1.4rem 1.2rem 1.5rem;\n  background:\n    linear-gradient(180deg, rgba(8, 2, 18, 0.2) 0%, rgba(4, 1, 12, 0.72) 48%, rgba(2, 0, 8, 0.96) 100%),\n    radial-gradient(ellipse at 70% 18%, rgba(168, 85, 247, 0.28), transparent 52%),\n    repeating-linear-gradient(-18deg, transparent 0 14px, rgba(0, 240, 255, 0.04) 14px 15px);\n}\n\n.Mascot .vk {\n  margin: 0;\n  color: #c084fc;\n  font-family: var(--font-share-tech-mono), ui-monospace, monospace;\n  font-size: 0.62rem;\n  font-weight: 800;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n}\n\n.Mascot .vt {\n  margin: 0.35rem 0 0.45rem;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: clamp(1.5rem, 3vw, 2.2rem);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: #f4e8ff;\n  text-shadow: 0 0 22px rgba(168, 85, 247, 0.55);\n}\n\n.Mascot .vb {\n  margin: 0 0 0.8rem;\n  max-width: 22rem;\n  color: #9adfff;\n  font-size: 0.86rem;\n  line-height: 1.45;\n}\n\n.Mascot .replay {\n  position: relative;\n  z-index: 1;\n  color: #120616;\n  background: linear-gradient(90deg, #c084fc, #00f0ff);\n  border: 0;\n  padding: 0.45rem 0.7rem;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: 0.68rem;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  clip-path: var(--fcg-clip);\n}\n\n.Mascot .socials {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.45rem;\n  margin-top: 0.85rem;\n}\n\n.Mascot .primary,\n.Mascot .link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 2.2rem;\n  padding: 0.4rem 0.55rem;\n  text-decoration: none;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: 0.68rem;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  clip-path: var(--fcg-clip);\n}\n\n.Mascot .primary {\n  grid-column: 1 / -1;\n  color: #120616;\n  background: linear-gradient(90deg, #c084fc, #00f0ff);\n}\n\n.Mascot .link {\n  color: #e9d5ff;\n  border: 1px solid rgba(192, 132, 252, 0.45);\n  background: rgba(88, 28, 135, 0.28);\n}\n\n.board {\n  display: grid;\n  grid-template-columns: repeat(12, minmax(0, 1fr));\n  gap: 1.1vw;\n}\n\n.span6 { grid-column: span 6; }\n.span4 { grid-column: span 4; }\n.span12 { grid-column: span 12; }\n\n.section {\n  min-height: 22vw;\n  padding: clamp(1rem, 1.6vw, 1.8rem);\n  border: 1px solid rgba(0, 240, 255, 0.22);\n  background: rgba(13, 19, 26, 0.9);\n  display: flex;\n  flex-direction: column;\n}\n\n.section h2 {\n  margin: 0 0 0.55rem;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: clamp(1.15rem, 2vw, 2rem);\n  text-transform: uppercase;\n  color: var(--fcg-text);\n}\n\n.section p {\n  margin: 0 0 1rem;\n  color: var(--fcg-text);\n  line-height: 1.6;\n  font-size: clamp(0.92rem, 1.05vw, 1.08rem);\n}\n\n.cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\n  gap: 0.7rem;\n  margin-top: auto;\n}\n\n.card {\n  padding: 0.85rem 0.95rem;\n  border: 1px solid rgba(255, 0, 85, 0.28);\n  background: linear-gradient(180deg, rgba(18, 25, 34, 0.96), rgba(13, 19, 26, 0.96));\n}\n\n.card h3 {\n  margin: 0 0 0.35rem;\n  color: var(--fcg-teal);\n  font-size: 0.95rem;\n}\n\n.card p {\n  margin: 0;\n  font-size: 0.88rem;\n}\n\n.tag {\n  display: inline-block;\n  margin: 0 0 0.4rem;\n  color: var(--fcg-gold);\n  font-size: 0.68rem;\n  font-weight: 800;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin-top: 0.8rem;\n}\n\n.links a,\n.links button {\n  color: var(--fcg-teal);\n  font-weight: 700;\n  text-decoration: none;\n  border: 1px solid rgba(0, 240, 255, 0.35);\n  padding: 0.35rem 0.65rem;\n  font-size: 0.75rem;\n  background: transparent;\n  font-family: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.subhead {\n  margin: 0 0 0.85rem;\n  max-width: 72ch;\n  color: var(--fcg-text);\n  line-height: 1.65;\n  font-size: clamp(1rem, 1.15vw, 1.15rem);\n}\n\n.footnote {\n  margin: 1rem 0 0;\n  max-width: 70ch;\n  color: var(--fcg-muted);\n  font-size: 0.72rem;\n  line-height: 1.45;\n  letter-spacing: 0.02em;\n}\n\n.raid {\n  min-height: auto;\n  padding: clamp(1rem, 1.8vw, 2rem);\n  border: 1px solid rgba(0, 240, 255, 0.32);\n  background: rgba(8, 4, 16, 0.86);\n  clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);\n  box-shadow: 0 0 28px rgba(0, 240, 255, 0.12);\n}\n\n.raid .rk {\n  margin: 0 0 0.45rem;\n  font-family: var(--font-share-tech-mono), ui-monospace, monospace;\n  font-size: 0.72rem;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--fcg-teal);\n}\n\n.raid h2 {\n  margin: 0 0 0.55rem;\n  font-family: var(--font-orbitron), sans-serif;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--fcg-text);\n  font-size: clamp(1.15rem, 2vw, 2rem);\n}\n\n.raid .rlead {\n  margin: 0 0 1.1rem;\n  max-width: 72ch;\n  color: var(--fcg-muted);\n  line-height: 1.55;\n}\n\n.raid .rlead a { color: var(--fcg-teal); }\n\n.raid ol {\n  margin: 0 0 12px;\n  padding-left: 20px;\n  line-height: 1.5;\n  color: var(--fcg-text);\n}\n\n.raid .steps {\n  margin: 0 0 1rem;\n  padding-left: 1.2rem;\n  color: var(--fcg-muted);\n  line-height: 1.55;\n}\n\n.countRow {\n  display: flex;\n  align-items: baseline;\n  gap: 0.6rem;\n  flex-wrap: wrap;\n}\n\n.count {\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: clamp(2.2rem, 6vw, 4rem);\n  color: var(--fcg-teal);\n  text-shadow: 0 0 22px rgba(0, 240, 255, 0.45);\n  line-height: 1;\n}\n\n.goal {\n  font-family: var(--font-share-tech-mono), ui-monospace, monospace;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--fcg-pink);\n}\n\n.bar {\n  margin-top: 0.7rem;\n  height: 12px;\n  background: #030507;\n  border: 1px solid rgba(0, 240, 255, 0.35);\n  overflow: hidden;\n}\n\n.fill {\n  height: 100%;\n  width: 0;\n  background: linear-gradient(90deg, #00f0ff, #ff0055);\n  box-shadow: 0 0 16px rgba(0, 240, 255, 0.45);\n}\n\n.status {\n  margin: 0.55rem 0 0;\n  font-family: var(--font-share-tech-mono), ui-monospace, monospace;\n  font-size: 0.78rem;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--fcg-text);\n}\n\n.raid .fine {\n  font-size: 12px;\n  opacity: 0.8;\n  margin-top: 12px;\n  line-height: 1.45;\n  color: var(--fcg-text);\n}\n\n.actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.7rem;\n  margin-top: 0.8rem;\n}\n\n.actions a {\n  display: inline-flex;\n  align-items: center;\n  padding: 0.7rem 1.1rem;\n  font-family: var(--font-orbitron), sans-serif;\n  font-size: 0.78rem;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  text-decoration: none;\n  clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);\n}\n\n.actions .primary {\n  color: #030507;\n  background: #00f0ff;\n  border: 1px solid #00f0ff;\n}\n\n.actions .secondary {\n  color: #00f0ff;\n  background: transparent;\n  border: 1px solid #00f0ff;\n}\n\n@media (max-width: 1100px) {\n  .hero {\n    grid-template-columns: 1fr;\n    min-height: auto;\n  }\n\n  .span6,\n  .span4 {\n    grid-column: span 12;\n  }\n\n  .section {\n    min-height: auto;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .navLinks a {\n    transition: none;\n  }\n}\n"
  try
    write with "sites/landing/index.html", page
    write with "sites/landing/site.css", css
    say "wrote sites/landing/index.html and sites/landing/site.css"
  miss problem
    say problem
    write with "site/index.html", page
    write with "site/site.css", css
    say "wrote site/index.html and site/site.css"
  end
  say "Your space is yours to build."
end
