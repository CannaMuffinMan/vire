{
  "id": "fcgbc-headers",
  "source": "fcgbc-go server.go: writeJSON/writeJSONNode set Content-Type. PR #92 / CouchStation Go writeJSON uses application/json with no charset (json.NewEncoder still UTF-8). OPTIONS is middleware 204 with CORS only (no Content-Type). Native parkNet txt_hdrs and host SendApi match that JSON type. JSON routes also get Connection: close, nosniff, Cache-Control: no-store, and the default CORS triple (no Origin, NODE_ENV not production).",
  "json_headers": {
    "content-type": "application/json",
    "connection": "close",
    "x-content-type-options": "nosniff",
    "cache-control": "no-store",
    "access-control-allow-origin": "*",
    "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
    "access-control-allow-headers": "Origin, X-Requested-With, Content-Type, Accept, Authorization, x-fcgbc-admin-secret"
  },
  "options_headers": {
    "connection": "close",
