{
  "id": "api",
  "source": "landing-go unauth fixture JSON APIs, derived from source, not live.",
  "headers_that_matter": [
    "content-type",
    "connection",
    "x-content-type-options",
    "cache-control",
    "location",
    "www-authenticate",
    "x-payments-enabled"
  ],
  "cases": [
    {
      "name": "get_capabilities",
      "method": "GET",
      "path": "/api/capabilities",
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store",
        "x-payments-enabled": "off"
      },
      "body": "{\"merch\":false,\"adsense\":false,\"adsenseClientId\":null,\"billing\":false}"
    },
    {
      "name": "get_couchy_status",
      "method": "GET",
      "path": "/api/couchy/status",
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"maintenance\":true}"
    },
    {
      "name": "get_live_popup",
      "method": "GET",
      "path": "/api/live-popup",
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"channel\":null,\"platform\":null,\"title\":null,\"endedAt\":null,\"clipUrl\":null,\"posterUrl\":null,\"isLive\":false,\"streamUrl\":null}"
    },
    {
      "name": "get_auth",
      "method": "GET",
      "path": "/api/auth",
      "status": 401,
      "headers": {
        "content-type": "text/plain; charset=utf-8",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store",
        "www-authenticate": "Basic realm=\"Protected\""
      },
      "body": "Authentication required."
    },
    {
      "name": "get_internal_version",
      "method": "GET",
      "path": "/api/internal/version",
      "status": 200,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"version\":\"unknown\",\"status\":\"offline\"}"
    },
    {
      "name": "get_subscription",
      "method": "GET",
      "path": "/api/subscription",
      "status": 503,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"enabled\":false}"
    }
  ]
}
