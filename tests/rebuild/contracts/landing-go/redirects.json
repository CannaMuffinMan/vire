{
  "id": "redirects",
  "source": "landing-go 307 redirects, derived from source, not live. Body carries status/location needles for native mapping.",
  "headers_that_matter": [
    "content-type",
    "connection",
    "x-content-type-options",
    "cache-control",
    "location",
    "www-authenticate",
    "x-payments-enabled"
  ],
