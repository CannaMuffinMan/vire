{
  "id": "dev-portal-go/dist-missing",
  "source": "dev-portal-go GET / with DEV_PORTAL_DIST unset: dist_missing is returned before the page cookie gate.",
  "headers_that_matter": [
    "content-type",
    "connection",
    "x-content-type-options",
    "cache-control"
  ],
  "cases": [
    {
      "name": "get_root_dist_missing",
      "method": "GET",
      "path": "/",
      "status": 503,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"reason\":\"dist_missing\",\"status\":503}"
    },
    {
      "name": "get_login_dist_missing",
      "method": "GET",
      "path": "/login",
      "status": 503,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"reason\":\"dist_missing\",\"status\":503}"
    },
    {
      "name": "post_root_dist_missing",
      "method": "POST",
      "path": "/",
      "status": 503,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"reason\":\"dist_missing\",\"status\":503}",
      "request_body": ""
    }
  ]
}
