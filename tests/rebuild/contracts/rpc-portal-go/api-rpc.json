{
  "id": "rpc-portal-go/api-rpc",
  "source": "rpc-portal-go GET /api/rpc with no FCGBC_BASE_URL. Go body {enabled:false} HTTP 503. Vire adds status:503 for StatusOf.",
  "headers_that_matter": [
    "content-type",
    "connection",
    "x-content-type-options",
    "cache-control"
  ],
  "cases": [
    {
      "name": "get_api_rpc_off",
      "method": "GET",
      "path": "/api/rpc",
      "status": 503,
      "headers": {
        "content-type": "application/json",
        "connection": "close",
        "x-content-type-options": "nosniff",
        "cache-control": "no-store"
      },
      "body": "{\"enabled\":false,\"status\":503}"
    }
  ]
}
