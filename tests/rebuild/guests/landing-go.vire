  end
  if path == "/youtube-verification-guide"
    return landingHtml with path
  end
  if path == "/welcome-to-the-gang"
    return landingHtml with path
  end
  if path == "/mscb/oauth-done"
    return landingHtml with path
  end
  return "{\"ok\":false,\"status\":404,\"error\":\"not found\"}"
end

define main
  listen with 18080
end
