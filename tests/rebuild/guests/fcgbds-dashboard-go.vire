~ fcgbds-dashboard-go unauth routes with Upstream nil (derived from source, not live).
~ Go writeJSON uses Encoder.Encode (trailing newline). PaymentsEnabled is compile-time false.
~ Static export files and 307 /obs are blocked. JSON "status":N is added on non-200.

define route with method, path, body
  if path == "/api/health"
    return "{\"ok\":true,\"service\":\"fcgbds-dashboard\"}\n"
  end
  if path == "/api/challenge"
    return "{\"caption\":\"Visitor check is unavailable. You were not blocked.\",\"unavailable\":true}\n"
  end
  if path == "/api/challenge-verify"
    if method == "POST"
      return "{\"caption\":\"Visitor check could not be scored. You were not blocked.\",\"ok\":false,\"outcome\":\"unavailable\"}\n"
    end
    return "{\"error\":\"Method not allowed\",\"status\":405}\n"
  end
  if path == "/api/events"
    return "{\"details\":\"All upstream attempts failed\",\"error\":\"Failed to fetch events\",\"status\":502}\n"
  end
  if path == "/api/events-detailed"
    return "{\"error\":\"Detailed events unavailable\",\"status\":503}\n"
  end
  if path == "/api/stats"
    return "{\"gated\":true,\"publicWallEnabled\":false,\"statsAvailable\":false,\"streamUnlocked\":false}\n"
  end
  if path == "/api/stats-detailed"
    return "{\"error\":\"Detailed stats unavailable\",\"statsAvailable\":false,\"status\":503}\n"
  end
  if path == "/api/reviewers-heartbeat"
    if method == "POST"
      return "{\"fallback\":true,\"fallbackReason\":\"upstream_blocked_or_unavailable\",\"ok\":false,\"reviewers\":{\"live\":0}}\n"
    end
    return "{\"error\":\"Method not allowed\",\"status\":405}\n"
  end
  if path == "/api/stream-wall/status"
    if method == "GET"
      return "{\"unlocked\":false,\"scheduledUnlockAt\":null,\"liveNow\":false,\"live\":[]}\n"
    end
    return "{\"error\":\"method_not_allowed\",\"status\":405}\n"
  end
  if path == "/api/stream-wall/tilt"
    if method == "GET"
      return "{\"error\":\"tilt_upstream_unavailable\",\"status\":502}\n"
    end
    if method == "POST"
      return "{\"error\":\"tilt_upstream_unavailable\",\"status\":502}\n"
    end
    return "{\"error\":\"method_not_allowed\",\"status\":405}\n"
  end
  if path == "/defense-reports"
    return "{\"reason\":\"dist_missing\",\"status\":503}\n"
  end
  if path == "/insane-counter"
    return "{\"reason\":\"dist_missing\",\"status\":503}\n"
  end
  if path == "/owner"
    return "{\"reason\":\"dist_missing\",\"status\":503}\n"
  end
  if path == "/"
    return "{\"reason\":\"dist_missing\",\"status\":503}\n"
  end
  return "{\"error\":\"not_found\",\"status\":404}\n"
end

define main
  listen with 18080
end
