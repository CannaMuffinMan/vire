~ Listen-side RFC 6455 Upgrade hijack into a loopback WS upstream.
~ Route returns {"status":101,"port":N}; host/native listen splices the client.

define route with method, path, body
  if path == "/ws/refuse"
    return "{\"error\":\"forbidden\",\"status\":403}"
  end
  if path == "/ws/echo"
    let port be number with (args at 0)
    return "{\"status\":101,\"port\":" + (text with port) + "}"
  end
  return "{\"ok\":false,\"status\":404,\"error\":\"not found\"}"
end

define main
  listen with 0
end
