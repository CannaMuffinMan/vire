define main
  let big be "x"
  let n be 0
  while n < 16
    let big be big + big
    let n be n + 1
  end
  let bigb be "y"
  let n be 0
  while n < 16
    let bigb be bigb + bigb
    let n be n + 1
  end
  let keep be []
  let n be 0
  while n < 470
    let keep be push with keep, (big + "K")
    let n be n + 1
  end
  let i be 0
  let bad be 0
  while i < 60
    let a be big + "A"
    let b be bigb + "B"
    let c be a + b
    if (c at 0) != "x"
      let bad be bad + 1
    end
    if (c at 65535) != "x"
      let bad be bad + 1
    end
    if (c at 65536) != "A"
      let bad be bad + 1
    end
    if (c at 65537) != "y"
      let bad be bad + 1
    end
    if (c at 131072) != "y"
      let bad be bad + 1
    end
    if (c at 131073) != "B"
      let bad be bad + 1
    end
    let i be i + 1
  end
  say (length with keep)
  if bad == 0
    say "textcat ok"
  end
  if bad != 0
    say "textcat corrupt"
    say bad
  end
end
