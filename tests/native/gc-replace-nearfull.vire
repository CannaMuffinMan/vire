define main
  let big be "x"
  let n be 0
  while n < 16
    let big be big + big
    let n be n + 1
  end
  let keep be []
  let n be 0
  while n < 470
    let keep be push with keep, (big + "K")
    let n be n + 1
  end
  let i be 0
  let bad be 0
  while i < 60
    let src be big + "AAA"
    let out be replace with src, "A", "Z"
    if (out at 0) != "x"
      let bad be bad + 1
    end
    if (out at 65535) != "x"
      let bad be bad + 1
    end
    if (out at 65536) != "Z"
      let bad be bad + 1
    end
    if (out at 65537) != "Z"
      let bad be bad + 1
    end
    if (out at 65538) != "Z"
      let bad be bad + 1
    end
    let i be i + 1
  end
  say (length with keep)
  if bad == 0
    say "replace ok"
  end
  if bad != 0
    say "replace corrupt"
    say bad
  end
end
