define main
  let big be "x"
  let n be 0
  while n < 16
    let big be big + big
    let n be n + 1
  end
  let keep be []
  let n be 0
  while n < 470
    let keep be push with keep, (big + "K")
    let n be n + 1
  end
  let p64 be "p"
  let n be 0
  while n < 6
    let p64 be p64 + p64
    let n be n + 1
  end
  let i be 0
  let bad be 0
  while i < 40
    let xs be []
    let j be 0
    while j < 300
      let xs be push with xs, (p64 + (text with j))
      let j be j + 1
    end
    let t be text with xs
    if (length with t) < 19200
      let bad be bad + 1
    end
    if (find with t, (p64 + "299")) < 0
      let bad be bad + 1
    end
    let m be {}
    let j be 0
    while j < 100
      put j into m at (p64 + (text with j))
      let j be j + 1
    end
    if not (has with m, (p64 + "77"))
      let bad be bad + 1
    end
    if has with m, (p64 + "777")
      let bad be bad + 1
    end
    let s be (p64 + (text with i)) + big
    if (length with s) != (64 + (length with (text with i)) + 65536)
      let bad be bad + 1
    end
    let mt be text with m
    if (find with mt, (p64 + "99")) < 0
      let bad be bad + 1
    end
    let i be i + 1
  end
  say (length with keep)
  if bad == 0
    say "tah ok"
  end
  if bad != 0
    say "tah corrupt"
    say bad
  end
end
