define main
  let big be "x"
  let n be 0
  while n < 16
    let big be big + big
    let n be n + 1
  end
  let keep be []
  let n be 0
  while n < 470
    let keep be push with keep, (big + "K")
    let n be n + 1
  end
  let a be big + "A"
  let b be 7
  let c be a + b
  let bad be 0
  if (c at 0) != "x"
    let bad be bad + 1
  end
  if (c at 65535) != "x"
    let bad be bad + 1
  end
  if (c at 65536) != "A"
    let bad be bad + 1
  end
  if (c at 65537) != "7"
    let bad be bad + 1
  end
  say (length with keep)
  if bad == 0
    say "add ok"
  end
  if bad != 0
    say "add corrupt"
    say bad
  end
end
