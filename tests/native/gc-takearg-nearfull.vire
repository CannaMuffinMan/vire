define main
  let big be "x"
  let n be 0
  while n < 16
    let big be big + big
    let n be n + 1
  end
  let a be "cmd"
  if (length with args) > 0
    let a be args at 0
  end
  let src be a + big
  let keep be []
  let n be 0
  while n < 470
    let keep be push with keep, (big + "K")
    let n be n + 1
  end
  let i be 0
  let bad be 0
  while i < 60
    let out be replace with src, "x", "y"
    if (length with out) != (length with src)
      let bad be bad + 1
    end
    if (out at (length with a)) != "y"
      let bad be bad + 1
    end
    let i be i + 1
  end
  say (length with keep)
  if bad == 0
    say "take_arg ok"
  end
  if bad != 0
    say "take_arg corrupt"
    say bad
  end
end
