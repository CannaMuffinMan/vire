define page with title, body
  return "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>" + (escape with title) + "</title><link rel=\"stylesheet\" href=\"app.css\"></head><body><main>" + body + "</main></body></html>"
end

define style with name
  return "body{font-family:Georgia,serif;margin:0;background:#f4efe6;color:#1c1915}main{max-width:36rem;margin:4rem auto;padding:0 1.5rem}h1{font-weight:500}button,textarea{font:inherit}textarea{width:100%;min-height:8rem}"
end
