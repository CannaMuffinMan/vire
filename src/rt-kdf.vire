define bcryptExpand0 with tab, P, S, key, klen, L, R, f, tmp, kw
  let pos be [0]
  let i be 0
  while i < 18
    bcryptStreamWord_into with kw, key, klen, pos
    bcryptXor32_into with tab, (P at i), (P at i), kw
    let i be i + 1
  end
  put 0 into L at 0
  put 0 into L at 1
  put 0 into R at 0
  put 0 into R at 1
  let i be 0
  while i < 18
    bcryptEncipher with tab, L, R, P, S, f, tmp
    bcryptCopy32_into with (P at i), L
    let i1 be i + 1
    bcryptCopy32_into with (P at i1), R
    let i be i + 2
  end
  let i be 0
  while i < 1024
    bcryptEncipher with tab, L, R, P, S, f, tmp
    bcryptCopy32_into with (S at i), L
    let i1 be i + 1
    bcryptCopy32_into with (S at i1), R
    let i be i + 2
  end
  return 0
end

define bcryptExpandState with tab, P, S, salt, slen, key, klen, L, R, f, tmp, kw
  let pos be [0]
  let i be 0
  while i < 18
    bcryptStreamWord_into with kw, key, klen, pos
    bcryptXor32_into with tab, (P at i), (P at i), kw
    let i be i + 1
  end
  let spos be [0]
  put 0 into L at 0
  put 0 into L at 1
  put 0 into R at 0
  put 0 into R at 1
  let i be 0
  while i < 18
    bcryptStreamWord_into with kw, salt, slen, spos
    bcryptXor32_into with tab, L, L, kw
    bcryptStreamWord_into with kw, salt, slen, spos
    bcryptXor32_into with tab, R, R, kw
    bcryptEncipher with tab, L, R, P, S, f, tmp
    bcryptCopy32_into with (P at i), L
    let i1 be i + 1
    bcryptCopy32_into with (P at i1), R
    let i be i + 2
  end
  let i be 0
  while i < 1024
    bcryptStreamWord_into with kw, salt, slen, spos
    bcryptXor32_into with tab, L, L, kw
    bcryptStreamWord_into with kw, salt, slen, spos
    bcryptXor32_into with tab, R, R, kw
    bcryptEncipher with tab, L, R, P, S, f, tmp
    bcryptCopy32_into with (S at i), L
    let i1 be i + 1
    bcryptCopy32_into with (S at i1), R
    let i be i + 2
  end
  return 0
end

define bcryptItoa64
  return "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
end

define bcryptB64Val with ch
  let t be bcryptItoa64
  return find with t, ch
end

define bcryptEncode with buf, n
  let alpha be bcryptItoa64
  let out be ""
  let i be 0
  while i < n
    let c1 be buf at i
    let i be i + 1
    let idx be idiv with c1, 4
    let out be out + (alpha at idx)
    let c1 be c1 % 4
    let c1 be c1 + c1
    let c1 be c1 + c1
    let c1 be c1 + c1
    let c1 be c1 + c1
    if i >= n
      let out be out + (alpha at c1)
      stop
    end
    let c2 be buf at i
    let i be i + 1
    let mix be c1 + (idiv with c2, 16)
    let out be out + (alpha at mix)
    let c1 be c2 % 16
    let c1 be c1 + c1
    let c1 be c1 + c1
    if i >= n
      let out be out + (alpha at c1)
      stop
    end
    let c2 be buf at i
    let i be i + 1
    let mix be c1 + (idiv with c2, 64)
    let out be out + (alpha at mix)
    let out be out + (alpha at (c2 % 64))
  end
  return out
end

define bcryptDecode with text, nwant
  let out be []
  let i be 0
  let n be length with text
  while (length with out) < nwant
    if i >= n
      return ["bad", out]
    end
    let c1 be bcryptB64Val with (text at i)
    let i be i + 1
    if c1 < 0
      return ["bad", out]
    end
    if i >= n
      return ["bad", out]
    end
    let c2 be bcryptB64Val with (text at i)
    let i be i + 1
    if c2 < 0
      return ["bad", out]
    end
    let b be c1 + c1
    let b be b + b
    let b be b + (idiv with c2, 16)
    push with out, b
    if (length with out) >= nwant
      stop
    end
    if i >= n
      return ["bad", out]
    end
    let c3 be bcryptB64Val with (text at i)
    let i be i + 1
    if c3 < 0
      return ["bad", out]
    end
    let t be c2 % 16
    let t be t + t
    let t be t + t
    let t be t + t
    let t be t + t
    let b be t + (idiv with c3, 4)
    push with out, b
    if (length with out) >= nwant
      stop
    end
    if i >= n
      return ["bad", out]
    end
    let c4 be bcryptB64Val with (text at i)
    let i be i + 1
    if c4 < 0
      return ["bad", out]
    end
    let t be (c3 % 4)
    let t be t + t
    let t be t + t
    let t be t + t
    let t be t + t
    let t be t + t
    let t be t + t
    push with out, (t + c4)
  end
  return ["ok", out]
end

define bcryptPrepareKey with pw
  let out be []
  let n be length with pw
  if n > 72
    let n be 72
  end
  let i be 0
  while i < n
    push with out, (pw at i)
    let i be i + 1
  end
  push with out, 0
  return out
end

define bcryptCostText with cost
  let tens be idiv with cost, 10
  let ones be cost % 10
  let d be "0123456789"
  return (d at tens) + (d at ones)
end

define bcryptParseCost with a, b
  let d be "0123456789"
  let t be find with d, a
  let o be find with d, b
  if t < 0
    return 0 - 1
  end
  if o < 0
    return 0 - 1
  end
  return (t + t + t + t + t + t + t + t + t + t) + o
end

define bcrypt_hash_tab with tab, pw, cost, salt
  if cost < 4
    return ["bad", "bcrypt cost"]
  end
  if cost > 31
    return ["bad", "bcrypt cost"]
  end
  let slen be length with salt
  if slen != 16
    return ["bad", "bcrypt salt"]
  end
  let key be bcryptPrepareKey with pw
  let klen be length with key
  let P be bcryptPiP
  let S be bcryptPiS
  let L be [0, 0]
  let R be [0, 0]
  let f be [0, 0]
  let tmp be [0, 0]
  let kw be [0, 0]
  bcryptExpandState with tab, P, S, salt, 16, key, klen, L, R, f, tmp, kw
  let rounds be 1
  let i be 0
  while i < cost
    let rounds be rounds + rounds
    let i be i + 1
  end
  let k be 0
  while k < rounds
    bcryptExpand0 with tab, P, S, key, klen, L, R, f, tmp, kw
    bcryptExpand0 with tab, P, S, salt, 16, L, R, f, tmp, kw
    let k be k + 1
  end
  let magic be [79, 114, 112, 104, 101, 97, 110, 66, 101, 104, 111, 108, 100, 101, 114, 83, 99, 114, 121, 68, 111, 117, 98, 116]
  let c0l be [0, 0]
  let c0r be [0, 0]
  let c1l be [0, 0]
  let c1r be [0, 0]
  let c2l be [0, 0]
  let c2r be [0, 0]
  bcryptLoadBE_into with c0l, magic, 0
  bcryptLoadBE_into with c0r, magic, 4
  bcryptLoadBE_into with c1l, magic, 8
  bcryptLoadBE_into with c1r, magic, 12
  bcryptLoadBE_into with c2l, magic, 16
  bcryptLoadBE_into with c2r, magic, 20
  let k be 0
  while k < 64
    bcryptEncipher with tab, c0l, c0r, P, S, f, tmp
    bcryptEncipher with tab, c1l, c1r, P, S, f, tmp
    bcryptEncipher with tab, c2l, c2r, P, S, f, tmp
    let k be k + 1
  end
  let ct be []
  let ct be bcryptStoreBE with ct, c0l
  let ct be bcryptStoreBE with ct, c0r
  let ct be bcryptStoreBE with ct, c1l
  let ct be bcryptStoreBE with ct, c1r
  let ct be bcryptStoreBE with ct, c2l
  let ct be bcryptStoreBE with ct, c2r
  let prefix be "$2b$" + (bcryptCostText with cost) + "$"
  let enc be prefix + (bcryptEncode with salt, 16) + (bcryptEncode with ct, 23)
  return ["ok", enc]
end

define bcrypt_hash with pw, cost, salt
  return bcrypt_hash_tab with (bcryptMakeXorTab), pw, cost, salt
end

define bcrypt_parse with setting
  let n be length with setting
  if n != 60
    return ["bad", "bcrypt setting"]
  end
  if (setting at 0) != "$"
    return ["bad", "bcrypt setting"]
  end
  if (setting at 1) != "2"
    return ["bad", "bcrypt setting"]
  end
  let minor be setting at 2
  if minor != "b"
    if minor != "a"
      if minor != "y"
        return ["bad", "bcrypt setting"]
      end
    end
  end
  if (setting at 3) != "$"
    return ["bad", "bcrypt setting"]
  end
  if (setting at 6) != "$"
    return ["bad", "bcrypt setting"]
  end
  let cost be bcryptParseCost with (setting at 4), (setting at 5)
  if cost < 4
    return ["bad", "bcrypt cost"]
  end
  if cost > 31
    return ["bad", "bcrypt cost"]
  end
  let salt22 be slice with setting, 7, 29
  let dec be bcryptDecode with salt22, 16
  if (dec at 0) != "ok"
    return ["bad", "bcrypt salt"]
  end
  return ["ok", cost, (dec at 1), setting]
end

define bcrypt_ct_eq with left, right
  let n be length with left
  let m be length with right
  let d be 0
  if n != m
    let d be 1
  end
  let lim be n
  if m > lim
    let lim be m
  end
  let i be 0
  while i < lim
    let a be " "
    let b be " "
    if i < n
      let a be left at i
    end
    if i < m
      let b be right at i
    end
    if a != b
      let d be 1
    end
    let i be i + 1
  end
  if d == 0
    return true
  end
  return false
end

define bcrypt_verify_tab with tab, pw, setting
  let parsed be bcrypt_parse with setting
  if (parsed at 0) != "ok"
    return false
  end
  let cost be parsed at 1
  let salt be parsed at 2
  let got be bcrypt_hash_tab with tab, pw, cost, salt
  if (got at 0) != "ok"
    return false
  end
  let rec be got at 1
  ~ Full 60-char digest walk; 2a/2y vs emitted 2b compared from '$' cost onward.
  let left be slice with rec, 3, 60
  let right be slice with setting, 3, 60
  return bcrypt_ct_eq with left, right
end

define bcrypt_verify with pw, setting
  return bcrypt_verify_tab with (bcryptMakeXorTab), pw, setting
end
