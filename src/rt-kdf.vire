~ Guest bcrypt ($2b$): EksBlowfish, OpenBSD layout, 72-byte key + NUL.
~ Comparison walks every digest byte (not a CPU timing barrier).

define bcryptXor8 with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  return r
end

define bcryptTimes256 with n
  let v be n + n
  let v be v + v
  let v be v + v
  let v be v + v
  let v be v + v
  let v be v + v
  let v be v + v
  let v be v + v
  return v
end

define bcryptMakeXorTab
  let tab be []
  let a be 0
  while a < 256
    let b be 0
    while b < 256
      let r be 0
      let p be 1
      let x be a
      let y be b
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      let x be idiv with x, 2
      let y be idiv with y, 2
      let p be p + p
      let xb be x % 2
      let yb be y % 2
      if xb != yb
        let r be r + p
      end
      push with tab, r
      let b be b + 1
    end
    let a be a + 1
  end
  return tab
end

define bcryptXor8tab with tab, a, b
  let i be bcryptTimes256 with a
  return tab at (i + b)
end

define bcryptXor16tab with tab, a, b
  let ah be idiv with a, 256
  let al be a % 256
  let bh be idiv with b, 256
  let bl be b % 256
  let hi be bcryptXor8tab with tab, ah, bh
  let lo be bcryptXor8tab with tab, al, bl
  let out be bcryptTimes256 with hi
  return out + lo
end

define bcryptXor32_into with tab, dst, a, b
  let hi be bcryptXor16tab with tab, (a at 0), (b at 0)
  let lo be bcryptXor16tab with tab, (a at 1), (b at 1)
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define bcryptAdd32_into with dst, a, b
  let lo be (a at 1) + (b at 1)
  let c be 0
  if lo >= 65536
    let lo be lo - 65536
    let c be 1
  end
  let hi be (a at 0) + (b at 0) + c
  if hi >= 65536
    let hi be hi - 65536
  end
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define bcryptCopy32_into with dst, src
  put (src at 0) into dst at 0
  put (src at 1) into dst at 1
  return dst
end

define bcryptLoadBE_into with dst, buf, off
  let i1 be off + 1
  let i2 be off + 2
  let i3 be off + 3
  let hi be bcryptTimes256 with (buf at off)
  let hi be hi + (buf at i1)
  let lo be bcryptTimes256 with (buf at i2)
  let lo be lo + (buf at i3)
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define bcryptStoreBE with out, w
  let hi be w at 0
  let lo be w at 1
  push with out, (idiv with hi, 256)
  push with out, (hi % 256)
  push with out, (idiv with lo, 256)
  push with out, (lo % 256)
  return out
end

define bcryptF_into with tab, dst, x, S
  let a be idiv with (x at 0), 256
  let b be (x at 0) % 256
  let c be idiv with (x at 1), 256
  let d be (x at 1) % 256
  let s0 be S at a
  let i1 be b + 256
  let i2 be c + 512
  let i3 be d + 768
  let s1 be S at i1
  let s2 be S at i2
  let s3 be S at i3
  bcryptAdd32_into with dst, s0, s1
  bcryptXor32_into with tab, dst, dst, s2
  bcryptAdd32_into with dst, dst, s3
  return dst
end

define bcryptEncipher with tab, L, R, P, S, f, tmp
  bcryptXor32_into with tab, L, L, (P at 0)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 1)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 2)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 3)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 4)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 5)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 6)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 7)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 8)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 9)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 10)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 11)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 12)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 13)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 14)
  bcryptF_into with tab, f, L, S
  bcryptXor32_into with tab, R, R, f
  bcryptXor32_into with tab, R, R, (P at 15)
  bcryptF_into with tab, f, R, S
  bcryptXor32_into with tab, L, L, f
  bcryptXor32_into with tab, L, L, (P at 16)
  bcryptXor32_into with tab, tmp, R, (P at 17)
  bcryptCopy32_into with R, L
  bcryptCopy32_into with L, tmp
  return 0
end

define bcryptStreamWord_into with dst, data, n, pos
  let p be pos at 0
  let b0 be data at p
  let p be p + 1
  if p >= n
    let p be 0
  end
  let b1 be data at p
  let p be p + 1
  if p >= n
    let p be 0
  end
  let b2 be data at p
  let p be p + 1
  if p >= n
    let p be 0
  end
  let b3 be data at p
  let p be p + 1
  if p >= n
    let p be 0
  end
  put p into pos at 0
  let hi be bcryptTimes256 with b0
  let hi be hi + b1
  let lo be bcryptTimes256 with b2
  let lo be lo + b3
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

