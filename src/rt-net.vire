  emitRel with image, fixes, "txt_empty"
  emitEpi with image

  pin with labels, "rt_net_pushroute", image
  ~ Park listen ctx and recv buf across route HMAC/proxy allocs (no rbp GC walk).
  emitList with image, [72, 139, 77, 248, 131, 73, 248, 1, 131, 73, 252, 2]
  emitParkRcx with image, fixes
  emitList with image, [72, 139, 77, 248, 72, 139, 73, 8, 131, 73, 248, 1, 131, 73, 252, 2]
  emitParkRcx with image, fixes
  emitList with image, [73, 139, 77, 232, 72, 137, 77, 248]
  emitList with image, [72, 139, 77, 248, 72, 139, 81, 40, 73, 199, 69, 0, 2, 0, 0, 0, 73, 137, 85, 8, 73, 131, 197, 16]
  emitList with image, [72, 139, 77, 248, 72, 139, 81, 48, 73, 199, 69, 0, 2, 0, 0, 0, 73, 137, 85, 8, 73, 131, 197, 16]
  emitList with image, [72, 139, 77, 248, 72, 139, 81, 64, 73, 199, 69, 0, 2, 0, 0, 0, 73, 137, 85, 8, 73, 131, 197, 16]
  if route_nparams == 4
    emitList with image, [72, 139, 77, 248]
    emitCallTo with image, fixes, "rt_net_reqhead"
    emitList with image, [73, 139, 77, 184, 72, 137, 77, 248]
    emitList with image, [73, 199, 69, 0, 2, 0, 0, 0, 73, 137, 69, 8, 73, 131, 197, 16]
  end
  emitJmpTo with image, fixes, "pr_back"

  put 233 into image at (base + 2789)
  push with fixes, {"at": (base + 2790), "to": "rt_net_afterroute"}
  put 233 into image at (base + 2680)
  push with fixes, {"at": (base + 2681), "to": "rt_net_pushroute"}
  return image
end

define emitIat with image, fixes, name
  let image be emitList with image, [255, 21]
  let image be emitRel with image, fixes, name
  return image
end

define emitTcpClient with image, fixes, labels
  ~ Guest connect/send/recv/close. Loopback 127.0.0.1 only. No TLS. Check
  ~ the IPv4 literal before socket+connect. Recv cap 1000000.
  ~ WSAStartup via rt_net_init (same as listen). Send via rt_net_sendall.
  ~ Host and native apply 5s send/recv timeouts (SO_SNDTIMEO/SO_RCVTIMEO).
  pin with labels, "rt_connect", image
  emitPro with image
  emitPop2 with image
  emitList with image, [72, 137, 85, 248, 76, 137, 77, 232, 72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "conn_host"
  emitList with image, [73, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "conn_host"
  emitList with image, [77, 133, 201, 15, 142]
  emitRel with image, fixes, "conn_port"
