define times4 with n
  let v be n + n
  return v + v
end

define sha_mod32 with n
  return n % 4294967296
end

define sha_add32 with a, b
  return sha_mod32 with (a + b)
end

define sha_pow2 with n
  let p be 1
  let i be 0
  while i < n
    let p be p + p
    let i be i + 1
  end
  return p
end

define sha_rotr32 with x, n
  let p be sha_pow2 with n
  let q be sha_pow2 with (32 - n)
  let lo be x % p
  let hi be idiv with x, p
  return hi + (lo * q)
end

define sha_xor_bit with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let i be 0
  while i < 32
    let xb be x % 2
    let yb be y % 2
    if xb != yb
      let r be r + p
    end
    let x be idiv with x, 2
    let y be idiv with y, 2
    let p be p + p
    let i be i + 1
  end
  return r
end

define sha_and_bit with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let i be 0
  while i < 32
    if (x % 2) == 1
      if (y % 2) == 1
        let r be r + p
      end
    end
    let x be idiv with x, 2
    let y be idiv with y, 2
    let p be p + p
    let i be i + 1
  end
  return r
end

define sha_not32 with x
  return sha_xor_bit with x, 4294967295
end

define sha_ch with e, f, g
  return sha_xor_bit with (sha_and_bit with e, f), (sha_and_bit with (sha_not32 with e), g)
end

define sha_maj with a, b, c
  let t be sha_xor_bit with (sha_and_bit with a, b), (sha_and_bit with a, c)
  return sha_xor_bit with t, (sha_and_bit with b, c)
end

define sha_bsig0 with x
  let t be sha_xor_bit with (sha_rotr32 with x, 2), (sha_rotr32 with x, 13)
  return sha_xor_bit with t, (sha_rotr32 with x, 22)
end

define sha_bsig1 with x
  let t be sha_xor_bit with (sha_rotr32 with x, 6), (sha_rotr32 with x, 11)
  return sha_xor_bit with t, (sha_rotr32 with x, 25)
end

define sha_ssig0 with x
  let t be sha_xor_bit with (sha_rotr32 with x, 7), (sha_rotr32 with x, 18)
  return sha_xor_bit with t, (idiv with x, 8)
end

define sha_ssig1 with x
  let t be sha_xor_bit with (sha_rotr32 with x, 17), (sha_rotr32 with x, 19)
  return sha_xor_bit with t, (idiv with x, 1024)
end

define sha_be32 with buf, i
  let b0 be buf at i
  let b1 be buf at (i + 1)
  let b2 be buf at (i + 2)
  let b3 be buf at (i + 3)
  let v be b0 * 16777216
  let v be v + (b1 * 65536)
  let v be v + (b2 * 256)
  return v + b3
end

define sha_k
  return [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
end

define sha_iv
  return [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]
end

define sha_compress with h, block
  let w be []
  let t be 0
  while t < 16
    push with w, (sha_be32 with block, (t * 4))
    let t be t + 1
  end
  while t < 64
    let s0 be sha_ssig0 with (w at (t - 15))
    let s1 be sha_ssig1 with (w at (t - 2))
    let wt be sha_add32 with (w at (t - 16)), s0
    let wt be sha_add32 with wt, (w at (t - 7))
    let wt be sha_add32 with wt, s1
    push with w, wt
    let t be t + 1
  end
  let a be h at 0
  let b be h at 1
  let c be h at 2
  let d be h at 3
  let e be h at 4
  let f be h at 5
  let g be h at 6
  let hh be h at 7
  let k be sha_k
  let t be 0
  while t < 64
    let t1 be sha_add32 with hh, (sha_bsig1 with e)
    let t1 be sha_add32 with t1, (sha_ch with e, f, g)
    let t1 be sha_add32 with t1, (k at t)
    let t1 be sha_add32 with t1, (w at t)
    let t2 be sha_add32 with (sha_bsig0 with a), (sha_maj with a, b, c)
    let hh be g
    let g be f
    let f be e
    let e be sha_add32 with d, t1
    let d be c
    let c be b
    let b be a
    let a be sha_add32 with t1, t2
    let t be t + 1
  end
  put (sha_add32 with (h at 0), a) into h at 0
  put (sha_add32 with (h at 1), b) into h at 1
  put (sha_add32 with (h at 2), c) into h at 2
  put (sha_add32 with (h at 3), d) into h at 3
  put (sha_add32 with (h at 4), e) into h at 4
  put (sha_add32 with (h at 5), f) into h at 5
  put (sha_add32 with (h at 6), g) into h at 6
  put (sha_add32 with (h at 7), hh) into h at 7
  return h
end

define sha_word_bytes with out, w
  push with out, (idiv with w, 16777216)
  let w be w % 16777216
  push with out, (idiv with w, 65536)
  let w be w % 65536
  push with out, (idiv with w, 256)
  push with out, (w % 256)
  return out
end

define sha256_bytes with buf
  let h be sha_iv
  let n be length with buf
  let i be 0
  while (i + 64) <= n
    let block be []
    let j be 0
    while j < 64
      push with block, (buf at (i + j))
      let j be j + 1
    end
    let h be sha_compress with h, block
    let i be i + 64
  end
  let tail be []
  while i < n
    push with tail, (buf at i)
    let i be i + 1
  end
  push with tail, 128
  while ((length with tail) % 64) != 56
    push with tail, 0
  end
  let bits be n * 8
  let lenb be []
  let k be 0
  while k < 8
    push with lenb, 0
    let k be k + 1
  end
  let k be 7
  let x be bits
  while k >= 0
    put (x % 256) into lenb at k
    let x be idiv with x, 256
    let k be k - 1
  end
  let p be 0
  while p < 8
    push with tail, (lenb at p)
    let p be p + 1
  end
  let off be 0
  let tn be length with tail
  while off < tn
    let block be []
    let j be 0
    while j < 64
      push with block, (tail at (off + j))
      let j be j + 1
    end
    let h be sha_compress with h, block
    let off be off + 64
  end
  let out be []
  let q be 0
  while q < 8
    let out be sha_word_bytes with out, (h at q)
    let q be q + 1
  end
  return out
end

define sha256_hex with buf
  let d be sha256_bytes with buf
  return hex with d
end

define ascii_table
  return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
end

define ascii_code with ch
  if ch == "\n"
    return 10
  end
  if ch == "\r"
    return 13
  end
  if ch == "\t"
    return 9
  end
  let p be find with (ascii_table), ch
  if p < 0
    return -1
  end
  return p + 32
end

define ascii_bytes with text
  let out be []
  let i be 0
  let n be length with text
  while i < n
    let ch be text at i
    let c be ascii_code with ch
    if c < 0
      return ["bad", "non-ascii"]
    end
    push with out, c
    let i be i + 1
  end
  return ["ok", out]
end

define ascii_text with buf
  let table be ascii_table
  let out be ""
  let i be 0
  let n be length with buf
  while i < n
    let b be buf at i
    if b == 10
      let out be out + "\n"
    else if b == 13
      let out be out + "\r"
    else if b == 9
      let out be out + "\t"
    else if b < 32
      return ["bad", "non-ascii"]
    else if b > 126
      return ["bad", "non-ascii"]
    else
      let out be out + (table at (b - 32))
    end
    let i be i + 1
  end
  return ["ok", out]
end

define utf8_cont with b
  if b < 128
    return false
  end
  if b > 191
    return false
  end
  return true
end

define utf8_ok with buf
  let n be length with buf
  let i be 0
  while i < n
    let b be buf at i
    if b < 0
      return false
    end
    if b > 255
      return false
    end
    if b < 128
      let i be i + 1
      skip
    end
    if b < 194
      return false
    end
    if b < 224
      if (i + 1) >= n
        return false
      end
      if not (utf8_cont with (buf at (i + 1)))
        return false
      end
      let i be i + 2
      skip
    end
    if b < 240
      if (i + 2) >= n
        return false
      end
      let c1 be buf at (i + 1)
      let c2 be buf at (i + 2)
      if not (utf8_cont with c1)
        return false
      end
      if not (utf8_cont with c2)
        return false
      end
      if b == 224
        if c1 < 160
          return false
        end
      end
      if b == 237
        if c1 > 159
          return false
        end
      end
      let i be i + 3
      skip
    end
    if b > 244
      return false
    end
    if (i + 3) >= n
      return false
    end
    let c1 be buf at (i + 1)
    let c2 be buf at (i + 2)
    let c3 be buf at (i + 3)
    if not (utf8_cont with c1)
      return false
    end
    if not (utf8_cont with c2)
      return false
    end
    if not (utf8_cont with c3)
      return false
    end
    if b == 240
      if c1 < 144
        return false
      end
    end
    if b == 244
      if c1 > 143
        return false
      end
    end
    let i be i + 4
  end
  return true
end

define latin1_all
  let s be ""
  let n be 0
  while n < 256
    let s be s + (chr with n)
    let n be n + 1
  end
  return s
end

define utf8_bytes with text
  let fast be ascii_bytes with text
  if (fast at 0) == "ok"
    return fast
  end
  let table be latin1_all
  let out be []
  let i be 0
  let n be length with text
  while i < n
    let ch be text at i
    let c be find with table, ch
    if c < 0
      return ["bad", "non-utf8"]
    end
    push with out, c
    let i be i + 1
  end
  if not (utf8_ok with out)
    return ["bad", "bad utf8"]
  end
  return ["ok", out]
end

define utf8_text with buf
  if not (utf8_ok with buf)
    return ["bad", "bad utf8"]
  end
  let out be ""
  let i be 0
  let n be length with buf
  while i < n
    let out be out + (chr with (buf at i))
    let i be i + 1
  end
  return ["ok", out]
end

define hex_digit with ch
  if ch == "0"
    return 0
  end
  if ch == "1"
    return 1
  end
  if ch == "2"
    return 2
  end
  if ch == "3"
    return 3
  end
  if ch == "4"
    return 4
  end
  if ch == "5"
    return 5
  end
  if ch == "6"
    return 6
  end
  if ch == "7"
    return 7
  end
  if ch == "8"
    return 8
  end
  if ch == "9"
    return 9
  end
  if ch == "a"
    return 10
  end
  if ch == "A"
    return 10
  end
  if ch == "b"
    return 11
  end
  if ch == "B"
    return 11
  end
  if ch == "c"
    return 12
  end
  if ch == "C"
    return 12
  end
  if ch == "d"
    return 13
  end
  if ch == "D"
    return 13
  end
  if ch == "e"
    return 14
  end
  if ch == "E"
    return 14
  end
  if ch == "f"
    return 15
  end
  if ch == "F"
    return 15
  end
  return 0 - 1
end

define times16 with n
  let v be n + n
  let v be v + v
  let v be v + v
  let v be v + v
  return v
end

define hex_to_bytes with raw
  let n be length with raw
  if (n % 2) != 0
    return ["bad", "odd hex"]
  end
  let out be []
  let i be 0
  while i < n
    let hi be hex_digit with raw at i
    let i1 be i + 1
    let lo be hex_digit with raw at i1
    if (hi < 0) or (lo < 0)
      return ["bad", "bad hex"]
    end
    let b be times16 with hi
    let b be b + lo
    push with out, b
    let i be i + 2
  end
  return ["ok", out]
end

define copy_bytes with src
  let out be []
  let i be 0
  let n be length with src
  while i < n
    let b be src at i
    push with out, b
    let i be i + 1
  end
  return out
end

define cat_bytes with a, b
  let out be copy_bytes with a
  let i be 0
  let n be length with b
  while i < n
    let b1 be b at i
    push with out, b1
    let i be i + 1
  end
  return out
end

define hmac_sha256 with key, msg
  return hmac with key, msg
end

define hmac_sha256_hex with key, msg
  let d be hmac_sha256 with key, msg
  return hex with d
end

define b64url_table
  return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
end

define b64url_encode with buf
  let table be b64url_table
  let out be ""
  let n be length with buf
  let i be 0
  while i < n
    let b0 be buf at i
    let b1 be 0
    let b2 be 0
    let got be 1
    let i1 be i + 1
    let i2 be i + 2
    if i1 < n
      let b1 be buf at i1
      let got be 2
    end
    if i2 < n
      let b2 be buf at i2
      let got be 3
    end
    let n0 be idiv with b0, 4
    let n1 be times16 with b0 % 4
    let n1 be n1 + (idiv with b1, 16)
    let n2 be times4 with b1 % 16
    let n2 be n2 + (idiv with b2, 64)
    let n3 be b2 % 64
    let out be out + (table at n0)
    let out be out + (table at n1)
    if got > 1
      let out be out + (table at n2)
    end
    if got > 2
      let out be out + (table at n3)
    end
    let i be i + 3
  end
  return out
end

define b64url_val with ch
  return find with (b64url_table), ch
end

define b64url_decode with text
  let n be length with text
  if n == 0
    return ["ok", []]
  end
  if (n % 4) == 1
    return ["bad", "bad b64url length"]
  end
  let i be 0
  while i < n
    if (b64url_val with (text at i)) < 0
      return ["bad", "bad b64url char"]
    end
    let i be i + 1
  end
  let out be []
  let i be 0
  while i < n
    let c0 be b64url_val with text at i
    let i1 be i + 1
    let c1 be b64url_val with text at i1
    let left be n - i
    let n2 be 0
    let n3 be 0
    if left > 2
      let i2 be i + 2
      let n2 be b64url_val with text at i2
    end
    if left > 3
      let i3 be i + 3
      let n3 be b64url_val with text at i3
    end
    let b be times4 with c0
    let b be b + (idiv with c1, 16)
    push with out, b
    if left == 2
      if (c1 % 16) != 0
        return ["bad", "bad b64url leftover"]
      end
    end
    if left > 2
      let b be times16 with c1 % 16
      let b be b + (idiv with n2, 4)
      push with out, b
    end
    if left == 3
      if (n2 % 4) != 0
        return ["bad", "bad b64url leftover"]
      end
    end
    if left > 3
      let t be times16 with n2 % 4
      let b be times4 with t
      let b be b + n3
      push with out, b
    end
    let i be i + 4
  end
  return ["ok", out]
end

define ct_eq with left, right
  let n be length with left
  let m be length with right
  let d be 0
  if n != m
    let d be 1
  end
  let lim be n
  if m > lim
    let lim be m
  end
  let i be 0
  while i < lim
    let a be 0
    let b be 0
    if i < n
      let a be left at i
    end
    if i < m
      let b be right at i
    end
    if a != b
      let d be 1
    end
    let i be i + 1
  end
  if d == 0
    return true
  end
  return false
end

define jwt_token_cap
  return 8192
end

define jwt_digits_too_wide with raw
  let n be length with raw
  if n > 16
    return true
  end
  if n < 16
    return false
  end
  let cap be "9007199254740991"
  let i be 0
  while i < 16
    let a be number with (raw at i)
    let b be number with (cap at i)
    if a > b
      return true
    end
    if a < b
      return false
    end
    let i be i + 1
  end
  return false
end

define jwt_skip_space with text, i
  let n be length with text
  while i < n
    let ch be text at i
    if ch == " "
      let i be i + 1
      skip
    end
    if ch == "\t"
      let i be i + 1
      skip
    end
    if ch == "\n"
      let i be i + 1
      skip
    end
    if ch == "\r"
      let i be i + 1
      skip
    end
    stop
  end
  return i
end

define jwt_skip_string with text, i
  let n be length with text
  let i be i + 1
  while i < n
    let ch be text at i
    if ch == "\\"
      let i be i + 1
      if i >= n
        return 0 - 1
      end
      let i be i + 1
      skip
    end
    if ch == "\""
      return i + 1
    end
    let i be i + 1
  end
  return 0 - 1
end

define jwt_read_string with text, i
  let n be length with text
  let i be i + 1
  let out be ""
  while i < n
    let ch be text at i
    if ch == "\\"
      return ["bad", ""]
    end
    if ch == "\""
      let nxt be i + 1
      return ["ok", out, nxt]
    end
    let out be out + ch
    let i be i + 1
  end
  return ["bad", ""]
end

define jwt_skip_value with text, i
  let n be length with text
  let i be jwt_skip_space with text, i
  if i >= n
    return 0 - 1
  end
  let ch be text at i
  if ch == "\""
    return jwt_skip_string with text, i
  end
  if ch == "{"
    let depth be 1
    let i be i + 1
    while i < n
      let ch be text at i
      if ch == "\""
        let i be jwt_skip_string with text, i
        if i < 0
          return 0 - 1
        end
        skip
      end
      if ch == "{"
        let depth be depth + 1
      end
      if ch == "["
        let depth be depth + 1
      end
      if ch == "}"
        let depth be depth - 1
        if depth == 0
          return i + 1
        end
      end
      if ch == "]"
        let depth be depth - 1
        if depth == 0
          return i + 1
        end
      end
      let i be i + 1
    end
    return 0 - 1
  end
  if ch == "["
    let depth be 1
    let i be i + 1
    while i < n
      let ch be text at i
      if ch == "\""
        let i be jwt_skip_string with text, i
        if i < 0
          return 0 - 1
        end
        skip
      end
      if ch == "{"
        let depth be depth + 1
      end
      if ch == "["
        let depth be depth + 1
      end
      if ch == "}"
        let depth be depth - 1
        if depth == 0
          return i + 1
        end
      end
      if ch == "]"
        let depth be depth - 1
        if depth == 0
          return i + 1
        end
      end
      let i be i + 1
    end
    return 0 - 1
  end
  while i < n
    let ch be text at i
    if ch == ","
      return i
    end
    if ch == "}"
      return i
    end
    if ch == "]"
      return i
    end
    if ch == " "
      return i
    end
    let i be i + 1
  end
  return i
end

define jwt_field_string with text, key
  let n be length with text
  let i be jwt_skip_space with text, 0
  if i >= n
    return ["miss", ""]
  end
  if (text at i) != "{"
    return ["bad", "bad json"]
  end
  let i be i + 1
  let found be "miss"
  let val be ""
  while i < n
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", "truncated json"]
    end
    if (text at i) == "}"
      if found == "ok"
        return ["ok", val]
      end
      return ["miss", ""]
    end
    if (text at i) != "\""
      return ["bad", "bad json"]
    end
    let ks be jwt_read_string with text, i
    if (ks at 0) != "ok"
      return ["bad", "bad json"]
    end
    let kn be ks at 1
    let i be ks at 2
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", "truncated json"]
    end
    if (text at i) != ":"
      return ["bad", "bad json"]
    end
    let i be i + 1
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", "truncated json"]
    end
    if kn == key
      if (text at i) != "\""
        return ["bad", "alg not a string"]
      end
      let vs be jwt_read_string with text, i
      if (vs at 0) != "ok"
        return ["bad", "truncated json"]
      end
      let found be "ok"
      let val be vs at 1
      let i be vs at 2
    end
    if kn != key
      let i be jwt_skip_value with text, i
      if i < 0
        return ["bad", "bad json"]
      end
    end
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", "truncated json"]
    end
    if (text at i) == ","
      let i be i + 1
      skip
    end
    if (text at i) == "}"
      skip
    end
    if (text at i) != "}"
      if (text at i) != ","
        return ["bad", "bad json"]
      end
    end
  end
  if found == "ok"
    return ["ok", val]
  end
  return ["miss", ""]
end

define jwt_field_number with text, key
  let n be length with text
  let i be jwt_skip_space with text, 0
  if i >= n
    return ["miss", 0]
  end
  if (text at i) != "{"
    return ["bad", 0]
  end
  let i be i + 1
  let found be "miss"
  let val be 0
  while i < n
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", 0]
    end
    if (text at i) == "}"
      if found == "ok"
        return ["ok", val]
      end
      return ["miss", 0]
    end
    if (text at i) != "\""
      return ["bad", 0]
    end
    let ks be jwt_read_string with text, i
    if (ks at 0) != "ok"
      return ["bad", 0]
    end
    let kn be ks at 1
    let i be ks at 2
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", 0]
    end
    if (text at i) != ":"
      return ["bad", 0]
    end
    let i be i + 1
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", 0]
    end
    if kn == key
      let sign be 1
      if (text at i) == "-"
        let sign be 0 - 1
        let i be i + 1
      end
      let raw be ""
      while i < n
        let ch be text at i
        if (find with "0123456789", ch) >= 0
          let raw be raw + ch
          let i be i + 1
          skip
        end
        stop
      end
      if (length with raw) == 0
        return ["bad", 0]
      end
      if jwt_digits_too_wide with raw
        return ["bad", 0]
      end
      if i < n
        let ch be text at i
        if ch == "."
          return ["bad", 0]
        end
        if ch == "e"
          return ["bad", 0]
        end
        if ch == "E"
          return ["bad", 0]
        end
      end
      let expn be number with raw
      if sign < 0
        let expn be 0 - expn
      end
      let found be "ok"
      let val be expn
    end
    if kn != key
      let i be jwt_skip_value with text, i
      if i < 0
        return ["bad", 0]
      end
    end
    let i be jwt_skip_space with text, i
    if i >= n
      return ["bad", 0]
    end
    if (text at i) == ","
      let i be i + 1
    end
  end
  if found == "ok"
    return ["ok", val]
  end
  return ["miss", 0]
end

define jwt_has_crit with text
  let crit be jwt_field_string with text, "crit"
  if (crit at 0) != "miss"
    return true
  end
  let n be length with text
  let i be jwt_skip_space with text, 0
  if i >= n
    return false
  end
  if (text at i) != "{"
    return false
  end
  let i be i + 1
  while i < n
    let i be jwt_skip_space with text, i
    if i >= n
      return false
    end
    if (text at i) == "}"
      return false
    end
    if (text at i) != "\""
      return false
    end
    let ks be jwt_read_string with text, i
    if (ks at 0) != "ok"
      return false
    end
    let kn be ks at 1
    let i be ks at 2
    let i be jwt_skip_space with text, i
    if i >= n
      return false
    end
    if (text at i) != ":"
      return false
    end
    let i be i + 1
    if kn == "crit"
      return true
    end
    let i be jwt_skip_value with text, i
    if i < 0
      return false
    end
    let i be jwt_skip_space with text, i
    if i >= n
      return false
    end
    if (text at i) == ","
      let i be i + 1
    end
  end
  return false
end

define jwt_split with token
  let a be find with token, "."
  if a < 0
    return ["bad", "missing segment"]
  end
  let rest be slice with token, (a + 1), (length with token)
  let b be find with rest, "."
  if b < 0
    return ["bad", "missing segment"]
  end
  let more be slice with rest, (b + 1), (length with rest)
  if (find with more, ".") >= 0
    return ["bad", "extra segment"]
  end
  if (length with more) == 0
    return ["bad", "missing segment"]
  end
  if a == 0
    return ["bad", "missing segment"]
  end
  if b == 0
    return ["bad", "missing segment"]
  end
  let h be slice with token, 0, a
  let p be slice with rest, 0, b
  let parts be [h, p, more]
  return ["ok", parts]
end

define jwt_hs256_sign with payload_text, secret
  let header be "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
  let p be utf8_bytes with payload_text
  if (p at 0) != "ok"
    return ["bad", p at 1]
  end
  let body be b64url_encode with (p at 1)
  let signing be header + "." + body
  let msg be ascii_bytes with signing
  if (msg at 0) != "ok"
    return ["bad", msg at 1]
  end
  let sig be hmac_sha256 with secret, (msg at 1)
  let enc be b64url_encode with sig
  let token be signing + "." + enc
  if (length with token) > (jwt_token_cap)
    return ["bad", "token too large"]
  end
  return ["ok", token]
end

define jwt_hs256_verify with token, secret, clock
  if (length with token) > (jwt_token_cap)
    return ["bad", "token too large"]
  end
  let parts be jwt_split with token
  if (parts at 0) != "ok"
    return ["bad", parts at 1]
  end
  let segs be parts at 1
  let hb be b64url_decode with (segs at 0)
  if (hb at 0) != "ok"
    return ["bad", hb at 1]
  end
  let pb be b64url_decode with (segs at 1)
  if (pb at 0) != "ok"
    return ["bad", pb at 1]
  end
  let sb be b64url_decode with (segs at 2)
  if (sb at 0) != "ok"
    return ["bad", sb at 1]
  end
  if (length with (sb at 1)) != 32
    return ["bad", "bad signature length"]
  end
  let ht be ascii_text with (hb at 1)
  if (ht at 0) != "ok"
    return ["bad", ht at 1]
  end
  let hdr be ht at 1
  if jwt_has_crit with hdr
    return ["bad", "crit rejected"]
  end
  let alg be jwt_field_string with hdr, "alg"
  if (alg at 0) != "ok"
    return ["bad", "alg missing"]
  end
  if (alg at 1) != "HS256"
    return ["bad", "alg rejected"]
  end
  let signing be (segs at 0) + "." + (segs at 1)
  let msg be ascii_bytes with signing
  if (msg at 0) != "ok"
    return ["bad", msg at 1]
  end
  let want be hmac_sha256 with secret, (msg at 1)
  if not (ct_eq with want, (sb at 1))
    return ["bad", "bad signature"]
  end
  let pt be utf8_text with (pb at 1)
  if (pt at 0) != "ok"
    return ["bad", pt at 1]
  end
  if clock != none
    let body be pt at 1
    let exp be jwt_field_number with body, "exp"
    if (exp at 0) == "ok"
      if (exp at 1) < clock
        return ["bad", "expired"]
      end
      if (exp at 1) == clock
        return ["bad", "expired"]
      end
    end
    if (exp at 0) == "bad"
      return ["bad", "bad exp"]
    end
    let nbf be jwt_field_number with body, "nbf"
    if (nbf at 0) == "ok"
      if clock < (nbf at 1)
        return ["bad", "not yet"]
      end
    end
    if (nbf at 0) == "bad"
      return ["bad", "bad nbf"]
    end
  end
  return ["ok", pt at 1]
end

define cookie_is_ows with ch
  if ch == " "
    return true
  end
  if ch == "\t"
    return true
  end
  return false
end

define cookie_skip_ows with text, i
  let n be length with text
  while i < n
    if not (cookie_is_ows with (text at i))
      stop
    end
    let i be i + 1
  end
  return i
end

define cookie_has_inject with text
  let n be length with text
  let i be 0
  while i < n
    let ch be text at i
    if ch == "\r"
      return true
    end
    if ch == "\n"
      return true
    end
    if ch == ";"
      return true
    end
    let i be i + 1
  end
  return false
end

define cookie_strip_prefix with header
  let n be length with header
  if n < 7
    return header
  end
  let p be lower with (slice with header, 0, 7)
  if p != "cookie:"
    return header
  end
  return slice with header, 7, n
end

define cookie_line_end with ch
  if ch == "\r"
    return true
  end
  if ch == "\n"
    return true
  end
  return false
end

define cookie_parse with header
  let text be cookie_strip_prefix with header
  let n be length with text
  let i be cookie_skip_ows with text, 0
  let out be []
  let seen be {}
  while i < n
    let i be cookie_skip_ows with text, i
    if i >= n
      stop
    end
    if cookie_line_end with (text at i)
      stop
    end
    if (text at i) == ";"
      let i be i + 1
    end
    if i >= n
      stop
    end
    let i be cookie_skip_ows with text, i
    if i >= n
      stop
    end
    if cookie_line_end with (text at i)
      stop
    end
    let start be i
    while i < n
      let ch be text at i
      if ch == "="
        stop
      end
      if ch == ";"
        stop
      end
      if cookie_line_end with ch
        stop
      end
      let i be i + 1
    end
    let name be slice with text, start, i
    let name be slice with name, 0, (length with name)
    let j be (length with name) - 1
    while j >= 0
      if not (cookie_is_ows with (name at j))
        stop
      end
      let j be j - 1
    end
    let name be slice with name, 0, (j + 1)
    if i < n
      if (text at i) == "="
        let i be i + 1
      end
    end
    let vs be i
    while i < n
      if (text at i) == ";"
        stop
      end
      if cookie_line_end with (text at i)
        stop
      end
      let i be i + 1
    end
    let val be slice with text, vs, i
    let val be slice with val, (cookie_skip_ows with val, 0), (length with val)
    let k be (length with val) - 1
    while k >= 0
      if not (cookie_is_ows with (val at k))
        stop
      end
      let k be k - 1
    end
    let val be slice with val, 0, (k + 1)
    if (length with name) > 0
      if not (has with seen, name)
        put 1 into seen at name
        push with out, [name, val]
      end
    end
    if i < n
      if (text at i) == ";"
        let i be i + 1
      end
    end
  end
  return out
end

define cookie_set with name, value, path, httponly, secure, samesite, max_age
  if cookie_has_inject with name
    return ["bad", "injected name"]
  end
  if cookie_has_inject with value
    return ["bad", "injected value"]
  end
  if (length with name) == 0
    return ["bad", "empty name"]
  end
  let out be name + "=" + value
  if path != none
    if cookie_has_inject with path
      return ["bad", "injected path"]
    end
    let out be out + "; Path=" + path
  end
  if httponly
    let out be out + "; HttpOnly"
  end
  if secure
    let out be out + "; Secure"
  end
  if samesite != none
    if cookie_has_inject with samesite
      return ["bad", "injected samesite"]
    end
    let out be out + "; SameSite=" + samesite
  end
  if max_age != none
    let out be out + "; Max-Age=" + (text with max_age)
  end
  return ["ok", out]
end

~ PBKDF2-HMAC-SHA256 (RFC 8018) on builtin hmac. FCG password KDF for
~ cpa-go / api-go / dev-portal-go login after HMAC/JWT/cookie primitives.
~ Comparison walks every DK byte (not a CPU timing barrier).

define xor8_bit with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  let x be idiv with x, 2
  let y be idiv with y, 2
  let p be p + p
  let xb be x % 2
  let yb be y % 2
  if xb != yb
    let r be r + p
  end
  return r
end

define make_xor_tab
  let tab be []
  let a be 0
  while a < 256
    let b be 0
    while b < 256
      push with tab, (xor8_bit with a, b)
      let b be b + 1
    end
    let a be a + 1
  end
  return tab
end

define xor8 with tab, a, b
  return tab at ((shl8 with a) + b)
end

define xor32_into with tab, dst, src
  put (xor8 with tab, (dst at 0), (src at 0)) into dst at 0
  put (xor8 with tab, (dst at 1), (src at 1)) into dst at 1
  put (xor8 with tab, (dst at 2), (src at 2)) into dst at 2
  put (xor8 with tab, (dst at 3), (src at 3)) into dst at 3
  put (xor8 with tab, (dst at 4), (src at 4)) into dst at 4
  put (xor8 with tab, (dst at 5), (src at 5)) into dst at 5
  put (xor8 with tab, (dst at 6), (src at 6)) into dst at 6
  put (xor8 with tab, (dst at 7), (src at 7)) into dst at 7
  put (xor8 with tab, (dst at 8), (src at 8)) into dst at 8
  put (xor8 with tab, (dst at 9), (src at 9)) into dst at 9
  put (xor8 with tab, (dst at 10), (src at 10)) into dst at 10
  put (xor8 with tab, (dst at 11), (src at 11)) into dst at 11
  put (xor8 with tab, (dst at 12), (src at 12)) into dst at 12
  put (xor8 with tab, (dst at 13), (src at 13)) into dst at 13
  put (xor8 with tab, (dst at 14), (src at 14)) into dst at 14
  put (xor8 with tab, (dst at 15), (src at 15)) into dst at 15
  put (xor8 with tab, (dst at 16), (src at 16)) into dst at 16
  put (xor8 with tab, (dst at 17), (src at 17)) into dst at 17
  put (xor8 with tab, (dst at 18), (src at 18)) into dst at 18
  put (xor8 with tab, (dst at 19), (src at 19)) into dst at 19
  put (xor8 with tab, (dst at 20), (src at 20)) into dst at 20
  put (xor8 with tab, (dst at 21), (src at 21)) into dst at 21
  put (xor8 with tab, (dst at 22), (src at 22)) into dst at 22
  put (xor8 with tab, (dst at 23), (src at 23)) into dst at 23
  put (xor8 with tab, (dst at 24), (src at 24)) into dst at 24
  put (xor8 with tab, (dst at 25), (src at 25)) into dst at 25
  put (xor8 with tab, (dst at 26), (src at 26)) into dst at 26
  put (xor8 with tab, (dst at 27), (src at 27)) into dst at 27
  put (xor8 with tab, (dst at 28), (src at 28)) into dst at 28
  put (xor8 with tab, (dst at 29), (src at 29)) into dst at 29
  put (xor8 with tab, (dst at 30), (src at 30)) into dst at 30
  put (xor8 with tab, (dst at 31), (src at 31)) into dst at 31
end

define pbkdf2_be32 with n
  let b3 be n % 256
  let n be idiv with n, 256
  let b2 be n % 256
  let n be idiv with n, 256
  let b1 be n % 256
  let n be idiv with n, 256
  let b0 be n % 256
  return [b0, b1, b2, b3]
end

define pbkdf2_block with tab, pw, salt, rounds, idx
  let msg be cat_bytes with salt, (pbkdf2_be32 with idx)
  let u be hmac with pw, msg
  let t be copy_bytes with u
  let j be 1
  while j < rounds
    let u be hmac with pw, u
    xor32_into with tab, t, u
    let j be j + 1
  end
  return t
end

define pbkdf2_sha256_tab with tab, pw, salt, rounds, dklen
  if rounds < 1
    return ["bad", "pbkdf2 rounds"]
  end
  if dklen < 1
    return ["bad", "pbkdf2 dklen"]
  end
  if dklen > 1024
    return ["bad", "pbkdf2 dklen"]
  end
  let out be []
  let block be 1
  while (length with out) < dklen
    let t be pbkdf2_block with tab, pw, salt, rounds, block
    let i be 0
    let n be length with t
    while i < n
      if (length with out) < dklen
        push with out, (t at i)
      end
      let i be i + 1
    end
    let block be block + 1
  end
  return ["ok", out]
end

define pbkdf2_sha256 with pw, salt, rounds, dklen
  return pbkdf2_sha256_tab with (make_xor_tab), pw, salt, rounds, dklen
end

define pbkdf2_sha256_hex_tab with tab, pw, salt, rounds, dklen
  let got be pbkdf2_sha256_tab with tab, pw, salt, rounds, dklen
  if (got at 0) != "ok"
    return got
  end
  return ["ok", (hex with (got at 1))]
end

define pbkdf2_sha256_verify_tab with tab, pw, salt, rounds, want
  let got be pbkdf2_sha256_tab with tab, pw, salt, rounds, (length with want)
  if (got at 0) != "ok"
    return false
  end
  return ct_eq with (got at 1), want
end

~ FCG login DK: 32-byte PBKDF2-HMAC-SHA256. RFC 7914 c=80000 fits the 5M step
~ cap after unrolling the 32-byte XOR (the 1M while-pass cap is unchanged).
define fcg_password_dk_tab with tab, pw, salt, rounds
  return pbkdf2_sha256_tab with tab, pw, salt, rounds, 32
end

define fcg_password_verify_tab with tab, pw, salt, rounds, want
  return pbkdf2_sha256_verify_tab with tab, pw, salt, rounds, want
end
