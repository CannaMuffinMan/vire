define cryptoCopy32 with w
  return [w at 0, w at 1]
end

define cryptoWord with hi, lo
  return [hi, lo]
end

define cryptoAnd16 with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let i be 0
  while i < 16
    let xb be x % 2
    let yb be y % 2
    if (xb == 1) and (yb == 1)
      let r be r + p
    end
    let x be idiv with x, 2
    let y be idiv with y, 2
    let p be p + p
    let i be i + 1
  end
  return r
end

define cryptoXor16 with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let i be 0
  while i < 16
    let xb be x % 2
    let yb be y % 2
    if xb != yb
      let r be r + p
    end
    let x be idiv with x, 2
    let y be idiv with y, 2
    let p be p + p
    let i be i + 1
  end
  return r
end

define cryptoNot16 with a
  return 65535 - a
end

define cryptoAnd32 with a, b
  return [(cryptoAnd16 with (a at 0), (b at 0)), (cryptoAnd16 with (a at 1), (b at 1))]
end

define cryptoXor32 with a, b
  return [(cryptoXor16 with (a at 0), (b at 0)), (cryptoXor16 with (a at 1), (b at 1))]
end

define cryptoNot32 with a
  return [(cryptoNot16 with (a at 0)), (cryptoNot16 with (a at 1))]
end

define cryptoAdd32 with a, b
  let lo be (a at 1) + (b at 1)
  let c be 0
  if lo >= 65536
    let lo be lo - 65536
    let c be 1
  end
  let hi be (a at 0) + (b at 0) + c
  if hi >= 65536
    let hi be hi - 65536
  end
  return [hi, lo]
end

define cryptoShr1 with w
  let hi be w at 0
  let lo be w at 1
  let lo2 be idiv with lo, 2
  if (hi % 2) == 1
    let lo2 be lo2 + 32768
  end
  return [(idiv with hi, 2), lo2]
end

define cryptoShl1 with w
  let hi be w at 0
  let lo be w at 1
  let hi2 be hi + hi
  if hi2 >= 65536
    let hi2 be hi2 - 65536
  end
  if lo >= 32768
    let hi2 be hi2 + 1
    if hi2 >= 65536
      let hi2 be hi2 - 65536
    end
  end
  let lo2 be lo + lo
  if lo2 >= 65536
    let lo2 be lo2 - 65536
  end
  return [hi2, lo2]
end

define cryptoShr32 with w, n
  let v be cryptoCopy32 with w
  let i be 0
  while i < n
    let v be cryptoShr1 with v
    let i be i + 1
  end
  return v
end

define cryptoShl32 with w, n
  let v be cryptoCopy32 with w
  let i be 0
  while i < n
    let v be cryptoShl1 with v
    let i be i + 1
  end
  return v
end

define cryptoRotr32 with w, n
  return cryptoXor32 with (cryptoShr32 with w, n), (cryptoShl32 with w, (32 - n))
end

define cryptoCh with e, f, g
  return cryptoXor32 with (cryptoAnd32 with e, f), (cryptoAnd32 with (cryptoNot32 with e), g)
end

define cryptoMaj with a, b, c
  let t be cryptoXor32 with (cryptoAnd32 with a, b), (cryptoAnd32 with a, c)
  return cryptoXor32 with t, (cryptoAnd32 with b, c)
end

define cryptoBs0 with a
  let t be cryptoXor32 with (cryptoRotr32 with a, 2), (cryptoRotr32 with a, 13)
  return cryptoXor32 with t, (cryptoRotr32 with a, 22)
end

define cryptoBs1 with e
  let t be cryptoXor32 with (cryptoRotr32 with e, 6), (cryptoRotr32 with e, 11)
  return cryptoXor32 with t, (cryptoRotr32 with e, 25)
end

define cryptoSs0 with w
  let t be cryptoXor32 with (cryptoRotr32 with w, 7), (cryptoRotr32 with w, 18)
  return cryptoXor32 with t, (cryptoShr32 with w, 3)
end

define cryptoSs1 with w
  let t be cryptoXor32 with (cryptoRotr32 with w, 17), (cryptoRotr32 with w, 19)
  return cryptoXor32 with t, (cryptoShr32 with w, 10)
end

