define cryptoCopy32_into with dst, src
  put (src at 0) into dst at 0
  put (src at 1) into dst at 1
  return dst
end

define cryptoWord with hi, lo
  return [hi, lo]
end

define times2 with n
  return n + n
end

define times4 with n
  let v be n + n
  return v + v
end

define times8 with n
  let v be n + n
  let v be v + v
  return v + v
end

define times256 with n
  let v be times8 with n
  let v be times8 with v
  return times4 with v
end

define cryptoAnd16 with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let i be 0
  while i < 16
    let xb be x % 2
    let yb be y % 2
    if (xb == 1) and (yb == 1)
      let r be r + p
    end
    let x be idiv with x, 2
    let y be idiv with y, 2
    let p be p + p
    let i be i + 1
  end
  return r
end

define cryptoXor16 with a, b
  let r be 0
  let p be 1
  let x be a
  let y be b
  let i be 0
  while i < 16
    let xb be x % 2
    let yb be y % 2
    if xb != yb
      let r be r + p
    end
    let x be idiv with x, 2
    let y be idiv with y, 2
    let p be p + p
    let i be i + 1
  end
  return r
end

define cryptoNot16 with a
  return 65535 - a
end

define cryptoAnd32_into with dst, a, b
  let hi be cryptoAnd16 with a at 0, b at 0
  let lo be cryptoAnd16 with a at 1, b at 1
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define cryptoXor32_into with dst, a, b
  let hi be cryptoXor16 with a at 0, b at 0
  let lo be cryptoXor16 with a at 1, b at 1
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define cryptoNot32_into with dst, a
  let hi be cryptoNot16 with a at 0
  let lo be cryptoNot16 with a at 1
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define cryptoAdd32_into with dst, a, b
  let lo be (a at 1) + (b at 1)
  let c be 0
  if lo >= 65536
    let lo be lo - 65536
    let c be 1
  end
  let hi be (a at 0) + (b at 0) + c
  if hi >= 65536
    let hi be hi - 65536
  end
  put hi into dst at 0
  put lo into dst at 1
  return dst
end

define cryptoShr1_into with w
  let hi be w at 0
  let lo be w at 1
  let lo2 be idiv with lo, 2
  if (hi % 2) == 1
    let lo2 be lo2 + 32768
  end
  put (idiv with hi, 2) into w at 0
  put lo2 into w at 1
  return w
end

define cryptoShl1_into with w
  let hi be w at 0
  let lo be w at 1
  let hi2 be hi + hi
  if hi2 >= 65536
    let hi2 be hi2 - 65536
  end
  if lo >= 32768
    let hi2 be hi2 + 1
    if hi2 >= 65536
      let hi2 be hi2 - 65536
    end
  end
  let lo2 be lo + lo
  if lo2 >= 65536
    let lo2 be lo2 - 65536
  end
  put hi2 into w at 0
  put lo2 into w at 1
  return w
end

define cryptoShr32_into with w, n
  let i be 0
  while i < n
    cryptoShr1_into with w
    let i be i + 1
  end
  return w
end

define cryptoShl32_into with w, n
  let i be 0
  while i < n
    cryptoShl1_into with w
    let i be i + 1
  end
  return w
end

define cryptoRotr32_into with dst, src, n, tmp
  cryptoCopy32_into with dst, src
  cryptoCopy32_into with tmp, src
  cryptoShr32_into with dst, n
  let sh be 32 - n
  cryptoShl32_into with tmp, sh
  cryptoXor32_into with dst, dst, tmp
  return dst
end

define cryptoCh_into with dst, e, f, g, tmp
  cryptoAnd32_into with dst, e, f
  cryptoNot32_into with tmp, e
  cryptoAnd32_into with tmp, tmp, g
  cryptoXor32_into with dst, dst, tmp
  return dst
end

define cryptoMaj_into with dst, a, b, c, tmp
  cryptoAnd32_into with dst, a, b
  cryptoAnd32_into with tmp, a, c
  cryptoXor32_into with dst, dst, tmp
  cryptoAnd32_into with tmp, b, c
  cryptoXor32_into with dst, dst, tmp
  return dst
end

define cryptoBs0_into with dst, a, tmp, tmp2
  cryptoRotr32_into with dst, a, 2, tmp
  cryptoRotr32_into with tmp2, a, 13, tmp
  cryptoXor32_into with dst, dst, tmp2
  cryptoRotr32_into with tmp2, a, 22, tmp
  cryptoXor32_into with dst, dst, tmp2
  return dst
end

define cryptoBs1_into with dst, e, tmp, tmp2
  cryptoRotr32_into with dst, e, 6, tmp
  cryptoRotr32_into with tmp2, e, 11, tmp
  cryptoXor32_into with dst, dst, tmp2
  cryptoRotr32_into with tmp2, e, 25, tmp
  cryptoXor32_into with dst, dst, tmp2
  return dst
end

define cryptoSs0_into with dst, w, tmp, tmp2
  cryptoRotr32_into with dst, w, 7, tmp
  cryptoRotr32_into with tmp2, w, 18, tmp
  cryptoXor32_into with dst, dst, tmp2
  cryptoCopy32_into with tmp2, w
  cryptoShr32_into with tmp2, 3
  cryptoXor32_into with dst, dst, tmp2
  return dst
end

define cryptoSs1_into with dst, w, tmp, tmp2
  cryptoRotr32_into with dst, w, 17, tmp
  cryptoRotr32_into with tmp2, w, 19, tmp
  cryptoXor32_into with dst, dst, tmp2
  cryptoCopy32_into with tmp2, w
  cryptoShr32_into with tmp2, 10
  cryptoXor32_into with dst, dst, tmp2
  return dst
end

