define cryptoIv
  let hs be []
  push with hs, (cryptoWord with 27145, 58983)
  push with hs, (cryptoWord with 47975, 44677)
  push with hs, (cryptoWord with 15470, 62322)
  push with hs, (cryptoWord with 42319, 62778)
  push with hs, (cryptoWord with 20750, 21119)
  push with hs, (cryptoWord with 39685, 26764)
  push with hs, (cryptoWord with 8067, 55723)
  push with hs, (cryptoWord with 23520, 52505)
  return hs
end

define cryptoLoadWord with bytes, off
  let b0 be bytes at off
  let b1 be bytes at (off + 1)
  let b2 be bytes at (off + 2)
  let b3 be bytes at (off + 3)
  return [(b0 * 256) + b1, (b2 * 256) + b3]
end

define cryptoStoreWord with out, w
  let hi be w at 0
  let lo be w at 1
  push with out, (idiv with hi, 256)
  push with out, (hi % 256)
  push with out, (idiv with lo, 256)
  push with out, (lo % 256)
  return out
end

define cryptoCompress with state, block, ks
  let w be []
  let i be 0
  while i < 16
    push with w, (cryptoLoadWord with block, (i * 4))
    let i be i + 1
  end
  while i < 64
    let s0 be cryptoSs0 with (w at (i - 15))
    let s1 be cryptoSs1 with (w at (i - 2))
    let t be cryptoAdd32 with (w at (i - 16)), s0
    let t be cryptoAdd32 with t, (w at (i - 7))
    push with w, (cryptoAdd32 with t, s1)
    let i be i + 1
  end
  let a be cryptoCopy32 with (state at 0)
  let b be cryptoCopy32 with (state at 1)
  let c be cryptoCopy32 with (state at 2)
  let d be cryptoCopy32 with (state at 3)
  let e be cryptoCopy32 with (state at 4)
  let f be cryptoCopy32 with (state at 5)
  let g be cryptoCopy32 with (state at 6)
  let h be cryptoCopy32 with (state at 7)
  let r be 0
  while r < 64
    let t1 be cryptoAdd32 with h, (cryptoBs1 with e)
    let t1 be cryptoAdd32 with t1, (cryptoCh with e, f, g)
    let t1 be cryptoAdd32 with t1, (ks at r)
    let t1 be cryptoAdd32 with t1, (w at r)
    let t2 be cryptoAdd32 with (cryptoBs0 with a), (cryptoMaj with a, b, c)
    let h be g
    let g be f
    let f be e
    let e be cryptoAdd32 with d, t1
    let d be c
    let c be b
    let b be a
    let a be cryptoAdd32 with t1, t2
    let r be r + 1
  end
  put (cryptoAdd32 with (state at 0), a) into state at 0
  put (cryptoAdd32 with (state at 1), b) into state at 1
  put (cryptoAdd32 with (state at 2), c) into state at 2
  put (cryptoAdd32 with (state at 3), d) into state at 3
  put (cryptoAdd32 with (state at 4), e) into state at 4
  put (cryptoAdd32 with (state at 5), f) into state at 5
  put (cryptoAdd32 with (state at 6), g) into state at 6
  put (cryptoAdd32 with (state at 7), h) into state at 7
  return state
end

define cryptoPad with bytes
  let n be length with bytes
  let out be bytes + []
  push with out, 128
  while ((length with out) % 64) != 56
    push with out, 0
  end
  let bits be n * 8
  push with out, 0
  push with out, 0
  push with out, 0
  push with out, 0
  push with out, (idiv with bits, 16777216)
  let bits be bits % 16777216
  push with out, (idiv with bits, 65536)
  let bits be bits % 65536
  push with out, (idiv with bits, 256)
  push with out, (bits % 256)
  return out
end

define sha256_bytes with bytes
  let ks be cryptoK
  let state be cryptoIv
  let padded be cryptoPad with bytes
  let i be 0
  let n be length with padded
  while i < n
    let block be slice with padded, i, (i + 64)
    let state be cryptoCompress with state, block, ks
    let i be i + 64
  end
  let out be []
  let j be 0
  while j < 8
    let out be cryptoStoreWord with out, (state at j)
    let j be j + 1
  end
  return out
end

define sha256_hex with bytes
  return hex with (sha256_bytes with bytes)
end

define ascii_table
  return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
end

define ascii_code with ch
  if ch == "\n"
    return 10
  end
  if ch == "\r"
    return 13
  end
  if ch == "\t"
    return 9
  end
  let p be find with (ascii_table), ch
  if p < 0
    return -1
  end
  return p + 32
end

define ascii_bytes with text
  let out be []
  let i be 0
  let n be length with text
  while i < n
    let c be ascii_code with (text at i)
    if c < 0
      return ["bad", "non-ascii"]
    end
    push with out, c
    let i be i + 1
  end
  return ["ok", out]
end

define ascii_text with bytes
  let table be ascii_table
  let out be ""
  let i be 0
  let n be length with bytes
  while i < n
    let b be bytes at i
    if b == 10
      let out be out + "\n"
    else if b == 13
      let out be out + "\r"
    else if b == 9
      let out be out + "\t"
    else if (b < 32) or (b > 126)
      return ["bad", "non-ascii"]
    else
      let out be out + (table at (b - 32))
    end
    let i be i + 1
  end
  return ["ok", out]
end

define hex_digit with ch
  if ch == "0"
    return 0
  end
  if ch == "1"
    return 1
  end
  if ch == "2"
    return 2
  end
  if ch == "3"
    return 3
  end
  if ch == "4"
    return 4
  end
  if ch == "5"
    return 5
  end
  if ch == "6"
    return 6
  end
  if ch == "7"
    return 7
  end
  if ch == "8"
    return 8
  end
  if ch == "9"
    return 9
  end
  if (ch == "a") or (ch == "A")
    return 10
  end
  if (ch == "b") or (ch == "B")
    return 11
  end
  if (ch == "c") or (ch == "C")
    return 12
  end
  if (ch == "d") or (ch == "D")
    return 13
  end
  if (ch == "e") or (ch == "E")
    return 14
  end
  if (ch == "f") or (ch == "F")
    return 15
  end
  return 0 - 1
end

define times16 with n
  let v be n + n
  let v be v + v
  let v be v + v
  let v be v + v
  return v
end

define hex_to_bytes with raw
  let n be length with raw
  if (n % 2) != 0
    return ["bad", "odd hex"]
  end
  let out be []
  let i be 0
  while i < n
    let hi be hex_digit with (raw at i)
    let lo be hex_digit with (raw at (i + 1))
    if (hi < 0) or (lo < 0)
      return ["bad", "bad hex"]
    end
    push with out, ((times16 with hi) + lo)
    let i be i + 2
  end
  return ["ok", out]
end

define hmac_sha256 with key, msg
  let k be key + []
  if (length with k) > 64
    let k be sha256_bytes with k
  end
  while (length with k) < 64
    push with k, 0
  end
  let ip be []
  let op be []
  let i be 0
  while i < 64
    let b be k at i
    push with ip, (cryptoXor16 with b, 54)
    push with op, (cryptoXor16 with b, 92)
    let i be i + 1
  end
  let inner be sha256_bytes with (ip + msg)
  return sha256_bytes with (op + inner)
end

define hmac_sha256_hex with key, msg
  return hex with (hmac_sha256 with key, msg)
end

define b64url_table
  return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
end

define b64url_encode with bytes
  let table be b64url_table
  let out be ""
  let n be length with bytes
  let i be 0
  while i < n
    let b0 be bytes at i
    let b1 be 0
    let b2 be 0
    let got be 1
    if (i + 1) < n
      let b1 be bytes at (i + 1)
      let got be 2
    end
    if (i + 2) < n
      let b2 be bytes at (i + 2)
      let got be 3
    end
    let n0 be idiv with b0, 4
    let n1 be ((b0 % 4) * 16) + (idiv with b1, 16)
    let n2 be ((b1 % 16) * 4) + (idiv with b2, 64)
    let n3 be b2 % 64
    let out be out + (table at n0)
    let out be out + (table at n1)
    if got > 1
      let out be out + (table at n2)
    end
    if got > 2
      let out be out + (table at n3)
    end
    let i be i + 3
  end
  return out
end

define b64url_val with ch
  return find with (b64url_table), ch
end

define b64url_decode with text
  let n be length with text
  if n == 0
    return ["ok", []]
  end
  if (n % 4) == 1
    return ["bad", "bad b64url length"]
  end
  let i be 0
  while i < n
    if (b64url_val with (text at i)) < 0
      return ["bad", "bad b64url char"]
    end
    let i be i + 1
  end
  let out be []
  let i be 0
  while i < n
    let c0 be b64url_val with (text at i)
    let c1 be b64url_val with (text at (i + 1))
    let left be n - i
    let n2 be 0
    let n3 be 0
    if left > 2
      let n2 be b64url_val with (text at (i + 2))
    end
    if left > 3
      let n3 be b64url_val with (text at (i + 3))
    end
    push with out, ((c0 * 4) + (idiv with c1, 16))
    if left > 2
      push with out, (((c1 % 16) * 16) + (idiv with n2, 4))
    end
    if left > 3
      push with out, (((n2 % 4) * 64) + n3)
    end
    let i be i + 4
  end
  return ["ok", out]
end

define ct_eq with left, right
  let n be length with left
  let m be length with right
  let d be 0
  if n != m
    let d be 1
  end
  let lim be n
  if m > lim
    let lim be m
  end
  let i be 0
  while i < lim
    let a be 0
    let b be 0
    if i < n
      let a be left at i
    end
    if i < m
      let b be right at i
    end
    if a != b
      let d be 1
    end
    let i be i + 1
  end
  if d == 0
    return true
  end
  return false
end

define jwt_token_cap
  return 8192
end

define jwt_skip_space with text, i
  let n be length with text
  while i < n
    let ch be text at i
    if (ch == " ") or (ch == "\t") or (ch == "\n") or (ch == "\r")
      let i be i + 1
      skip
    end
    stop
  end
  return i
end

define jwt_field_string with text, key
  let needle be "\"" + key + "\""
  let found be find with text, needle
  if found < 0
    return ["miss", ""]
  end
  let i be jwt_skip_space with text, (found + (length with needle))
  if i >= (length with text)
    return ["bad", "truncated json"]
  end
  if (text at i) != ":"
    return ["bad", "bad json"]
  end
  let i be jwt_skip_space with text, (i + 1)
  if i >= (length with text)
    return ["bad", "truncated json"]
  end
  if (text at i) != "\""
    return ["bad", "alg not a string"]
  end
  let i be i + 1
  let out be ""
  let n be length with text
  while i < n
    let ch be text at i
    if ch == "\""
      return ["ok", out]
    end
    let out be out + ch
    let i be i + 1
  end
  return ["bad", "truncated json"]
end

define jwt_field_number with text, key
  let needle be "\"" + key + "\""
  let found be find with text, needle
  if found < 0
    return ["miss", 0]
  end
  let i be jwt_skip_space with text, (found + (length with needle))
  if i >= (length with text)
    return ["bad", 0]
  end
  if (text at i) != ":"
    return ["bad", 0]
  end
  let i be jwt_skip_space with text, (i + 1)
  let n be length with text
  if i >= n
    return ["bad", 0]
  end
  let sign be 1
  if (text at i) == "-"
    let sign be 0 - 1
    let i be i + 1
  end
  if i >= n
    return ["bad", 0]
  end
  let raw be ""
  while i < n
    let ch be text at i
    if (find with "0123456789", ch) >= 0
      let raw be raw + ch
      let i be i + 1
      skip
    end
    stop
  end
  if (length with raw) == 0
    return ["bad", 0]
  end
  return ["ok", (sign * (number with raw))]
end

define jwt_split with token
  let a be find with token, "."
  if a < 0
    return ["bad", "missing segment"]
  end
  let rest be slice with token, (a + 1), (length with token)
  let b be find with rest, "."
  if b < 0
    return ["bad", "missing segment"]
  end
  let more be slice with rest, (b + 1), (length with rest)
  if (find with more, ".") >= 0
    return ["bad", "extra segment"]
  end
  if (length with more) == 0
    return ["bad", "missing segment"]
  end
  if a == 0
    return ["bad", "missing segment"]
  end
  if b == 0
    return ["bad", "missing segment"]
  end
  return ["ok", [(slice with token, 0, a), (slice with rest, 0, b), more]]
end

define jwt_hs256_sign with payload_text, secret
  let header be "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9"
  let p be ascii_bytes with payload_text
  if (p at 0) != "ok"
    return ["bad", p at 1]
  end
  let body be b64url_encode with (p at 1)
  let msg be ascii_bytes with (header + "." + body)
  if (msg at 0) != "ok"
    return ["bad", msg at 1]
  end
  let sig be hmac_sha256 with secret, (msg at 1)
  let token be header + "." + body + "." + (b64url_encode with sig)
  if (length with token) > (jwt_token_cap)
    return ["bad", "token too large"]
  end
  return ["ok", token]
end

define jwt_hs256_verify with token, secret, clock
  if (length with token) > (jwt_token_cap)
    return ["bad", "token too large"]
  end
  let parts be jwt_split with token
  if (parts at 0) != "ok"
    return ["bad", parts at 1]
  end
  let segs be parts at 1
  let hb be b64url_decode with (segs at 0)
  if (hb at 0) != "ok"
    return ["bad", hb at 1]
  end
  let pb be b64url_decode with (segs at 1)
  if (pb at 0) != "ok"
    return ["bad", pb at 1]
  end
  let sb be b64url_decode with (segs at 2)
  if (sb at 0) != "ok"
    return ["bad", sb at 1]
  end
  if (length with (sb at 1)) != 32
    return ["bad", "bad signature length"]
  end
  let ht be ascii_text with (hb at 1)
  if (ht at 0) != "ok"
    return ["bad", ht at 1]
  end
  let alg be jwt_field_string with (ht at 1), "alg"
  if (alg at 0) != "ok"
    return ["bad", "alg missing"]
  end
  if (alg at 1) != "HS256"
    return ["bad", "alg rejected"]
  end
  let msg be ascii_bytes with ((segs at 0) + "." + (segs at 1))
  if (msg at 0) != "ok"
    return ["bad", msg at 1]
  end
  let want be hmac_sha256 with secret, (msg at 1)
  if not (ct_eq with want, (sb at 1))
    return ["bad", "bad signature"]
  end
  let pt be ascii_text with (pb at 1)
  if (pt at 0) != "ok"
    return ["bad", pt at 1]
  end
  if clock != none
    let exp be jwt_field_number with (pt at 1), "exp"
    if (exp at 0) == "ok"
      if (exp at 1) < clock
        return ["bad", "expired"]
      end
    end
    if (exp at 0) == "bad"
      return ["bad", "bad exp"]
    end
  end
  return ["ok", pt at 1]
end
