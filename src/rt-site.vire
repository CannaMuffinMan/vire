~ Native static files from declared root site/.
~ Packed fn_route is remapped to rt_site_gate when the fix is first
~ pushed (applyPackedFixes hook). No later mutation of the fixes list
~ (native put-at-i hung gen2 or diverged hex). Leaf-tag ctx/buf, jmp cl_hdr.

define emitClientLeaf with image, fixes, labels
  pin with labels, "rt_net_client", image
  emitPro with image
  emitList with image, [72, 137, 77, 240, 185]
  emitU32 with image, 128
  emitCallTo with image, fixes, "rt_alloc"
  emitLeaf with image
  emitList with image, [72, 133, 192, 15, 132]
  emitRel with image, fixes, "ncli_fail"
  emitList with image, [72, 137, 69, 248, 72, 139, 85, 240, 72, 137, 16]
  let image be emitIat with image, fixes, "iat_gt"
  emitList with image, [72, 139, 77, 248, 137, 65, 32, 185]
  emitU32 with image, 82048
  emitCallTo with image, fixes, "rt_alloc"
  emitLeaf with image
  emitList with image, [72, 133, 192, 15, 132]
  emitRel with image, fixes, "ncli_fail"
  emitList with image, [72, 139, 77, 248, 72, 137, 65, 8, 72, 199, 65, 16, 0, 0, 0, 0]
  emitJmpTo with image, fixes, "cl_hdr"
  pin with labels, "ncli_fail", image
  emitEpi with image
  return image
end

define emitSiteRuntime with image, fixes, labels
  let image be emitClientLeaf with image, fixes, labels
  parkMsg with image, labels, "txt_site_pre", "HTTP/1.1 "
  parkMsg with image, labels, "txt_site_okph", "200 OK"
  parkMsg with image, labels, "txt_site_nfph", "404 Not Found"
  parkMsg with image, labels, "txt_site_moph", "405 Method Not Allowed"
  parkMsg with image, labels, "txt_site_ct", "\r\nContent-Type: "
  parkMsg with image, labels, "txt_site_cl", "\r\nContent-Length: "
  parkMsg with image, labels, "txt_site_rest", "\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\nContent-Security-Policy: default-src 'self'\r\nCache-Control: public, max-age=60\r\nETag: "
  parkMsg with image, labels, "txt_site_end", "\r\n\r\n"
  pin with labels, "txt_site_quot", image
  emitU64 with image, 1
  emitList with image, [34, 0]
  parkMsg with image, labels, "txt_site_html", "text/html; charset=utf-8"
  parkMsg with image, labels, "txt_site_css", "text/css; charset=utf-8"
