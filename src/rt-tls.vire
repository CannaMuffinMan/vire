define emitTlsPeGuest with image, fixes, labels
  ~ Packed SChannel emit (tools/pack-tls-pe.py from src/rt-tls-pe.vire) so gen1
  ~ stays under the compiler list cap. Regen blobs after editing rt-tls-pe.vire.
  let base be length with image
  let names be tlsPeNames
  let image be emitHex with image, (read with "data/src/rt-tls-pe-blob.txt")
  applyPackedPins with labels, base, (read with "data/src/rt-tls-pe-pins.txt"), names
  applyPackedFixes with fixes, base, (read with "data/src/rt-tls-pe-fixes.txt"), names
  return image
end

define emitTlsRuntime with image, fixes, labels, elf
  if elf
    let image be emitTlsGuest with image, fixes, labels
    return image
  end
  let image be emitTlsPeGuest with image, fixes, labels
  return image
end

define parkTls with image, labels
  parkMsg with image, labels, "msg_tls_args", "tls_connect needs a host, a port, a name, and a ca file"
  parkMsg with image, labels, "msg_tls_wrap", "tls_wrap needs a connection, a name, a ca file, and a host check"
  parkMsg with image, labels, "msg_tls_hs", "tls handshake failed"
  parkMsg with image, labels, "msg_tls_send", "tls_send needs a connection and text"
  parkMsg with image, labels, "msg_tls_recv", "tls_recv needs a connection and a size"
  parkMsg with image, labels, "msg_tls_listen", "tls_listen needs a certificate file and a key file"
  parkMsg with image, labels, "msg_tls_cert", "could not load that tls certificate"
  parkMsg with image, labels, "msg_tls_ver", "openssl must be 3.0 or newer"
  parkMsg with image, labels, "msg_tls_peer", "tls_peer_cert needs a tls connection"
  pin with labels, "txt_unisp", image
  let image be emitStr with image, "Microsoft Unified Security Protocol Provider"
  let image be alignTo with image, 8
  pin with labels, "tls_ctx", image
  let image be emitU64 with image, 0
  pin with labels, "tls_ssl", image
  let image be emitU64 with image, 0
  pin with labels, "tls_peerctx", image
  let image be emitU64 with image, 0
  pin with labels, "tls_fd", image
  let image be emitU64 with image, 0
  pin with labels, "tls_captr", image
  let image be emitU64 with image, 0
  pin with labels, "tls_checkhost", image
  let image be emitU64 with image, 0
  pin with labels, "tls_got_head", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let names be tlsGotNames
  let i be 0
  while i < (length with names)
    pin with labels, (names at i), image
    let image be emitU64 with image, 0
    let i be i + 1
  end
  pin with labels, "tls_cred", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  pin with labels, "tls_ctxt", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  pin with labels, "tls_sch", image
  let image be emitU32 with image, 0
  pin with labels, "tls_sch4", image
  let image be emitU32 with image, 0
  pin with labels, "tls_sch8", image
  let image be emitU64 with image, 0
  pin with labels, "tls_sch16", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  pin with labels, "tls_sch56", image
  let image be emitU32 with image, 0
  let image be emitU32 with image, 0
  let image be emitU32 with image, 0
  let image be emitU32 with image, 0
  pin with labels, "tls_sch72", image
  let image be emitU32 with image, 0
  let image be emitU32 with image, 0
  pin with labels, "tls_attr", image
  let image be emitU64 with image, 0
  pin with labels, "tls_expiry", image
  let image be emitU64 with image, 0
  pin with labels, "tls_store", image
  let image be emitU64 with image, 0
  pin with labels, "tls_cert", image
  let image be emitU64 with image, 0
  pin with labels, "tls_pacred", image
  let image be emitU64 with image, 0
  pin with labels, "tls_keyptr", image
  let image be emitU64 with image, 0
  pin with labels, "tls_nameptr", image
  let image be emitU64 with image, 0
  pin with labels, "tls_fileptr", image
  let image be emitU64 with image, 0
  pin with labels, "tls_filesz", image
  let image be emitU64 with image, 0
  pin with labels, "tls_dersz", image
  let image be emitU64 with image, 0
