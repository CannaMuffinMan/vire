  emitList with image, [72, 139, 125, 224]
  emitList with image, [72, 131, 199, 8]
  emitList with image, [139, 13]
  emitRel with image, fixes, "tls_inbuf"
  emitList with image, [72, 137, 214, 252, 243, 164]
  emitList with image, [72, 139, 85, 224]
  emitList with image, [139, 13]
  emitRel with image, fixes, "tls_inbuf"
  emitList with image, [72, 137, 10]
  emitPushTag with image, 2
  emitEpi with image
  pin with labels, "tls_recv_bad", image
  emitFail with image, fixes, "msg_tls_recv"

  pin with labels, "rt_tls_close", image
  emitPro with image
  emitPop1 with image
  emitList with image, [72, 137, 85, 240]
  emitList with image, [72, 141, 13]
  emitRel with image, fixes, "tls_hctxt"
  emitList with image, [255, 21]
  emitRel with image, fixes, "iat_dsc"
  emitList with image, [72, 141, 13]
  emitRel with image, fixes, "tls_hcred"
  emitList with image, [255, 21]
  emitRel with image, fixes, "iat_fch"
  emitList with image, [72, 139, 85, 240]
  emitPushTag with image, 1
  emitCallTo with image, fixes, "rt_close"
  emitEpi with image

  pin with labels, "rt_tls_listen", image
  emitPro with image
  emitFail with image, fixes, "msg_tls_listen"
  return image
end

define emitTlsRuntime with image, fixes, labels, elf
  if elf
    let image be emitTlsGuest with image, fixes, labels
    return image
  end
  return (emitTlsPeGuest with image, fixes, labels)
end

define parkTls with image, labels
  parkMsg with image, labels, "msg_tls_args", "tls_connect needs a host, a port, a name, and a ca file"
  parkMsg with image, labels, "msg_tls_wrap", "tls_wrap needs a connection, a name, a ca file, and a host check"
