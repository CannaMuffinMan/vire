  let image be emitU32 with image, 0
  pin with labels, "tls_indesc4", image
  let image be emitU32 with image, 0
  pin with labels, "tls_indesc8", image
  let image be emitU64 with image, 0
  pin with labels, "tls_outdesc", image
  let image be emitU32 with image, 0
  pin with labels, "tls_outdesc4", image
  let image be emitU32 with image, 0
  pin with labels, "tls_outdesc8", image
  let image be emitU64 with image, 0
  pin with labels, "tls_inbuf", image
  let image be emitU32 with image, 0
  pin with labels, "tls_inbuf4", image
  let image be emitU32 with image, 0
  pin with labels, "tls_inbuf8", image
  let image be emitU64 with image, 0
  pin with labels, "tls_outbuf", image
