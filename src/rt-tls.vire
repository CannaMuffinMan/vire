~ Native TLS: Linux OpenSSL 3 via PT_INTERP/libssl.so.3. Windows PE SChannel
~ (secur32/crypt32 IAT). Guest APIs:
~ tls_connect host port name ca; tls_wrap handle name ca checkHost;
~ tls_listen port cert key; tls_send/recv/close; tls_peer_cert handle;
~ tls_end_point der (RFC 5929 tls-server-end-point).
~ Cert validation on. TLS 1.2 minimum, TLS 1.3 max. No insecure flags.
~ ELF tls_listen: PEM cert/key under data/ or site/, then rt_listen + SSL_accept.
~ PE tls_listen: sandboxed PFX + SChannel AcceptSecurityContext.

define tlsSymNames
  return ["TLS_client_method", "TLS_server_method", "SSL_CTX_new", "SSL_CTX_free", "SSL_CTX_set_verify", "SSL_CTX_ctrl", "SSL_CTX_load_verify_locations", "SSL_CTX_set_default_verify_paths", "SSL_CTX_use_certificate_file", "SSL_CTX_use_PrivateKey_file", "SSL_CTX_check_private_key", "SSL_new", "SSL_free", "SSL_set_fd", "SSL_connect", "SSL_accept", "SSL_read", "SSL_write", "SSL_shutdown", "SSL_get_verify_result", "SSL_set1_host", "SSL_CTX_set_options", "OpenSSL_version_num", "SSL_get1_peer_certificate", "i2d_X509", "X509_free", "SHA256", "SHA384", "SHA512"]
end

define tlsIatNames
  return ["iat_tcm", "iat_tsm", "iat_ctxnew", "iat_ctxfree", "iat_setver", "iat_ctrl", "iat_loadca", "iat_defca", "iat_usecert", "iat_usekey", "iat_chkkey", "iat_sslnew", "iat_sslfree", "iat_setfd", "iat_sslcon", "iat_sslacc", "iat_sslrd", "iat_sslwr", "iat_sslshut", "iat_vfyres", "iat_sethost", "iat_setopt", "iat_vernum", "iat_peer", "iat_i2d", "iat_xfree", "iat_sha256", "iat_sha384", "iat_sha512"]
end

define tlsStubNames
  return ["stub_tcm", "stub_tsm", "stub_ctxnew", "stub_ctxfree", "stub_setver", "stub_ctrl", "stub_loadca", "stub_defca", "stub_usecert", "stub_usekey", "stub_chkkey", "stub_sslnew", "stub_sslfree", "stub_setfd", "stub_sslcon", "stub_sslacc", "stub_sslrd", "stub_sslwr", "stub_sslshut", "stub_vfyres", "stub_sethost", "stub_setopt", "stub_vernum", "stub_peer", "stub_i2d", "stub_xfree", "stub_sha256", "stub_sha384", "stub_sha512"]
end

define tlsThunkNames
  return ["thunk_tcm", "thunk_tsm", "thunk_ctxnew", "thunk_ctxfree", "thunk_setver", "thunk_ctrl", "thunk_loadca", "thunk_defca", "thunk_usecert", "thunk_usekey", "thunk_chkkey", "thunk_sslnew", "thunk_sslfree", "thunk_setfd", "thunk_sslcon", "thunk_sslacc", "thunk_sslrd", "thunk_sslwr", "thunk_sslshut", "thunk_vfyres", "thunk_sethost", "thunk_setopt", "thunk_vernum", "thunk_peer", "thunk_i2d", "thunk_xfree", "thunk_sha256", "thunk_sha384", "thunk_sha512"]
end

define tlsPltNames
  return ["plt_tcm", "plt_tsm", "plt_ctxnew", "plt_ctxfree", "plt_setver", "plt_ctrl", "plt_loadca", "plt_defca", "plt_usecert", "plt_usekey", "plt_chkkey", "plt_sslnew", "plt_sslfree", "plt_setfd", "plt_sslcon", "plt_sslacc", "plt_sslrd", "plt_sslwr", "plt_sslshut", "plt_vfyres", "plt_sethost", "plt_setopt", "plt_vernum", "plt_peer", "plt_i2d", "plt_xfree", "plt_sha256", "plt_sha384", "plt_sha512"]
end

define tlsGotNames
  return ["got_tcm", "got_tsm", "got_ctxnew", "got_ctxfree", "got_setver", "got_ctrl", "got_loadca", "got_defca", "got_usecert", "got_usekey", "got_chkkey", "got_sslnew", "got_sslfree", "got_setfd", "got_sslcon", "got_sslacc", "got_sslrd", "got_sslwr", "got_sslshut", "got_vfyres", "got_sethost", "got_setopt", "got_vernum", "got_peer", "got_i2d", "got_xfree", "got_sha256", "got_sha384", "got_sha512"]
end

define tlsHashBuckets
  return [0, 0, 29, 8, 20, 18, 27, 0, 0, 11, 0, 0, 6, 0, 19, 0, 0, 0, 0, 22, 28, 26, 0, 12, 0, 25, 0, 0, 0, 23, 0, 0]
end

define tlsHashChains
  return [0, 0, 1, 0, 0, 0, 0, 0, 7, 4, 0, 0, 3, 9, 0, 2, 15, 16, 10, 0, 14, 17, 0, 0, 13, 5, 24, 0, 21, 0]
end

define emitTlsPltAndMeta with image, fixes, labels
  pin with labels, "tls_dynstr", image
  let image be emitU8 with image, 0
  pin with labels, "tls_needed", image
  let image be emitStr with image, "libssl.so.3"
  pin with labels, "tls_needed2", image
  let image be emitStr with image, "libcrypto.so.3"
  let names be tlsSymNames
  let i be 0
  while i < (length with names)
    pin with labels, ("dynstr_" + (text with i)), image
    let image be emitStr with image, (names at i)
    let i be i + 1
  end
  let image be alignTo with image, 8
  pin with labels, "tls_dynsym", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let i be 0
  while i < (length with names)
    pin with labels, ("dynsym_" + (text with i)), image
    let image be emitU32 with image, 0
    let image be emitU8 with image, 18
    let image be emitU8 with image, 0
    let image be emitU8 with image, 0
    let image be emitU8 with image, 0
    let image be emitU64 with image, 0
    let image be emitU64 with image, 0
    let i be i + 1
  end
  let image be alignTo with image, 8
  pin with labels, "tls_hash", image
  let image be emitU32 with image, 32
  let image be emitU32 with image, 30
  let b be tlsHashBuckets
  let i be 0
  while i < 32
    let image be emitU32 with image, (b at i)
    let i be i + 1
  end
  let c be tlsHashChains
  let i be 0
  while i < 30
    let image be emitU32 with image, (c at i)
    let i be i + 1
  end
  let image be alignTo with image, 8
  pin with labels, "tls_rela", image
  let i be 0
  while i < (length with names)
    pin with labels, ("rela_" + (text with i)), image
    let image be emitU64 with image, 0
    let image be emitU64 with image, 0
    let image be emitU64 with image, 0
    let i be i + 1
  end
  let image be alignTo with image, 8
  pin with labels, "tls_dynamic", image
  let i be 0
  while i < 24
    let image be emitU64 with image, 0
    let image be emitU64 with image, 0
    let i be i + 1
  end
  let image be alignTo with image, 16
  pin with labels, "tls_plt0", image
  let image be emitList with image, [255, 53, 0, 0, 0, 0, 255, 37, 0, 0, 0, 0, 15, 31, 64, 0]
  let i be 0
  let plts be tlsPltNames
  while i < (length with plts)
    pin with labels, (plts at i), image
    let image be emitList with image, [255, 37, 0, 0, 0, 0, 104, 0, 0, 0, 0, 233, 0, 0, 0, 0]
    let i be i + 1
  end
  return image
end

define emitTlsSysvStub with image, fixes, labels, stub, plt
  ~ Align SysV calls: OpenSSL uses movaps on the frame. and rsp,-16
  ~ then call with rsp%16==0.
  pin with labels, stub, image
  let image be emitHex with image, "554889e54883e4f04889cf4889d64c89c24989c9e8"
  let image be emitRel with image, fixes, plt
  let image be emitHex with image, "c9c3"
  return image
end

define emitTlsSslStubs with image, fixes, labels
  let stubs be tlsStubNames
  let plts be tlsPltNames
  let i be 0
  while i < (length with stubs)
    let image be emitTlsSysvStub with image, fixes, labels, (stubs at i), (plts at i)
    let i be i + 1
  end
  let thunks be tlsThunkNames
  let i be 0
  while i < (length with thunks)
    let image be emitIatThunk with image, fixes, labels, (thunks at i), (stubs at i)
    let i be i + 1
  end
  return image
end

