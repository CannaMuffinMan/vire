  pin with labels, "tls_extra", image
  let image be emitU32 with image, 0
  pin with labels, "tls_extra4", image
  let image be emitU32 with image, 0
  pin with labels, "tls_extra8", image
  let image be emitU64 with image, 0
  pin with labels, "tls_token", image
  let n be 0
  while n < 16384
    let image be emitU8 with image, 0
    let n be n + 1
  end
  pin with labels, "tls_got_head", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let names be tlsGotNames
  let i be 0
