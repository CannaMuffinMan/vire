define emitTlsWrapAccept with image, fixes, labels
  ~ After a successful accept fd in rax: if tls_ctx, SSL_new/set_fd/accept.
  pin with labels, "tls_after_accept", image
  let image be emitHex with image, "488905"
  let image be emitRel with image, fixes, "tls_fd"
  let image be emitHex with image, "488b05"
  let image be emitRel with image, fixes, "tls_ctx"
  let image be emitHex with image, "4885c074"
  let image be emitU8 with image, 70
  let image be emitHex with image, "4889c1ff15"
  let image be emitRel with image, fixes, "iat_sslnew"
  let image be emitHex with image, "4885c074"
  let image be emitU8 with image, 56
  let image be emitHex with image, "488905"
  let image be emitRel with image, fixes, "tls_ssl"
  let image be emitHex with image, "4889c18b15"
  let image be emitRel with image, fixes, "tls_fd"
  let image be emitHex with image, "ff15"
  let image be emitRel with image, fixes, "iat_setfd"
  let image be emitHex with image, "488b0d"
  let image be emitRel with image, fixes, "tls_ssl"
  let image be emitHex with image, "ff15"
  let image be emitRel with image, fixes, "iat_sslacc"
  let image be emitHex with image, "83f80175"
  let image be emitU8 with image, 14
  let image be emitHex with image, "488b05"
  let image be emitRel with image, fixes, "tls_fd"
  let image be emitHex with image, "c348c7c0ffffffffc3"
  return image
end

define tlsElfNames
  return ["tls_wrap_bad", "tls_checkhost", "tls_captr", "tls_nameptr", "tls_hs_start", "tls_conn_bad", "rt_connect", "iat_tcm", "tls_hs_fail", "iat_ctxnew", "tls_ctx", "iat_vernum", "tls_ver_fail", "iat_ctrl", "iat_setver", "tls_defca", "rt_check_path", "iat_loadca", "tls_ca_ok", "iat_defca", "iat_sslnew", "tls_ssl", "tcp_socks", "iat_setfd", "iat_sethost", "iat_sslcon", "iat_vfyres", "msg_tls_args", "rt_fail", "msg_tls_wrap", "msg_tls_hs", "msg_tls_ver", "tls_send_bad", "iat_sslwr", "msg_tls_send", "tls_recv_bad", "tls_recv_cap", "rt_alloc", "iat_sslrd", "msg_tls_recv", "tls_cls", "iat_sslshut", "iat_sslfree", "rt_close", "tls_listen_args", "iat_tsm", "iat_setopt", "iat_usecert", "tls_cert_fail", "iat_usekey", "iat_chkkey", "ws_tls_ptr", "rt_listen", "msg_tls_listen", "msg_tls_cert", "tls_peer_bad", "iat_peer", "iat_i2d", "tls_peer_free", "iat_xfree", "msg_tls_peer", "tls_rl_fail", "tls_rl_done", "tls_rl_long", "tls_ep_def", "tls_read_len", "tls_ep_try8", "tls_ep_nist", "tls_ep_384", "tls_ep_512", "tls_ep_kind", "tls_ep_do384", "tls_ep_do512", "iat_sha256", "tls_ep_hashed", "iat_sha384", "iat_sha512", "rt_tls_wrap", "rt_tls_connect", "rt_tls_send", "rt_tls_recv", "rt_tls_close", "rt_tls_listen", "rt_tls_peer_cert", "rt_tls_end_point"]
end

define emitTlsGuest with image, fixes, labels
  ~ Packed ELF OpenSSL emit (tools/pack-tls-elf.py from src/rt-tls-elf.vire)
  ~ so gen1 stays under the compiler list cap. Regen blobs after editing
  ~ rt-tls-elf.vire.
  let base be length with image
  let names be tlsElfNames
  let image be emitHex with image, (read with "data/src/rt-tls-elf-blob.txt")
  applyPackedPins with labels, base, (read with "data/src/rt-tls-elf-pins.txt"), names
  applyPackedFixes with fixes, base, (read with "data/src/rt-tls-elf-fixes.txt"), names
  return image
end

