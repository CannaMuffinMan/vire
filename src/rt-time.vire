~ Wall clock for native PE. Guest builtins unix / unix_ms (host: Vire.cs).
~ GetSystemTimeAsFileTime: 100ns ticks since 1601-01-01 UTC.
~ Unix epoch is 116444736000000000 ticks later; seconds = (ft - epoch) / 10000000.
~ Milliseconds = (ft - epoch) / 10000. Read-only; no new capabilities.
~ jwt_exp_check lives in tests/native/time-prove.vire (needs rt-crypto; this
~ file is loaded by compile-native and cannot name jwt_hs256_verify).

define emitTimeRuntime with image, fixes, labels
  pin with labels, "rt_unix", image
  emitPro with image
  emitCallTo with image, fixes, "rt_filetime"
  emitList with image, [72, 185, 128, 150, 152, 0, 0, 0, 0, 0]
  emitCallTo with image, fixes, "rt_unix_div"
  emitCallTo with image, fixes, "rt_push_int"
  emitEpi with image

  pin with labels, "rt_unix_ms", image
  emitPro with image
  emitCallTo with image, fixes, "rt_filetime"
  emitList with image, [72, 185, 16, 39, 0, 0, 0, 0, 0, 0]
  emitCallTo with image, fixes, "rt_unix_div"
  emitCallTo with image, fixes, "rt_push_int"
  emitEpi with image

  pin with labels, "rt_filetime", image
  emitList with image, [72, 141, 77, 248, 255, 21]
  emitRel with image, fixes, "iat_st"
  emitList with image, [72, 139, 69, 248, 195]

  pin with labels, "rt_unix_div", image
  emitList with image, [73, 184, 0, 0, 128, 60, 222, 177, 157, 1]
  emitList with image, [76, 41, 192, 72, 49, 210, 72, 247, 241, 72, 137, 193, 195]
  return image
end
