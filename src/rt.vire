~ Native runtime emitted with the entry stub. Vire links the relocations.

use "src/rt-more.vire"

define emitList with image, bytes
  let i be 0
  let n be length with bytes
  while i < n
    emitU8 with image, (bytes at i)
    let i be i + 1
  end
  return image
end

