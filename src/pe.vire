~ Windows x64 console image builder. Used by the native compiler.

use "src/asm.vire"
use "src/rt.vire"

define alphabet
  return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
end

define ord with ch
  return (find with (alphabet), ch) + 32
end

define codeOf with ch
  if ch == "\n"
    return 10
  end
  if ch == "\r"
    return 13
  end
  if ch == "\t"
    return 9
  end
  if (find with (alphabet), ch) < 0
    return -1
  end
  return ord with ch
end

define emitStr with buf, raw
  ~ codeOf keeps CR/LF/HT. ord is find+32, so CR/LF become 0x1F (HTTP framing break).
  let i be 0
  let n be length with raw
  while i < n
    let buf be emitU8 with buf, (codeOf with (raw at i))
    let i be i + 1
  end
  let buf be emitU8 with buf, 0
  return buf
end

define poke32 with buf, pos, n
  let x be n
  if x < 0
    let x be x + 2147483647
    let x be x + 2147483647
    let x be x + 2
  end
  let k be 0
  while k < 4
    let q be floorDiv with x, 256
    let byte be x % 256
    put byte into buf at (pos + k)
    let x be q
    let k be k + 1
  end
  return buf
end

define poke16 with buf, pos, n
  let x be n
  if x < 0
    let x be x + 65536
  end
  let q be floorDiv with x, 256
  let lo be x % 256
  put q into buf at (pos + 1)
  put lo into buf at pos
  return buf
end

define pokeName with buf, pos, raw
  let i be 0
  while i < 8
    put 0 into buf at (pos + i)
    let i be i + 1
  end
  let i be 0
  let n be length with raw
  while i < n
    put (ord with (raw at i)) into buf at (pos + i)
    let i be i + 1
  end
  return buf
end

define pokeSection with head, off, name, vsize, va, rsize, rptr, chars
  pokeName with head, off, name
  poke32 with head, (off + 8), vsize
  poke32 with head, (off + 12), va
  poke32 with head, (off + 16), rsize
  poke32 with head, (off + 20), rptr
  poke32 with head, (off + 36), chars
  return head
end

define peChecksum with pe
  poke32 with pe, 216, 0
  let sum be 0
  let n be length with pe
  let i be 0
  while i + 1 < n
    let lo be pe at i
    let hi be pe at (i + 1)
    let word be lo + (shl8 with hi)
    let sum be sum + word
    let sum be (sum % 65536) + (floorDiv with sum, 65536)
    let i be i + 2
  end
  if i < n
    let sum be sum + (pe at i)
    let sum be (sum % 65536) + (floorDiv with sum, 65536)
  end
  let sum be (sum % 65536) + (floorDiv with sum, 65536)
  let sum be sum + n
  poke32 with pe, 216, sum
  return pe
end

define zeros with n
  let buf be bytes
  let i be 0
  while i < n
    let buf be push with buf, 0
    let i be i + 1
  end
  return buf
end

define alignTo with buf, n
  let len be length with buf
  let rem be len % n
  let pad be 0
  if rem != 0
    let pad be n - rem
  end
  let i be 0
  while i < pad
    let buf be emitU8 with buf, 0
    let i be i + 1
  end
  return buf
end

define openImage
  let image be bytes
  let labels be {}
  let fixes be []
  let names be ["GetStdHandle", "WriteFile", "ExitProcess", "VirtualAlloc", "CreateFileA", "ReadFile", "GetFileSize", "CloseHandle", "GetCommandLineA", "GetFileAttributesA", "GetFileInformationByHandle", "SetUnhandledExceptionFilter", "AddVectoredExceptionHandler", "SetFilePointerEx", "SetEndOfFile"]
  let ilts be ["ilt_gs", "ilt_wf", "ilt_ep", "ilt_va", "ilt_cf", "ilt_rf", "ilt_sz", "ilt_ch", "ilt_cl", "ilt_ga", "ilt_fi", "ilt_ue", "ilt_vh", "ilt_sp", "ilt_se"]
  let iats be ["iat_gs", "iat_wf", "iat_ep", "iat_va", "iat_cf", "iat_rf", "iat_sz", "iat_ch", "iat_cl", "iat_ga", "iat_fi", "iat_ue", "iat_vh", "iat_sp", "iat_se"]
  let hints be ["hint_gs", "hint_wf", "hint_ep", "hint_va", "hint_cf", "hint_rf", "hint_sz", "hint_ch", "hint_cl", "hint_ga", "hint_fi", "hint_ue", "hint_vh", "hint_sp", "hint_se"]
  let i be 0
  while i < (length with names)
    pin with labels, (ilts at i), image
    let image be emitU64 with image, 0
    let i be i + 1
  end
  let image be emitU64 with image, 0
  let i be 0
  while i < (length with iats)
    pin with labels, (iats at i), image
    let image be emitU64 with image, 0
    let i be i + 1
  end
  let image be emitU64 with image, 0
  pin with labels, "desc", image
  let i be 0
  while i < 10
    let image be emitU32 with image, 0
    let i be i + 1
  end
  pin with labels, "dll", image
  let image be emitStr with image, "kernel32.dll"
  let image be alignTo with image, 2
  let i be 0
  while i < (length with hints)
    pin with labels, (hints at i), image
    let image be emitU8 with image, 0
    let image be emitU8 with image, 0
    let image be emitStr with image, (names at i)
    let image be alignTo with image, 2
    let i be i + 1
  end
  let image be alignTo with image, 16
  let image be alignTo with image, 4096
  let image be emitRuntime with image, fixes, labels
  return {"image": image, "labels": labels, "fixes": fixes, "hints": hints, "ilts": ilts, "iats": iats, "impSize": 40, "net": false}
end

define openNetImage
  ~ IAT_NET: kernel32 + GetTickCount, and a second descriptor for a fixed ws2_32 allowlist.
  ~ Only guests that call listen. No LoadLibraryA, no GetProcAddress, no CreateProcess.
  let image be bytes
  let labels be {}
  let fixes be []
  let k32 be ["GetStdHandle", "WriteFile", "ExitProcess", "VirtualAlloc", "CreateFileA", "ReadFile", "GetFileSize", "CloseHandle", "GetCommandLineA", "GetFileAttributesA", "GetFileInformationByHandle", "SetUnhandledExceptionFilter", "AddVectoredExceptionHandler", "SetFilePointerEx", "SetEndOfFile", "GetTickCount"]
  let kilt be ["ilt_gs", "ilt_wf", "ilt_ep", "ilt_va", "ilt_cf", "ilt_rf", "ilt_sz", "ilt_ch", "ilt_cl", "ilt_ga", "ilt_fi", "ilt_ue", "ilt_vh", "ilt_sp", "ilt_se", "ilt_gt"]
  let kiat be ["iat_gs", "iat_wf", "iat_ep", "iat_va", "iat_cf", "iat_rf", "iat_sz", "iat_ch", "iat_cl", "iat_ga", "iat_fi", "iat_ue", "iat_vh", "iat_sp", "iat_se", "iat_gt"]
  let khint be ["hint_gs", "hint_wf", "hint_ep", "hint_va", "hint_cf", "hint_rf", "hint_sz", "hint_ch", "hint_cl", "hint_ga", "hint_fi", "hint_ue", "hint_vh", "hint_sp", "hint_se", "hint_gt"]
  let ws be ["WSAStartup", "socket", "bind", "listen", "accept", "recv", "send", "closesocket", "setsockopt", "getsockname"]
  let wilt be ["ilt_wsa", "ilt_sk", "ilt_bd", "ilt_ln", "ilt_ac", "ilt_rv", "ilt_sd", "ilt_cs", "ilt_ss", "ilt_gn"]
  let wiat be ["iat_wsa", "iat_sk", "iat_bd", "iat_ln", "iat_ac", "iat_rv", "iat_sd", "iat_cs", "iat_ss", "iat_gn"]
  let whint be ["hint_wsa", "hint_sk", "hint_bd", "hint_ln", "hint_ac", "hint_rv", "hint_sd", "hint_cs", "hint_ss", "hint_gn"]
  let c32 be ["CryptStringToBinaryA", "CertCreateCertificateContext", "CertSetCertificateContextProperty", "CertFreeCertificateContext"]
  let cilt be ["ilt_c2b", "ilt_ccc", "ilt_csc", "ilt_cfc"]
  let ciat be ["iat_c2b", "iat_ccc", "iat_csc", "iat_cfc"]
  let chint be ["hint_c2b", "hint_ccc", "hint_csc", "hint_cfc"]
  let sec be ["AcquireCredentialsHandleA", "FreeCredentialsHandle", "AcceptSecurityContext", "DeleteSecurityContext", "QueryContextAttributesA", "EncryptMessage", "DecryptMessage", "FreeContextBuffer"]
  let silt be ["ilt_ach", "ilt_fch", "ilt_asc", "ilt_dsc", "ilt_qca", "ilt_enc", "ilt_dec", "ilt_fcb"]
  let siat be ["iat_ach", "iat_fch", "iat_asc", "iat_dsc", "iat_qca", "iat_enc", "iat_dec", "iat_fcb"]
  let shint be ["hint_ach", "hint_fch", "hint_asc", "hint_dsc", "hint_qca", "hint_enc", "hint_dec", "hint_fcb"]
  let nc be ["NCryptOpenStorageProvider", "NCryptImportKey", "NCryptFreeObject"]
  let nilt be ["ilt_nop", "ilt_nik", "ilt_nfo"]
  let niat be ["iat_nop", "iat_nik", "iat_nfo"]
  let nhint be ["hint_nop", "hint_nik", "hint_nfo"]
  let image be emitThunks with image, labels, kilt
  let image be emitThunks with image, labels, wilt
  let image be emitThunks with image, labels, cilt
  let image be emitThunks with image, labels, silt
  let image be emitThunks with image, labels, nilt
  let image be emitThunks with image, labels, kiat
  let image be emitThunks with image, labels, wiat
  let image be emitThunks with image, labels, ciat
  let image be emitThunks with image, labels, siat
  let image be emitThunks with image, labels, niat
  let image be emitDesc with image, labels, "desc"
  let image be emitDesc with image, labels, "desc_ws"
  let image be emitDesc with image, labels, "desc_c32"
  let image be emitDesc with image, labels, "desc_sec"
  let image be emitDesc with image, labels, "desc_nc"
  let image be emitDesc with image, labels, "desc_end"
  pin with labels, "dll", image
  let image be emitStr with image, "kernel32.dll"
  let image be alignTo with image, 2
  pin with labels, "dll_ws", image
  let image be emitStr with image, "ws2_32.dll"
  let image be alignTo with image, 2
  pin with labels, "dll_c32", image
  let image be emitStr with image, "crypt32.dll"
  let image be alignTo with image, 2
  pin with labels, "dll_sec", image
  let image be emitStr with image, "secur32.dll"
  let image be alignTo with image, 2
  pin with labels, "dll_nc", image
  let image be emitStr with image, "ncrypt.dll"
  let image be alignTo with image, 2
  let image be emitHints with image, labels, khint, k32
  let image be emitHints with image, labels, whint, ws
  let image be emitHints with image, labels, chint, c32
  let image be emitHints with image, labels, shint, sec
  let image be emitHints with image, labels, nhint, nc
  let image be alignTo with image, 16
  let image be alignTo with image, 4096
  let image be emitRuntime with image, fixes, labels
  let hints be []
  let ilts be []
  let iats be []
  let hints be catHints with hints, khint
  let ilts be catHints with ilts, kilt
  let iats be catHints with iats, kiat
  let hints be catHints with hints, whint
  let ilts be catHints with ilts, wilt
  let iats be catHints with iats, wiat
  let hints be catHints with hints, chint
  let ilts be catHints with ilts, cilt
  let iats be catHints with iats, ciat
  let hints be catHints with hints, shint
  let ilts be catHints with ilts, silt
  let iats be catHints with iats, siat
  let hints be catHints with hints, nhint
  let ilts be catHints with ilts, nilt
  let iats be catHints with iats, niat
  return {"image": image, "labels": labels, "fixes": fixes, "hints": hints, "ilts": ilts, "iats": iats, "impSize": 120, "net": true}
end

define emitThunks with image, labels, names
  let i be 0
  while i < (length with names)
    pin with labels, (names at i), image
    let image be emitU64 with image, 0
    let i be i + 1
  end
  let image be emitU64 with image, 0
  return image
end

define emitDesc with image, labels, name
  pin with labels, name, image
  let i be 0
  while i < 5
    let image be emitU32 with image, 0
    let i be i + 1
  end
  return image
end

define emitHints with image, labels, hints, apis
  let i be 0
  while i < (length with hints)
    pin with labels, (hints at i), image
    let image be emitU8 with image, 0
    let image be emitU8 with image, 0
    let image be emitStr with image, (apis at i)
    let image be alignTo with image, 2
    let i be i + 1
  end
  return image
end

define catHints with dest, extra
  let i be 0
  while i < (length with extra)
    push with dest, (extra at i)
    let i be i + 1
  end
  return dest
end

define parkPool with image, labels, pool
  let i be 0
  let n be length with pool
  while i < n
    let item be pool at i
    pin with labels, (item at "name"), image
    let raw be item at "raw"
    let image be emitU64 with image, (length with raw)
    let k be 0
    let m be length with raw
    while k < m
      let image be emitU8 with image, (codeOf with (raw at k))
      let k be k + 1
    end
    let image be emitU8 with image, 0
    let i be i + 1
  end
  return image
end

define finishImage with image, labels, fixes, hints, ilts, iats
  patchRel with image, labels, fixes
  let i be 0
  while i < (length with hints)
    let target be 4096 + (labels at (hints at i))
    poke32 with image, (labels at (ilts at i)), target
    poke32 with image, (labels at (iats at i)), target
    let i be i + 1
  end
  let desc be labels at "desc"
  poke32 with image, desc, (4096 + (labels at "ilt_gs"))
  poke32 with image, (desc + 12), (4096 + (labels at "dll"))
  poke32 with image, (desc + 16), (4096 + (labels at "iat_gs"))
  if has with labels, "desc_ws"
    let dw be labels at "desc_ws"
    poke32 with image, dw, (4096 + (labels at "ilt_wsa"))
    poke32 with image, (dw + 12), (4096 + (labels at "dll_ws"))
    poke32 with image, (dw + 16), (4096 + (labels at "iat_wsa"))
  end
  if has with labels, "desc_c32"
    let dc be labels at "desc_c32"
    poke32 with image, dc, (4096 + (labels at "ilt_c2b"))
    poke32 with image, (dc + 12), (4096 + (labels at "dll_c32"))
    poke32 with image, (dc + 16), (4096 + (labels at "iat_c2b"))
  end
  if has with labels, "desc_sec"
    let ds be labels at "desc_sec"
    poke32 with image, ds, (4096 + (labels at "ilt_ach"))
    poke32 with image, (ds + 12), (4096 + (labels at "dll_sec"))
    poke32 with image, (ds + 16), (4096 + (labels at "iat_ach"))
  end
  if has with labels, "desc_nc"
    let dn be labels at "desc_nc"
    poke32 with image, dn, (4096 + (labels at "ilt_nop"))
    poke32 with image, (dn + 12), (4096 + (labels at "dll_nc"))
    poke32 with image, (dn + 16), (4096 + (labels at "iat_nop"))
  end
  return image
end

define buildExe with image, entry, imp, dataOff
  return buildPe with image, entry, imp, dataOff, 40
end

define buildPe with image, entry, imp, dataOff, impSize
  ~ Well-formed PE32+: W^X .text/.data, checksum, nonzero timestamp, linker 14.40,
  ~ OS/subsystem 6.0, 1MB stack/heap reserve (arena stays VirtualAlloc 32MB),
  ~ NX + HIGH_ENTROPY_VA + TERMINAL_SERVER_AWARE. No DYNAMIC_BASE without relocs.
  ~ Do not add RWX, raise caps, or Defender exclusions.
  let head be zeros with 512
  poke32 with head, 0, 23117
  poke32 with head, 60, 128
  poke32 with head, 128, 17744
  poke16 with head, 132, 34404
  poke16 with head, 134, 3
  poke32 with head, 136, 1744830464
  poke16 with head, 148, 240
  poke16 with head, 150, 35
  poke16 with head, 152, 523
  put 14 into head at 154
  put 40 into head at 155
  poke32 with head, 168, (4096 + entry)
  poke32 with head, 172, 8192
  poke32 with head, 176, 1073741824
  poke32 with head, 180, 1
  poke32 with head, 184, 4096
  poke32 with head, 188, 512
  poke16 with head, 192, 6
  poke16 with head, 194, 0
  poke16 with head, 200, 6
  poke16 with head, 202, 0
  let image be alignTo with image, 512
  let rawSize be length with image
  let idataRaw be 4096
  let textRaw be dataOff - 4096
  let dataRaw be rawSize - dataOff
  if textRaw < 512
    let textRaw be 512
  end
  if dataRaw < 512
    let dataRaw be 512
  end
  let textPages be floorDiv with (textRaw + 4095), 4096
  let dataPages be floorDiv with (dataRaw + 4095), 4096
  poke32 with head, 156, textRaw
  poke32 with head, 160, (idataRaw + dataRaw)
  let imageSize be 8192
  let p be 0
  while p < textPages
    let imageSize be imageSize + 4096
    let p be p + 1
  end
  let p be 0
  while p < dataPages
    let imageSize be imageSize + 4096
    let p be p + 1
  end
  poke32 with head, 208, imageSize
  poke32 with head, 212, 512
  poke16 with head, 220, 3
  poke16 with head, 222, 33056
  poke32 with head, 224, 1048576
  poke32 with head, 232, 4096
  poke32 with head, 240, 1048576
  poke32 with head, 248, 4096
  poke32 with head, 260, 16
  poke32 with head, 272, (4096 + imp)
  poke32 with head, 276, impSize
  pokeSection with head, 392, ".idata", 4096, 4096, 4096, 512, 3221225536
  pokeSection with head, 432, ".text", textRaw, 8192, textRaw, 4608, 1610612768
  pokeSection with head, 472, ".data", dataRaw, (4096 + dataOff), dataRaw, (512 + dataOff), 3221225536
  let pe be extend with head, image
  return peChecksum with pe
end
