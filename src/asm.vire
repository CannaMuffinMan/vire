~ Byte helpers for the native Vire compiler. This file is Vire.

define whole with n
  let raw be text with n
  let dot be find with raw, "."
  if dot >= 0
    let raw be slice with raw, 0, dot
  end
  if raw == ""
    return 0
  end
  if raw == "-"
    return 0
  end
  return number with raw
end

define floorDiv with n, d
  return idiv with n, d
end

define emitU8 with buf, n
  if n >= 0
    if n < 256
      return (push with buf, n)
    end
  end
  let x be n
  if x < 0
    let x be x + 256
  end
  if x >= 256
    let x be x % 256
  end
  if x < 0
    let x be 0
  end
  let buf be push with buf, x
  return buf
end

define emitU32 with buf, n
  let x be n
  if x >= 0
    if x < 256
      let buf be push with buf, x
      let buf be push with buf, 0
      let buf be push with buf, 0
      let buf be push with buf, 0
      return buf
    end
  end
  if x < 0
    let x be x + 2147483647
    let x be x + 2147483647
    let x be x + 2
  end
  let i be 0
  while i < 4
    let q be floorDiv with x, 256
    let byte be x % 256
    if byte < 0
      let byte be 0
    end
    let buf be push with buf, byte
    let x be q
    let i be i + 1
  end
  return buf
end

define emitU64 with buf, n
  let buf be emitU32 with buf, n
  let high be 0
  if n >= 4294967296
    let high be floorDiv with n, 4294967296
  end
  let buf be emitU32 with buf, high
  return buf
end

define emitRel with buf, fixes, name
  let pos be length with buf
  let buf be emitU32 with buf, 0
  push with fixes, {"at": pos, "to": name}
  return buf
end

define pin with labels, name, buf
  put (length with buf) into labels at name
  return true
end

define patchRel with buf, labels, fixes
  let i be 0
  let n be length with fixes
  while i < n
    let fix be fixes at i
    let pos be fix at "at"
    let dest be labels at (fix at "to")
    let rel be dest - (pos + 4)
    let x be rel
    if x < 0
      let x be x + 2147483647
      let x be x + 2147483647
      let x be x + 2
    end
    let b0 be 0
    let k be 0
    while k < 4
      let q be floorDiv with x, 256
      let byte be x % 256
      put byte into buf at (pos + k)
      let x be q
      let k be k + 1
    end
    let i be i + 1
  end
  return buf
end

define hexIndex with n
  let raw be text with n
  let dot be find with raw, "."
  if dot >= 0
    let raw be slice with raw, 0, dot
  end
  if raw == "" or raw == "-"
    return 0
  end
  let x be number with raw
  if x < 0
    return 0
  end
  if x >= 256
    let x be x % 256
  end
  return x
end

define hexTable
  return ""
end

define hexOf with buf
  let digits be hexTable
  let parts be []
  let i be 0
  let n be length with buf
  while i < n
    let b be hexIndex with (buf at i)
    let o be b + b
    push with parts, (slice with digits, o, (o + 2))
    let i be i + 1
  end
  return join with parts, ""
end
