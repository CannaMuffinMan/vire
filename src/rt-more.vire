~ More native runtime: numbers, text, lists, maps, loops, files, and args.

define emitPro with image
  ~ sub rsp, 128 (imm32): 96-byte frames put BY_HANDLE_FILE_INFORMATION at [rsp+0], which is Win64 shadow space. kernel32 then spills over the struct and can AV (0xC0000005) on GetFileInformationByHandle.
  let image be emitList with image, [85, 72, 137, 229, 72, 129, 236, 128, 0, 0, 0]
  return image
end

define emitEpi with image
  let image be emitList with image, [201, 195]
  return image
end

define emitCallTo with image, fixes, name
  let image be emitList with image, [232]
  let image be emitRel with image, fixes, name
  return image
end

define emitJcc with image, fixes, op, name
  let image be emitU8 with image, 15
  let image be emitU8 with image, op
  let image be emitRel with image, fixes, name
  return image
end

define emitJmpTo with image, fixes, name
  let image be emitList with image, [233]
  let image be emitRel with image, fixes, name
  return image
end

define emitFail with image, fixes, name
  let image be emitList with image, [72, 141, 13]
  let image be emitRel with image, fixes, name
  let image be emitCallTo with image, fixes, "rt_fail"
  return image
end

define emitPop2 with image
  let image be emitList with image, [73, 131, 237, 16, 77, 139, 69, 0, 77, 139, 77, 8, 73, 131, 237, 16, 73, 139, 69, 0, 73, 139, 85, 8]
  return image
end

define emitPop1 with image
  let image be emitList with image, [73, 131, 237, 16, 73, 139, 69, 0, 73, 139, 85, 8]
  return image
end

define emitPushTag with image, tag
  let image be emitList with image, [73, 199, 69, 0]
  let image be emitU32 with image, tag
  let image be emitList with image, [73, 137, 85, 8, 73, 131, 197, 16]
  return image
end

