~ More native runtime: numbers, text, lists, maps, loops, files, and args.

define emitPro with image
  emitList with image, [85, 72, 137, 229, 72, 131, 236, 96]
  return true
end

define emitEpi with image
  emitList with image, [201, 195]
  return true
end

define emitCallTo with image, fixes, name
  emitList with image, [232]
  emitRel with image, fixes, name
  return true
end

define emitJcc with image, fixes, op, name
  emitU8 with image, 15
  emitU8 with image, op
  emitRel with image, fixes, name
  return true
end

define emitJmpTo with image, fixes, name
  emitList with image, [233]
  emitRel with image, fixes, name
  return true
end

define emitFail with image, fixes, name
  emitList with image, [72, 141, 13]
  emitRel with image, fixes, name
  emitCallTo with image, fixes, "rt_fail"
  return true
end

define emitPop2 with image
  emitList with image, [73, 131, 237, 16, 77, 139, 69, 0, 77, 139, 77, 8, 73, 131, 237, 16, 73, 139, 69, 0, 73, 139, 85, 8]
  return true
end

define emitPop1 with image
  emitList with image, [73, 131, 237, 16, 73, 139, 69, 0, 73, 139, 85, 8]
  return true
end

define emitPushTag with image, tag
  emitList with image, [73, 199, 69, 0]
  emitU32 with image, tag
  emitList with image, [73, 137, 85, 8, 73, 131, 197, 16]
  return true
end

