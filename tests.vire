use "checks/core.vire"

define kept with line
  if line == "pass"
    return 0
  end
  if ends with line, " pass"
    return 0
  end
  say line
  return 1
end

define main
  let n be 0
  let n be numbers with n
  let n be records with n
  let n be trouble with n
  let n be guard with n
  let n be picture with n
  let n be tools with n
  for name in sources with "systems"
    let n be n + kept with (run with ("systems/" + name))
  end
  if n == 0
    say "pass"
  else
    say n
  end
end
