~ Compile let, if, calls, and read into a native Windows PE or Linux ELF executable.

use "src/pe.vire"
use "src/rt-net.vire"
use "src/elf.vire"

define isLetter with ch
  let letters be "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
  if (find with letters, ch) >= 0
    return true
  end
  return false
end

define isDigit with ch
  if (find with "0123456789", ch) >= 0
    return true
  end
  return false
end

define gap with source, i
  let n be length with source
  while i < n
    let ch be source at i
    if ch == "~"
      let i be i + 1
      while i < n
        let mark be source at i
        let i be i + 1
        if mark == "\n"
          stop
        end
      end
    end
    if ch == " "
      let i be i + 1
    end
    if ch == "\n"
      let i be i + 1
    end
    if ch == "\r"
      let i be i + 1
    end
    if ch == "\t"
      let i be i + 1
    end
    if ch != " " and ch != "\n" and ch != "\r" and ch != "\t" and ch != "~"
      stop
    end
  end
  return i
end

define readString with source, i
  let n be length with source
  let i be i + 1
  let piece be ""
  while i < n
    let ch be source at i
    if ch == "\n"
      return {"bad": true, "i": i, "text": ""}
    end
    if ch == "\""
      return {"bad": false, "i": i + 1, "text": piece}
    end
    if ch == "\\"
      let i be i + 1
      if i >= n
        return {"bad": true, "i": i, "text": ""}
      end
      let esc be source at i
      if esc == "n"
        let piece be piece + "\n"
      end
      if esc == "r"
        let piece be piece + "\r"
      end
      if esc == "t"
        let piece be piece + "\t"
      end
      if esc == "\""
        let piece be piece + "\""
      end
      if esc == "\\"
        let piece be piece + "\\"
      end
      if esc != "n" and esc != "r" and esc != "t" and esc != "\"" and esc != "\\"
        return {"bad": true, "i": i, "text": ""}
      end
      let i be i + 1
    end
    if ch != "\\" and ch != "\"" and ch != "\n"
      let piece be piece + ch
      let i be i + 1
    end
  end
  return {"bad": true, "i": i, "text": ""}
end

define keyword with word
  if word == "define" or word == "with" or word == "end" or word == "let" or word == "be"
    return word
  end
  if word == "say" or word == "if" or word == "else" or word == "return"
    return word
  end
  if word == "while" or word == "stop" or word == "skip" or word == "put" or word == "into" or word == "at"
    return word
  end
  if word == "for" or word == "in" or word == "try" or word == "miss"
    return word
  end
  if word == "and" or word == "or" or word == "not" or word == "true" or word == "false" or word == "none"
    return word
  end
  if word == "use" or word == "need"
    return word
  end
  return "name"
end

define tokenize with source
  let ks be []
  let ss be []
  let ns be []
  let i be gap with source, 0
  let n be length with source
  while i < n
    let ch be source at i
    if ch == "\""
      let item be readString with source, i
      if item at "bad"
        return {"bad": true, "why": "broken string"}
      end
      push with ks, "text"
      push with ss, (item at "text")
      push with ns, 0
      let i be gap with source, (item at "i")
    end
    if ch != "\""
      if isDigit with ch
        let v be 0
        while i < n
          let mark be source at i
          if not (isDigit with mark)
            stop
          end
          let v be (v * 10) + (number with mark)
          let i be i + 1
        end
        if i < n
          if (source at i) == "."
            return {"bad": true, "why": "that number is not ready"}
          end
        end
        push with ks, "num"
        push with ss, ""
        push with ns, v
        let i be gap with source, i
      end
      if not (isDigit with ch)
        if isLetter with ch
          let word be ""
          while i < n
            let mark be source at i
            if not (isLetter with mark) and not (isDigit with mark)
              stop
            end
            let word be word + mark
            let i be i + 1
          end
          let key be keyword with word
          push with ks, key
          push with ss, word
          push with ns, 0
          let i be gap with source, i
        end
        if not (isLetter with ch)
          let two be ""
          if i + 1 < n
            let two be (source at i) + (source at (i + 1))
          end
          if two == "==" or two == "!=" or two == "<=" or two == ">="
            push with ks, two
            push with ss, two
            push with ns, 0
            let i be gap with source, (i + 2)
          end
          if two != "==" and two != "!=" and two != "<=" and two != ">="
            if (find with "+-*/%<>=(),[]{}:", ch) >= 0
              push with ks, ch
              push with ss, ch
              push with ns, 0
              let i be gap with source, (i + 1)
            end
            if (find with "+-*/%<>=(),[]{}:", ch) < 0
              return {"bad": true, "why": "that expression is not ready"}
            end
          end
        end
      end
    end
  end
  return {"bad": false, "why": "", "ks": ks, "ss": ss, "ns": ns}
end

define form with state
  let ks be state at "ks"
  if (state at "i") >= (length with ks)
    return "eof"
  end
  return ks at (state at "i")
end

define spell with state
  return (state at "ss") at (state at "i")
end

define valueOf with state
  return (state at "ns") at (state at "i")
end

define bump with state
  put ((state at "i") + 1) into state at "i"
  return true
end

define markBad with state, why
  if state at "bad"
    return ["none"]
  end
  put true into state at "bad"
  put why into state at "why"
  return ["none"]
end

define precOf with k
  if k == "or"
    return 1
  end
  if k == "and"
    return 2
  end
  if k == "==" or k == "!=" or k == "<" or k == ">" or k == "<=" or k == ">="
    return 3
  end
  if k == "+" or k == "-"
    return 4
  end
  if k == "*" or k == "/" or k == "%"
    return 5
  end
  return 0
end

~ One recursive climb instead of parseOr..parseAtom (8 frames per nest).
~ Depth 6 used to hit MaxCalls 64; one frame per nest leaves room for depth 20.
define parseExpr with state, func
  return parseClimb with state, func, 0
end

define parseClimb with state, func, minP
  let prefs be []
  while true
    if state at "bad"
      stop
    end
    let fk be form with state
    if fk == "not" or fk == "-"
      push with prefs, fk
      bump with state
    end
    if fk != "not" and fk != "-"
      stop
    end
  end
  let left be parseAtom with state, func
  while (form with state) == "at"
    if state at "bad"
      stop
    end
    bump with state
    let left be ["at", left, parseAtom with state, func]
  end
  let npref be length with prefs
  while npref > 0
    let npref be npref - 1
    let pk be prefs at npref
    if pk == "not"
      let left be ["not", left]
    end
    if pk == "-"
      let left be ["neg", left]
    end
  end
  while true
    if state at "bad"
      stop
    end
    let k be form with state
    let prec be precOf with k
    if prec == 0
      stop
    end
    if prec < minP
      stop
    end
    bump with state
    let left be [k, left, parseClimb with state, func, (prec + 1)]
  end
  return left
end

define parseAtom with state, func
  if state at "bad"
    return ["none"]
  end
  let k be form with state
  if k == "num"
    let n be valueOf with state
    bump with state
    return ["num", n]
  end
  if k == "text"
    let raw be spell with state
    bump with state
    return ["text", raw]
  end
  if k == "true"
    bump with state
    return ["bool", 1]
  end
  if k == "false"
    bump with state
    return ["bool", 0]
  end
  if k == "none"
    bump with state
    return ["none"]
  end
  if k == "name"
    let nm be spell with state
    bump with state
    if (form with state) == "with"
      bump with state
      if (form with state) == "eof" or (form with state) == "end" or (form with state) == "else"
        return markBad with state, "that call is missing a value"
      end
      let args be []
      push with args, (parseClimb with state, func, 5)
      while (form with state) == ","
        bump with state
        push with args, (parseClimb with state, func, 5)
      end
      noteNeed with state, nm
      return ["call", nm, args]
    end
    return ["name", nm]
  end
  if k == "("
    bump with state
    let inner be parseClimb with state, func, 0
    if (form with state) != ")"
      return markBad with state, "that expression is not ready"
    end
    bump with state
    return inner
  end
  if k == "["
    ~ list elements always parseExpr with state, func
    bump with state
    let items be []
    if (form with state) == "]"
      bump with state
      return ["list", items]
    end
    push with items, (parseClimb with state, func, 0)
    while (form with state) == ","
      bump with state
      if (form with state) == "]"
        stop
      end
      push with items, (parseClimb with state, func, 0)
    end
    if (form with state) != "]"
      return markBad with state, "that expression is not ready"
    end
    bump with state
    return ["list", items]
  end
  if k == "{"
    bump with state
    let pairs be []
    if (form with state) == "}"
      bump with state
      return ["map", pairs]
    end
    let key be parseClimb with state, func, 0
    if (form with state) != ":"
      return markBad with state, "that expression is not ready"
    end
    bump with state
    let val be parseClimb with state, func, 0
    push with pairs, ["pair", key, val]
    while (form with state) == ","
      bump with state
      if (form with state) == "}"
        stop
      end
      let key be parseClimb with state, func, 0
      if (form with state) != ":"
        return markBad with state, "that expression is not ready"
      end
      bump with state
      let val be parseClimb with state, func, 0
      push with pairs, ["pair", key, val]
    end
    if (form with state) != "}"
      return markBad with state, "that expression is not ready"
    end
    bump with state
    return ["map", pairs]
  end
  return markBad with state, "that expression is not ready"
end

define parseLoop with state, func
  let body be []
  while true
    if state at "bad"
      stop
    end
    let k be form with state
    if k == "end" or k == "eof"
      stop
    end
    push with body, (parseStmt with state, func)
  end
  return body
end

define parseBlock with state, func
  let body be []
  while true
    if state at "bad"
      stop
    end
    let k be form with state
    if k == "end" or k == "else" or k == "miss" or k == "eof"
      stop
    end
    push with body, (parseStmt with state, func)
  end
  return body
end

define parseIf with state, func, close
  bump with state
  let test be parseExpr with state, func
  let yes be parseBlock with state, func
  let no be []
  let follow be ""
  if (form with state) == "else"
    bump with state
    let follow be form with state
  end
  if follow == "if"
    push with no, (parseIf with state, func, false)
  end
  if follow != "" and follow != "if"
    let no be parseBlock with state, func
  end
  if close
    if (form with state) != "end"
      return markBad with state, "the program needs end"
    end
    bump with state
  end
  return ["if", test, yes, no]
end

define bind with func, nm
  let locals be func at "locals"
  if has with locals, nm
    return locals at nm
  end
  let slot be func at "n"
  put slot into locals at nm
  put (slot + 1) into func at "n"
  return slot
end

define parseStmt with state, func
  if state at "bad"
    return ["none"]
  end
  let k be form with state
  if k == "let"
    bump with state
    if (form with state) != "name"
      return markBad with state, "let needs a name"
    end
    let nm be spell with state
    bump with state
    if (form with state) != "be"
      return markBad with state, "let needs be"
    end
    bump with state
    let expr be parseExpr with state, func
    let slot be bind with func, nm
    return ["let", slot, expr]
  end
  if k == "say"
    bump with state
    return ["say", parseExpr with state, func]
  end
  if k == "return"
    bump with state
    return ["return", parseExpr with state, func]
  end
  if k == "if"
    return parseIf with state, func, true
  end
  if k == "while"
    bump with state
    let test be parseExpr with state, func
    let body be parseLoop with state, func
    if (form with state) != "end"
      return markBad with state, "the program needs end"
    end
    bump with state
    return ["while", test, body]
  end
  if k == "for"
    bump with state
    if (form with state) != "name"
      return markBad with state, "for needs a name"
    end
    let nm be spell with state
    bump with state
    if (form with state) != "in"
      return markBad with state, "for needs in"
    end
    bump with state
    let seq be parseExpr with state, func
    let body be parseLoop with state, func
    if (form with state) != "end"
      return markBad with state, "the program needs end"
    end
    bump with state
    return ["for", (bind with func, nm), seq, body]
  end
  if k == "try"
    bump with state
    let body be parseBlock with state, func
    let caught be none
    let handler be none
    if (form with state) == "miss"
      bump with state
      if (form with state) == "name"
        let caught be bind with func, (spell with state)
        bump with state
      end
      let handler be parseBlock with state, func
    end
    if (form with state) != "end"
      return markBad with state, "the program needs end"
    end
    bump with state
    return ["try", body, caught, handler]
  end
  if k == "stop"
    bump with state
    return ["stop"]
  end
  if k == "skip"
    bump with state
    return ["skip"]
  end
  if k == "put"
    bump with state
    let val be parseExpr with state, func
    if (form with state) != "into"
      return markBad with state, "put needs into"
    end
    bump with state
    if (form with state) != "name"
      return markBad with state, "put needs a name"
    end
    let nm be spell with state
    bump with state
    if (form with state) != "at"
      return markBad with state, "put needs at"
    end
    bump with state
    let key be parseExpr with state, func
    if not (has with (func at "locals"), nm)
      return markBad with state, (nm + " has no value")
    end
    return ["put", (func at "locals") at nm, val, key]
  end
  if k == "else"
    return markBad with state, "that statement is not ready"
  end
  let expr be parseExpr with state, func
  if state at "bad"
    return ["none"]
  end
  if (expr at 0) == "call"
    return expr
  end
  if (expr at 0) == "name"
    let bare be []
    noteNeed with state, (expr at 1)
    return ["call", expr at 1, bare]
  end
  return markBad with state, "that statement is not ready"
end

define parseDefine with state
  bump with state
  if (form with state) != "name"
    return {"bad": true}
  end
  let nm be spell with state
  if nm == "read"
    markBad with state, "read is part of the language"
    return {"bad": true}
  end
  bump with state
  let params be []
  let locals be {}
  let n be 0
  if (form with state) == "with"
    bump with state
    if (form with state) != "name"
      markBad with state, "define needs a name"
      return {"bad": true}
    end
    push with params, (spell with state)
    put n into locals at (spell with state)
    let n be n + 1
    bump with state
    while (form with state) == ","
      bump with state
      if (form with state) != "name"
        markBad with state, "define needs a name"
        return {"bad": true}
      end
      if has with locals, (spell with state)
        markBad with state, "that name is already defined"
        return {"bad": true}
      end
      push with params, (spell with state)
      put n into locals at (spell with state)
      let n be n + 1
      bump with state
    end
  end
  let func be {"name": nm, "params": params, "nparams": n, "locals": locals, "n": n, "body": []}
  let body be parseBlock with state, func
  if state at "bad"
    return {"bad": true}
  end
  if (form with state) != "end"
    markBad with state, "the program needs end"
    return {"bad": true}
  end
  bump with state
  put body into func at "body"
  return func
end

define noteNeed with state, nm
  if nm == "listen"
    put true into state at "needNet"
  end
  if nm == "connect"
    put true into state at "needNet"
  end
  if nm == "send"
    put true into state at "needNet"
  end
  if nm == "recv"
    put true into state at "needNet"
  end
  if nm == "close"
    put true into state at "needNet"
  end
  if nm == "json"
    put true into state at "needJson"
  end
  if nm == "parse"
    put true into state at "needJson"
  end
  return true
end

define parseProgram with scanned
  let state be {"ks": scanned at "ks", "ss": scanned at "ss", "ns": scanned at "ns", "i": 0, "bad": false, "why": "", "needNet": false, "needJson": false}
  let funcs be []
  let uses be []
  let needs be []
  while (form with state) != "eof"
    if state at "bad"
      stop
    end
    if (form with state) == "use"
      bump with state
      if (form with state) != "text"
        markBad with state, "use needs a file name in quotes"
        stop
      end
      push with uses, (spell with state)
      bump with state
    end
    if (form with state) == "need"
      bump with state
      if (form with state) != "text"
        markBad with state, "need takes a package name in quotes"
        stop
      end
      push with needs, (spell with state)
      bump with state
    end
    if (form with state) != "use" and (form with state) != "need" and (form with state) != "eof"
      if (form with state) != "define"
        markBad with state, "a vire program needs define main"
        stop
      end
      let func be parseDefine with state
      if state at "bad"
        stop
      end
      let i be 0
      while i < (length with funcs)
        if ((funcs at i) at "name") == (func at "name")
          markBad with state, "that name is already defined"
          stop
        end
        let i be i + 1
      end
      push with funcs, func
    end
  end
  return {"bad": state at "bad", "why": state at "why", "funcs": funcs, "uses": uses, "needs": needs, "needNet": state at "needNet", "needJson": state at "needJson"}
end

define normPath with path
  let out be ""
  let i be 0
  let n be length with path
  while i < n
    let ch be path at i
    if ch == "\\"
      let out be out + "/"
    end
    if ch != "\\"
      let out be out + (lower with ch)
    end
    let i be i + 1
  end
  return out
end

define dirOf with path
  let flat be normPath with path
  let n be length with flat
  let i be n
  while i > 0
    let i be i - 1
    if (flat at i) == "/"
      return slice with flat, 0, i
    end
  end
  return ""
end

define joinRel with dir, rel
  let flat be normPath with rel
  if dir == ""
    return flat
  end
  return dir + "/" + flat
end

define baseName with path
  let flat be normPath with path
  let n be length with flat
  let i be n
  while i > 0
    let i be i - 1
    if (flat at i) == "/"
      return slice with flat, (i + 1), n
    end
  end
  return flat
end

define firstSeg with rel
  let flat be normPath with rel
  let n be length with flat
  let i be 0
  let seg be ""
  while i < n
    let ch be flat at i
    if ch == "/"
      stop
    end
    let seg be seg + ch
    let i be i + 1
  end
  return seg
end

define badSeg with rel
  let flat be normPath with rel
  if (find with flat, ":") >= 0
    return true
  end
  let n be length with flat
  let i be 0
  let seg be ""
  while i <= n
    let ch be ""
    if i < n
      let ch be flat at i
    end
    if i == n or ch == "/"
      if seg == "." or seg == ".."
        return true
      end
      let seg be ""
    end
    if i < n and ch != "/"
      let seg be seg + ch
    end
    let i be i + 1
  end
  return false
end

define isPackage with name
  if (length with name) == 0
    return false
  end
  let i be 0
  while i < (length with name)
    let ch be name at i
    if not (isLetter with ch) and not (isDigit with ch)
      return false
    end
    let i be i + 1
  end
  return true
end

define checkUse with rel
  if not (ends with (lower with rel), ".vire")
    return {"bad": true, "why": "use stays inside the program folder and only opens .vire files"}
  end
  if badSeg with rel
    return {"bad": true, "why": "files stay inside the program folder"}
  end
  let seg be lower with (firstSeg with rel)
  if seg == "data" or seg == "site"
    return {"bad": true, "why": "use stays out of data and site"}
  end
  return {"bad": false, "why": ""}
end

define stackCount with seen
  let n be 0
  let ks be keys with seen
  let i be 0
  while i < (length with ks)
    if (seen at (ks at i)) == 1
      let n be n + 1
    end
    let i be i + 1
  end
  return n
end

define mergeFuncs with funcs, extra
  let i be 0
  while i < (length with extra)
    let item be extra at i
    let j be 0
    while j < (length with funcs)
      if ((funcs at j) at "name") == (item at "name")
        return {"bad": true, "why": ((item at "name") + " is already defined"), "funcs": funcs}
      end
      let j be j + 1
    end
    push with funcs, item
    let i be i + 1
  end
  return {"bad": false, "why": "", "funcs": funcs}
end

define underZone with folder, path
  let base be lower with (normPath with folder)
  let full be lower with (normPath with path)
  if not (begins with full, base)
    return false
  end
  let rest be slice with full, (length with base), (length with full)
  if begins with rest, "/"
    let rest be slice with rest, 1, (length with rest)
  end
  if rest == "data" or (begins with rest, "data/")
    return true
  end
  if rest == "site" or (begins with rest, "site/")
    return true
  end
  return false
end

define sameHex with left, right
  let diff be 0
  if not ((length with left) == 64)
    let diff be 1
  end
  if not ((length with right) == 64)
    let diff be 1
  end
  let i be 0
  while i < 64
    let a be ""
    let b be ""
    if i < (length with left)
      let a be left at i
    end
    if i < (length with right)
      let b be right at i
    end
    if not (a == b)
      let diff be 1
    end
    let i be i + 1
  end
  return diff == 0
end

define lockLine with text, pkg
  let lines be split with text, "\n"
  let i be 0
  let found be ""
  while i < (length with lines)
    let line be lines at i
    let n be length with line
    if n > 0
      if (line at (n - 1)) == "\r"
        let line be slice with line, 0, (n - 1)
      end
    end
    if not (line == "")
      let parts be split with line, " "
      if not ((length with parts) == 2)
        return {"bad": true, "why": "deps.lock is damaged", "hex": ""}
      end
      if (parts at 0) == pkg
        let found be parts at 1
      end
    end
    let i be i + 1
  end
  if found == ""
    return {"bad": true, "why": ("deps.lock does not name " + pkg), "hex": ""}
  end
  return {"bad": false, "why": "", "hex": found}
end

define loadUnit with path, folder, seen
  let source be ""
  let missing be false
  try
    let source be read with path
  miss problem
    let missing be true
  end
  if missing
    return {"bad": true, "why": ("could not read " + (baseName with path)), "funcs": [], "needNet": false, "needJson": false}
  end
  return loadText with path, source, folder, seen
end

define loadText with path, source, folder, seen
  let key be normPath with path
  if (stackCount with seen) > 32
    return {"bad": true, "why": "too many files were used", "funcs": []}
  end
  if has with seen, key
    if (seen at key) == 1
      return {"bad": true, "why": ("use went in a circle at " + (baseName with path)), "funcs": []}
    end
  end
  put 1 into seen at key
  let scanned be tokenize with source
  if scanned at "bad"
    put 0 into seen at key
    return {"bad": true, "why": scanned at "why", "funcs": []}
  end
  let parsed be parseProgram with scanned
  if parsed at "bad"
    put 0 into seen at key
    return {"bad": true, "why": parsed at "why", "funcs": []}
  end
  let funcs be parsed at "funcs"
  let uses be parsed at "uses"
  let needNet be parsed at "needNet"
  let needJson be parsed at "needJson"
  let ui be 0
  while ui < (length with uses)
    let rel be uses at ui
    let checked be checkUse with rel
    if checked at "bad"
      put 0 into seen at key
      return {"bad": true, "why": checked at "why", "funcs": []}
    end
    let next be joinRel with folder, rel
    if underZone with folder, next
      put 0 into seen at key
      return {"bad": true, "why": "use stays out of data and site", "funcs": []}
    end
    let extra be loadUnit with next, folder, seen
    if extra at "bad"
      put 0 into seen at key
      return extra
    end
    let merged be mergeFuncs with funcs, (extra at "funcs")
    if merged at "bad"
      put 0 into seen at key
      return {"bad": true, "why": merged at "why", "funcs": funcs}
    end
    let funcs be merged at "funcs"
    if extra at "needNet"
      let needNet be true
    end
    if extra at "needJson"
      let needJson be true
    end
    let ui be ui + 1
  end
  let needs be parsed at "needs"
  let ni be 0
  while ni < (length with needs)
    let pkg be needs at ni
    if not (isPackage with pkg)
      put 0 into seen at key
      return {"bad": true, "why": "package names are plain words", "funcs": []}
    end
    let next be joinRel with folder, ("deps/" + pkg + "/lib.vire")
    let lockPath be joinRel with folder, "deps.lock"
    let lockText be ""
    let missingLock be false
    try
      let lockText be read with lockPath
    miss problem
      let missingLock be true
    end
    if missingLock
      put 0 into seen at key
      return {"bad": true, "why": "deps.lock is required", "funcs": []}
    end
    let locked be lockLine with lockText, pkg
    if locked at "bad"
      put 0 into seen at key
      return {"bad": true, "why": locked at "why", "funcs": []}
    end
    let body be ""
    let missingLib be false
    try
      let body be read with next
    miss problem
      let missingLib be true
    end
    if missingLib
      put 0 into seen at key
      return {"bad": true, "why": "could not read lib.vire", "funcs": []}
    end
    let pinned be body
    if not (sameHex with (hash with pinned), (locked at "hex"))
      put 0 into seen at key
      return {"bad": true, "why": ("deps.lock does not match " + pkg), "funcs": []}
    end
    let extra be loadText with next, pinned, folder, seen
    if extra at "bad"
      put 0 into seen at key
      return extra
    end
    let merged be mergeFuncs with funcs, (extra at "funcs")
    if merged at "bad"
      put 0 into seen at key
      return {"bad": true, "why": merged at "why", "funcs": funcs}
    end
    let funcs be merged at "funcs"
    if extra at "needNet"
      let needNet be true
    end
    if extra at "needJson"
      let needJson be true
    end
    let ni be ni + 1
  end
  put 0 into seen at key
  return {"bad": false, "why": "", "funcs": funcs, "needNet": needNet, "needJson": needJson}
end

define emitOp with gen, bytes
  put (emitList with (gen at "image"), bytes) into gen at "image"
  return true
end

define emitFix with gen, name
  ~ Runtime labels from emitRuntime/emitMore are pinned before user code.
  ~ Net/JSON packed labels land later in emitNetRuntime — those stay deferred.
  ~ Patch the early rt_* rel32s now so `fixes` stays under the 100000 cap.
  let later be false
  if begins with name, "rt_net"
    let later be true
  end
  if begins with name, "rt_json"
    let later be true
  end
  if name == "rt_listen" or name == "rt_connect" or name == "rt_send" or name == "rt_recv" or name == "rt_close" or name == "rt_parse"
    let later be true
  end
  if (begins with name, "rt_") and (later == false)
    let buf be gen at "image"
    let pos be length with buf
    put (emitU32 with buf, (((gen at "labels") at name) - (pos + 4))) into gen at "image"
    return true
  end
  put (emitRel with (gen at "image"), (gen at "fixes"), name) into gen at "image"
  return true
end

define emitCall with gen, name
  put (emitU8 with (gen at "image"), 232) into gen at "image"
  emitFix with gen, name
  return true
end

define emitJmp with gen, name
  put (emitU8 with (gen at "image"), 233) into gen at "image"
  emitFix with gen, name
  return true
end

define emitLeaRcx with gen, name
  emitOp with gen, [72, 141, 13]
  emitFix with gen, name
  return true
end

define saveTrap with gen
  let slot be freshCounter with gen
  emitLeaRcx with gen, slot
  emitCall with gen, "rt_trap_save"
  return slot
end

define restoreTrap with gen, slot
  emitLeaRcx with gen, slot
  emitCall with gen, "rt_trap_restore"
  return true
end

define emitJz with gen, name
  emitOp with gen, [15, 132]
  emitFix with gen, name
  return true
end

define pinHere with gen, name
  pin with (gen at "labels"), name, (gen at "image")
  return true
end

define fresh with gen
  let n be gen at "j"
  put (n + 1) into gen at "j"
  return "j" + (text with n)
end

define pool with gen, raw
  let i be 0
  let n be length with raw
  while i < n
    if (codeOf with (raw at i)) < 0
      put true into gen at "bad"
      put "that text cannot be written yet" into gen at "why"
      return ""
    end
    let i be i + 1
  end
  let id be gen at "s"
  put (id + 1) into gen at "s"
  let name be "s" + (text with id)
  push with (gen at "pool"), {"name": name, "raw": raw}
  return name
end

define findFunc with funcs, nm
  let i be 0
  let n be length with funcs
  while i < n
    if ((funcs at i) at "name") == nm
      return {"ok": true, "func": funcs at i}
    end
    let i be i + 1
  end
  return {"ok": false}
end

define emitBoolAcc with gen
  emitOp with gen, [137, 193]
  emitCall with gen, "rt_push_bool"
  return true
end

define builtinArity with nm
  if nm == "args" or nm == "ticks" or nm == "linux"
    return 0
  end
  if nm == "length" or nm == "text" or nm == "number" or nm == "halt" or nm == "read" or nm == "lower" or nm == "keys" or nm == "drop" or nm == "hash" or nm == "hex" or nm == "shl8" or nm == "chr" or nm == "json" or nm == "parse" or nm == "listen"
    return 1
  end
  if nm == "close"
    return 1
  end
  if nm == "push" or nm == "find" or nm == "has" or nm == "write" or nm == "begins" or nm == "ends" or nm == "split" or nm == "idiv" or nm == "join" or nm == "extend"
    return 2
  end
  if nm == "connect" or nm == "send" or nm == "recv"
    return 2
  end
  if nm == "slice" or nm == "replace"
    return 3
  end
  return -1
end

define freshCounter with gen
  let n be gen at "c"
  put (n + 1) into gen at "c"
  let name be "ctr" + (text with n)
  push with (gen at "counters"), name
  return name
end

define parkCounters with image, labels, counters
  ~ Must run after parkRuntime so these u64 slots land in .data (RW).
  ~ while/for save trap_sp here; RX .text makes that ACCESS_VIOLATION.
  ~ String pool has the same rule: path_walk used to write NULs into literals.
  let i be 0
  let n be length with counters
  while i < n
    pin with labels, (counters at i), image
    let image be emitU64 with image, 0
    let i be i + 1
  end
  return image
end

define jumpLoop with gen, word, edge
  let stack be gen at "breaks"
  if (length with stack) == 0
    put true into gen at "bad"
    put (word + " is only valid inside while or for") into gen at "why"
    return true
  end
  let frame be stack at ((length with stack) - 1)
  emitJmp with gen, (frame at edge)
  return true
end

define emitAtom with gen, funcs, func, expr
  if gen at "bad"
    return true
  end
  let k be expr at 0
  if k == "num"
    emitOp with gen, [72, 185]
    put (emitU64 with (gen at "image"), (expr at 1)) into gen at "image"
    emitCall with gen, "rt_push_int"
    return true
  end
  if k == "text"
    let name be pool with gen, (expr at 1)
    if gen at "bad"
      return true
    end
    emitOp with gen, [72, 141, 13]
    emitFix with gen, name
    emitCall with gen, "rt_push_text"
    return true
  end
  if k == "bool"
    put (emitU8 with (gen at "image"), 185) into gen at "image"
    put (emitU32 with (gen at "image"), (expr at 1)) into gen at "image"
    emitCall with gen, "rt_push_bool"
    return true
  end
  if k == "none"
    emitCall with gen, "rt_push_none"
    return true
  end
  if k == "name"
    let nm be expr at 1
    if has with (func at "locals"), nm
      put (emitU8 with (gen at "image"), 185) into gen at "image"
      put (emitU32 with (gen at "image"), ((func at "locals") at nm)) into gen at "image"
      emitCall with gen, "rt_load"
      return true
    end
    if nm == "args"
      emitCall with gen, "rt_args"
      return true
    end
    if nm == "bytes"
      emitCall with gen, "rt_bytes"
      return true
    end
    if nm == "ticks"
      emitCall with gen, "rt_ticks"
      return true
    end
    if nm == "linux"
      emitCall with gen, "rt_linux"
      return true
    end
    let found be findFunc with funcs, nm
    if found at "ok"
      if ((found at "func") at "nparams") == 0
        emitCall with gen, "rt_save_frame"
        emitCall with gen, ("fn_" + nm)
        emitCall with gen, "rt_restore_frame"
        return true
      end
    end
    put true into gen at "bad"
    put (nm + " has no value") into gen at "why"
    return true
  end
  put true into gen at "bad"
  put "that expression is not ready" into gen at "why"
  return true
end

define emitExpr with gen, funcs, func, root
  if gen at "bad"
    return true
  end
  let stack be []
  push with stack, {"e": root, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
  while (length with stack) > 0
    if gen at "bad"
      stop
    end
    let si be (length with stack) - 1
    let fr be stack at si
    let expr be fr at "e"
    let p be fr at "p"
    let k be expr at 0
    if k == "num" or k == "text" or k == "bool" or k == "none" or k == "name"
      emitAtom with gen, funcs, func, expr
      drop with stack
    end
    if k == "not" or k == "neg"
      if p == 0
        put 1 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 1, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 1
        if k == "not"
          emitCall with gen, "rt_not"
        end
        if k == "neg"
          emitCall with gen, "rt_neg"
        end
        drop with stack
      end
    end
    if k == "call"
      let nm be expr at 1
      let args be expr at 2
      let arity be builtinArity with nm
      let user be 0
      if arity < 0
        let user be 1
        let found be findFunc with funcs, nm
        if not (found at "ok")
          put true into gen at "bad"
          put ("there is no definition named " + nm) into gen at "why"
          stop
        end
        if ((found at "func") at "nparams") != (length with args)
          put true into gen at "bad"
          put (nm + " takes " + (text with ((found at "func") at "nparams")) + " values, got " + (text with (length with args))) into gen at "why"
          stop
        end
      end
      if arity >= 0
        if (length with args) != arity
          put true into gen at "bad"
          put (nm + " takes " + (text with arity) + " values, got " + (text with (length with args))) into gen at "why"
          stop
        end
      end
      if p == 0
        if user == 1
          emitCall with gen, "rt_save_frame"
        end
        put 1 into fr at "p"
        put 0 into fr at "i"
        put fr into stack at si
      end
      if p == 1
        let i be fr at "i"
        if i < (length with args)
          put (i + 1) into fr at "i"
          put fr into stack at si
          push with stack, {"e": args at i, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
        end
        if i >= (length with args)
          if user == 0
            if nm == "drop"
              emitCall with gen, "rt_list_drop"
            end
            if nm != "drop"
              emitCall with gen, ("rt_" + nm)
            end
          end
          if user == 1
            emitCall with gen, ("fn_" + nm)
            emitCall with gen, "rt_restore_frame"
          end
          drop with stack
        end
      end
    end
    if k == "and"
      if p == 0
        let no be fresh with gen
        let done be fresh with gen
        put no into fr at "no"
        put done into fr at "done"
        put 1 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 1, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 1
        emitCall with gen, "rt_truth"
        emitOp with gen, [133, 192]
        emitJz with gen, (fr at "no")
        put 2 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 2, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 2
        emitCall with gen, "rt_truth"
        emitBoolAcc with gen
        emitJmp with gen, (fr at "done")
        pinHere with gen, (fr at "no")
        put (emitU8 with (gen at "image"), 185) into gen at "image"
        put (emitU32 with (gen at "image"), 0) into gen at "image"
        emitCall with gen, "rt_push_bool"
        pinHere with gen, (fr at "done")
        drop with stack
      end
    end
    if k == "or"
      if p == 0
        let yes be fresh with gen
        let done be fresh with gen
        put yes into fr at "yes"
        put done into fr at "done"
        put 1 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 1, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 1
        emitCall with gen, "rt_truth"
        emitOp with gen, [133, 192]
        put (emitU8 with (gen at "image"), 15) into gen at "image"
        put (emitU8 with (gen at "image"), 133) into gen at "image"
        emitFix with gen, (fr at "yes")
        put 2 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 2, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 2
        emitCall with gen, "rt_truth"
        emitBoolAcc with gen
        emitJmp with gen, (fr at "done")
        pinHere with gen, (fr at "yes")
        put (emitU8 with (gen at "image"), 185) into gen at "image"
        put (emitU32 with (gen at "image"), 1) into gen at "image"
        emitCall with gen, "rt_push_bool"
        pinHere with gen, (fr at "done")
        drop with stack
      end
    end
    if k == "==" or k == "!=" or k == "<" or k == "<=" or k == ">" or k == ">=" or k == "+" or k == "-" or k == "*" or k == "/" or k == "%" or k == "at"
      if p == 0
        put 1 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 1, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 1
        put 2 into fr at "p"
        put fr into stack at si
        push with stack, {"e": expr at 2, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 2
        if k == "==" or k == "!=" or k == "<" or k == "<=" or k == ">" or k == ">="
          let op be 0
          if k == "!="
            let op be 1
          end
          if k == "<"
            let op be 2
          end
          if k == "<="
            let op be 3
          end
          if k == ">"
            let op be 4
          end
          if k == ">="
            let op be 5
          end
          put (emitU8 with (gen at "image"), 185) into gen at "image"
          put (emitU32 with (gen at "image"), op) into gen at "image"
          emitCall with gen, "rt_cmp"
        end
        if k == "+"
          emitCall with gen, "rt_add"
        end
        if k == "-"
          emitCall with gen, "rt_sub"
        end
        if k == "*"
          emitCall with gen, "rt_mul"
        end
        if k == "/"
          emitCall with gen, "rt_div"
        end
        if k == "%"
          emitCall with gen, "rt_mod"
        end
        if k == "at"
          emitCall with gen, "rt_at"
        end
        drop with stack
      end
    end
    if k == "list"
      if p == 0
        emitCall with gen, "rt_list_new"
        put 1 into fr at "p"
        put 0 into fr at "i"
        put fr into stack at si
      end
      if p == 1
        let items be expr at 1
        let i be fr at "i"
        if i < (length with items)
          put 2 into fr at "p"
          put fr into stack at si
          push with stack, {"e": items at i, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
        end
        if i >= (length with items)
          drop with stack
        end
      end
      if p == 2
        emitCall with gen, "rt_push"
        put 1 into fr at "p"
        put ((fr at "i") + 1) into fr at "i"
        put fr into stack at si
      end
    end
    if k == "map"
      if p == 0
        emitCall with gen, "rt_map_new"
        put 1 into fr at "p"
        put 0 into fr at "i"
        put fr into stack at si
      end
      if p == 1
        let pairs be expr at 1
        let i be fr at "i"
        if i < (length with pairs)
          put 2 into fr at "p"
          put fr into stack at si
          push with stack, {"e": (pairs at i) at 1, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
        end
        if i >= (length with pairs)
          drop with stack
        end
      end
      if p == 2
        put 3 into fr at "p"
        put fr into stack at si
        let pair be (expr at 1) at (fr at "i")
        push with stack, {"e": pair at 2, "p": 0, "i": 0, "no": "", "yes": "", "done": ""}
      end
      if p == 3
        emitCall with gen, "rt_map_put"
        put 1 into fr at "p"
        put ((fr at "i") + 1) into fr at "i"
        put fr into stack at si
      end
    end
  end
  return true
end

define emitBlock with gen, funcs, func, body
  let i be 0
  while i < (length with body)
    emitStmt with gen, funcs, func, (body at i)
    let i be i + 1
  end
  return true
end

define emitStmt with gen, funcs, func, stmt
  if gen at "bad"
    return true
  end
  let k be stmt at 0
  if k == "let"
    emitExpr with gen, funcs, func, (stmt at 2)
    put (emitU8 with (gen at "image"), 185) into gen at "image"
    put (emitU32 with (gen at "image"), (stmt at 1)) into gen at "image"
    emitCall with gen, "rt_store"
    return true
  end
  if k == "say"
    emitExpr with gen, funcs, func, (stmt at 1)
    emitCall with gen, "rt_say"
    return true
  end
  if k == "return"
    emitExpr with gen, funcs, func, (stmt at 1)
    emitCall with gen, "rt_return"
    emitOp with gen, [72, 131, 196, 40, 195]
    return true
  end
  if k == "if"
    let no be fresh with gen
    let done be fresh with gen
    emitExpr with gen, funcs, func, (stmt at 1)
    emitCall with gen, "rt_truth"
    emitOp with gen, [133, 192]
    emitJz with gen, no
    emitBlock with gen, funcs, func, (stmt at 2)
    emitJmp with gen, done
    pinHere with gen, no
    emitBlock with gen, funcs, func, (stmt at 3)
    pinHere with gen, done
    return true
  end
  if k == "while"
    let head be fresh with gen
    let done be fresh with gen
    let ctr be freshCounter with gen
    let guard be saveTrap with gen
    push with (gen at "breaks"), {"head": head, "done": done}
    pinHere with gen, head
    restoreTrap with gen, guard
    emitExpr with gen, funcs, func, (stmt at 1)
    emitCall with gen, "rt_truth"
    emitOp with gen, [133, 192]
    emitJz with gen, done
    emitOp with gen, [72, 141, 13]
    emitFix with gen, ctr
    emitCall with gen, "rt_loop_tick"
    emitBlock with gen, funcs, func, (stmt at 2)
    emitJmp with gen, head
    pinHere with gen, done
    restoreTrap with gen, guard
    drop with (gen at "breaks")
    return true
  end
  if k == "for"
    let head be fresh with gen
    let done be fresh with gen
    let ctr be freshCounter with gen
    emitExpr with gen, funcs, func, (stmt at 2)
    emitCall with gen, "rt_for_prep"
    let guard be saveTrap with gen
    push with (gen at "breaks"), {"head": head, "done": done}
    pinHere with gen, head
    restoreTrap with gen, guard
    emitCall with gen, "rt_for_more"
    emitOp with gen, [133, 192]
    emitJz with gen, done
    put (emitU8 with (gen at "image"), 185) into gen at "image"
    put (emitU32 with (gen at "image"), (stmt at 1)) into gen at "image"
    emitCall with gen, "rt_store"
    emitOp with gen, [72, 141, 13]
    emitFix with gen, ctr
    emitCall with gen, "rt_loop_tick"
    emitBlock with gen, funcs, func, (stmt at 3)
    emitJmp with gen, head
    pinHere with gen, done
    restoreTrap with gen, guard
    emitCall with gen, "rt_for_drop"
    drop with (gen at "breaks")
    return true
  end
  if k == "try"
    if (stmt at 3) == none
      emitBlock with gen, funcs, func, (stmt at 1)
      return true
    end
    let landed be fresh with gen
    let done be fresh with gen
    emitLeaRcx with gen, landed
    emitCall with gen, "rt_trap_push"
    emitBlock with gen, funcs, func, (stmt at 1)
    emitCall with gen, "rt_trap_pop"
    emitJmp with gen, done
    pinHere with gen, landed
    if (stmt at 2) == none
      emitCall with gen, "rt_drop"
    end
    if (stmt at 2) != none
      put (emitU8 with (gen at "image"), 185) into gen at "image"
      put (emitU32 with (gen at "image"), (stmt at 2)) into gen at "image"
      emitCall with gen, "rt_store"
    end
    emitBlock with gen, funcs, func, (stmt at 3)
    pinHere with gen, done
    return true
  end
  if k == "stop"
    jumpLoop with gen, "stop", "done"
    return true
  end
  if k == "skip"
    jumpLoop with gen, "skip", "head"
    return true
  end
  if k == "put"
    emitExpr with gen, funcs, func, (stmt at 2)
    emitExpr with gen, funcs, func, (stmt at 3)
    put (emitU8 with (gen at "image"), 185) into gen at "image"
    put (emitU32 with (gen at "image"), (stmt at 1)) into gen at "image"
    emitCall with gen, "rt_set_slot"
    return true
  end
  if k == "call"
    emitExpr with gen, funcs, func, stmt
    emitCall with gen, "rt_drop"
    return true
  end
  put true into gen at "bad"
  put "that statement is not ready" into gen at "why"
  return true
end

define emitFunc with gen, funcs, func
  pinHere with gen, ("fn_" + (func at "name"))
  emitOp with gen, [72, 131, 236, 40]
  put (emitU8 with (gen at "image"), 185) into gen at "image"
  put (emitU32 with (gen at "image"), (func at "nparams")) into gen at "image"
  put (emitU8 with (gen at "image"), 186) into gen at "image"
  put (emitU32 with (gen at "image"), ((func at "n") - (func at "nparams"))) into gen at "image"
  emitCall with gen, "rt_begin"
  emitBlock with gen, funcs, func, (func at "body")
  emitCall with gen, "rt_push_none"
  emitCall with gen, "rt_return"
  emitOp with gen, [72, 131, 196, 40, 195]
  return true
end

define main
  let files be args
  say "go"
  if (length with files) < 2
    say "usage: compile-native source.vire out.hex"
    say "compile failed"
    halt with 1
  end
  let loaded be loadUnit with (files at 0), (dirOf with (files at 0)), {}
  say "loaded"
  if loaded at "bad"
    say loaded at "why"
    say "compile failed"
    halt with 1
  end
  let funcs be loaded at "funcs"
  let saw be false
  let i be 0
  while i < (length with funcs)
    if ((funcs at i) at "name") == "main"
      let saw be true
    end
    let i be i + 1
  end
  if not saw
    say "a vire program needs define main"
    say "compile failed"
    halt with 1
  end
  let hits be {"net": loaded at "needNet", "json": loaded at "needJson"}
  say "needs-ok"
  let wantElf be linux
  if (length with files) > 2
    if (files at 2) == "pe"
      let wantElf be false
    end
    if (files at 2) == "elf"
      let wantElf be true
    end
  end
  let opened be openImage
  if wantElf
    let opened be openElfImage
  end
  if hits at "net"
    let opened be openNetImage
    if wantElf
      let opened be openElfNetImage
    end
  end
  let gen be {"image": opened at "image", "labels": opened at "labels", "fixes": opened at "fixes", "pool": [], "j": 0, "s": 0, "breaks": [], "counters": [], "c": 0, "bad": false, "why": ""}
  let i be 0
  let hasRoute be false
  while i < (length with funcs)
    emitFunc with gen, funcs, (funcs at i)
    if ((funcs at i) at "name") == "route"
      if ((funcs at i) at "nparams") == 3
        let hasRoute be true
      end
    end
    let i be i + 1
  end
  if hits at "net"
    if not hasRoute
      pinHere with gen, "fn_route"
      emitOp with gen, [72, 131, 236, 40]
      emitCall with gen, "rt_push_none"
      emitCall with gen, "rt_return"
      emitOp with gen, [72, 131, 196, 40, 195]
    end
  end
  say "emitted"
  if gen at "bad"
    say gen at "why"
    say "compile failed"
    halt with 1
  end
  if (hits at "net") or (hits at "json")
    put (emitNetRuntime with (gen at "image"), (gen at "fixes"), (gen at "labels"), hasRoute, (hits at "net")) into gen at "image"
  end
  put (parkRuntime with (gen at "image"), (gen at "labels")) into gen at "image"
  ~ Pool strings must follow frame_base so they land in RW .data, not RX .text.
  put (parkPool with (gen at "image"), (gen at "labels"), (gen at "pool")) into gen at "image"
  if (hits at "net") or (hits at "json")
    put (parkNet with (gen at "image"), (gen at "labels")) into gen at "image"
  end
  put (parkCounters with (gen at "image"), (gen at "labels"), (gen at "counters")) into gen at "image"
  if wantElf
    put (finishElfImage with (gen at "image"), (gen at "labels"), (gen at "fixes"), (opened at "iats")) into gen at "image"
    let exe be buildElf with (gen at "image"), ((gen at "labels") at "linux_start"), ((gen at "labels") at "frame_base")
    write with (files at 1), (hex with exe)
    say "compiled"
    return none
  end
  put (finishImage with (gen at "image"), (gen at "labels"), (gen at "fixes"), (opened at "hints"), (opened at "ilts"), (opened at "iats")) into gen at "image"
  let exe be buildPe with (gen at "image"), ((gen at "labels") at "code"), ((gen at "labels") at "desc"), ((gen at "labels") at "frame_base"), (opened at "impSize")
  write with (files at 1), (hex with exe)
  say "compiled"
end

