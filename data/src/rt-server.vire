~ Native listen multiplexer: select, socket timeouts, per-request budget reset.
~ Declared by calling listen (server capability). Caps stay 32MB / 100000 / 5M.

define emitServerRuntime with image, fixes, labels
  ~ Packed rt_net_client ctx and recv buf allocs are leaf-tagged here.
  ~ Packed fixes 0x527 and 0x56f use netNames id rt_alloc_leaf.
  ~ Do not write labels-at-plus; native gen2 cannot parse that.
  pin with labels, "rt_alloc_leaf", image
  emitList with image, [72, 131, 236, 40]
  emitCallTo with image, fixes, "rt_alloc"
  emitLeaf with image
  emitList with image, [72, 131, 196, 40, 195]

  pin with labels, "rt_sock_timeouts", image
  emitPro with image
  emitList with image, [72, 137, 77, 248, 199, 69, 240]
  emitU32 with image, 5000
  emitList with image, [139, 77, 248, 186, 255, 255, 0, 0, 65, 184]
  emitU32 with image, 4102
  emitList with image, [76, 141, 77, 240, 199, 68, 36, 32, 4, 0, 0, 0]
  let image be emitIat with image, fixes, "iat_ss"
  emitList with image, [139, 77, 248, 186, 255, 255, 0, 0, 65, 184]
  emitU32 with image, 4101
  emitList with image, [76, 141, 77, 240, 199, 68, 36, 32, 4, 0, 0, 0]
  let image be emitIat with image, fixes, "iat_ss"
  emitEpi with image

  pin with labels, "rt_server_reset", image
  emitList with image, [72, 141, 5]
  emitRel with image, fixes, "wait_cell"
  emitList with image, [72, 199, 0]
  emitU32 with image, 1
  emitList with image, [72, 141, 5]
  emitRel with image, fixes, "step_cell"
  emitList with image, [72, 199, 0]
  emitU32 with image, 0
  emitList with image, [195]

  pin with labels, "rt_step", image
  emitList with image, [72, 139, 5]
  emitRel with image, fixes, "server_cap"
  emitList with image, [72, 133, 192, 15, 132]
  emitRel with image, fixes, "step_skip"
  emitList with image, [72, 141, 5]
  emitRel with image, fixes, "step_cell"
  emitList with image, [72, 255, 0, 72, 129, 56]
  emitU32 with image, 5000000
  emitJcc with image, fixes, 135, "step_fail"
  pin with labels, "step_skip", image
  emitList with image, [195]
  pin with labels, "step_fail", image
  emitFail with image, fixes, "msg_step"
  return emitListenMux with image, fixes, labels
end

