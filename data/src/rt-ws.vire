use "src/rt-sha1.vire"

~ Guest WebSocket (RFC 6455) plus native PE rt_ws_listen.
~ Loopback 127.0.0.1 only. No TLS / wss. No permessage-deflate.
~ Client frames must be masked. Control frames <= 125 and not fragmented.

define ws_ascii_table
  return " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
end

define ws_ascii_code with ch
  if ch == "\n"
    return 10
  end
  if ch == "\r"
    return 13
  end
  if ch == "\t"
    return 9
  end
  let p be find with (ws_ascii_table), ch
  if p < 0
    return -1
  end
  return p + 32
end

define ws_ascii_bytes with text
  let out be []
  let i be 0
  let n be length with text
  while i < n
    let c be ws_ascii_code with (text at i)
    if c < 0
      return ["bad", "non-ascii"]
    end
    push with out, c
    let i be i + 1
  end
  return ["ok", out]
end

define ws_ascii_text with buf
  let table be ws_ascii_table
  let out be ""
  let i be 0
  let n be length with buf
  while i < n
    let b be buf at i
    if b == 10
      let out be out + "\n"
    end
    if b == 13
      let out be out + "\r"
    end
    if b == 9
      let out be out + "\t"
    end
    if b < 32
      if b != 10
        if b != 13
          if b != 9
            return ["bad", "non-ascii"]
          end
        end
      end
    end
    if b > 126
      return ["bad", "non-ascii"]
    end
    if b >= 32
      if b <= 126
        let out be out + (table at (b - 32))
      end
    end
    let i be i + 1
  end
  return ["ok", out]
end

define ws_b64_table
  return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
end

define ws_b64_encode with buf
  let table be ws_b64_table
  let out be ""
  let n be length with buf
  let i be 0
  while i < n
    let b0 be buf at i
    let b1 be 0
    let b2 be 0
    let got be 1
    if (i + 1) < n
      let b1 be buf at (i + 1)
      let got be 2
    end
    if (i + 2) < n
      let b2 be buf at (i + 2)
      let got be 3
    end
    let n0 be idiv with b0, 4
    let n1 be ((b0 % 4) * 16) + (idiv with b1, 16)
    let n2 be ((b1 % 16) * 4) + (idiv with b2, 64)
    let n3 be b2 % 64
    let out be out + (table at n0)
    let out be out + (table at n1)
    if got == 1
      let out be out + "=="
    end
    if got == 2
      let out be out + (table at n2)
      let out be out + "="
    end
    if got == 3
      let out be out + (table at n2)
      let out be out + (table at n3)
    end
    let i be i + 3
  end
  return out
end

define ws_guid
  return "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
end

define ws_accept_key with key
  let raw be ws_ascii_bytes with (key + (ws_guid))
  if (raw at 0) == "bad"
    return ["bad", "non-ascii key"]
  end
  let dig be sha1_bytes with (raw at 1)
  return ["ok", (ws_b64_encode with dig)]
end

define ws_rfc_accept_example
  let got be ws_accept_key with "dGhlIHNhbXBsZSBub25jZQ=="
  if (got at 0) == "bad"
    return got
  end
  if (got at 1) != "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
    return ["bad", ("want s3pPLMBiTxaQ9kYGzzhZRbK+xOo= got " + (got at 1))]
  end
  return ["ok", (got at 1)]
end

define ws_utf8_cont with b
  if b < 128
    return false
  end
  if b > 191
    return false
  end
  return true
end

define ws_utf8_ok with buf
  let n be length with buf
  let i be 0
  while i < n
    let b be buf at i
    if b < 0
      return false
    end
    if b > 255
      return false
    end
    if b < 128
      let i be i + 1
      skip
    end
    if b < 194
      return false
    end
    if b < 224
      if (i + 1) >= n
        return false
      end
      if not (ws_utf8_cont with (buf at (i + 1)))
        return false
      end
      let i be i + 2
      skip
    end
    if b < 240
      if (i + 2) >= n
        return false
      end
      let c1 be buf at (i + 1)
      let c2 be buf at (i + 2)
      if not (ws_utf8_cont with c1)
        return false
      end
      if not (ws_utf8_cont with c2)
        return false
      end
      if b == 224
        if c1 < 160
          return false
        end
      end
      if b == 237
        if c1 > 159
          return false
        end
      end
      let i be i + 3
      skip
    end
    if b > 244
      return false
    end
    if (i + 3) >= n
      return false
    end
    let c1 be buf at (i + 1)
    let c2 be buf at (i + 2)
    let c3 be buf at (i + 3)
    if not (ws_utf8_cont with c1)
      return false
    end
    if not (ws_utf8_cont with c2)
      return false
    end
    if not (ws_utf8_cont with c3)
      return false
    end
    if b == 240
      if c1 < 144
        return false
      end
    end
    if b == 244
      if c1 > 143
        return false
      end
    end
    let i be i + 4
  end
  return true
end

define ws_be16 with buf, i
  return ((buf at i) * 256) + (buf at (i + 1))
end

define ws_be32 with buf, i
  return (((buf at i) * 16777216) + ((buf at (i + 1)) * 65536)) + (((buf at (i + 2)) * 256) + (buf at (i + 3)))
end

define ws_mask_apply with buf, start, n, key
  let i be 0
  while i < n
    let p be start + i
    let k be key at (i % 4)
    let v be buf at p
    let x be 0
    let p2 be 1
    let a be v
    let b be k
    let bit be 0
    while bit < 8
      if (a % 2) != (b % 2)
        let x be x + p2
      end
      let a be idiv with a, 2
      let b be idiv with b, 2
      let p2 be p2 + p2
      let bit be bit + 1
    end
    put x into buf at p
    let i be i + 1
  end
  return buf
end

define ws_max_payload
  return 65536
end

define ws_parse_frame with buf
  let n be length with buf
  if n < 2
    return ["bad", "short"]
  end
  let b0 be buf at 0
  let b1 be buf at 1
  let fin be idiv with b0, 128
  let rsv be (idiv with b0, 16) % 8
  let op be b0 % 16
  let masked be idiv with b1, 128
  let len7 be b1 % 128
  if rsv != 0
    return ["bad", "reserved"]
  end
  if (op != 0) and (op != 1) and (op != 2) and (op != 8) and (op != 9) and (op != 10)
    return ["bad", "opcode"]
  end
  if masked != 1
    return ["bad", "unmasked"]
  end
  let extra be 2
  let plen be len7
  if len7 == 126
    if n < 4
      return ["bad", "short"]
    end
    let plen be ws_be16 with buf, 2
    let extra be 4
  end
  if len7 == 127
    if n < 10
      return ["bad", "short"]
    end
    if (ws_be32 with buf, 2) != 0
      return ["bad", "len64"]
    end
    let plen be ws_be32 with buf, 6
    if plen < 0
      return ["bad", "len64"]
    end
    let extra be 10
  end
  if plen > (ws_max_payload)
    return ["bad", "oversize"]
  end
  if op >= 8
    if fin != 1
      return ["bad", "frag-ctl"]
    end
    if plen > 125
      return ["bad", "ctl-len"]
    end
  end
  let taken be extra + 4 + plen
  if n < taken
    return ["bad", "short"]
  end
  let key be [buf at extra, buf at (extra + 1), buf at (extra + 2), buf at (extra + 3)]
  let body be []
  let i be 0
  while i < plen
    push with body, (buf at (extra + 4 + i))
    let i be i + 1
  end
  ws_mask_apply with body, 0, plen, key
  if op == 1
    if not (ws_utf8_ok with body)
      return ["bad", "utf8"]
    end
  end
  return ["ok", {"fin": fin, "op": op, "payload": body, "taken": taken}]
end

define ws_write_frame with fin, op, payload
  let n be length with payload
  if n > (ws_max_payload)
    return ["bad", "oversize"]
  end
  if op >= 8
    if n > 125
      return ["bad", "ctl-len"]
    end
    if fin != 1
      return ["bad", "frag-ctl"]
    end
  end
  let b0 be op
  if fin == 1
    let b0 be b0 + 128
  end
  let out be []
  push with out, b0
  if n < 126
    push with out, n
  end
  if (n >= 126) and (n < 65536)
    push with out, 126
    push with out, (idiv with n, 256)
    push with out, (n % 256)
  end
  if n >= 65536
    push with out, 127
    push with out, 0
    push with out, 0
    push with out, 0
    push with out, 0
    let x be n
    push with out, (idiv with x, 16777216)
    let x be x % 16777216
    push with out, (idiv with x, 65536)
    let x be x % 65536
    push with out, (idiv with x, 256)
    push with out, (x % 256)
  end
  let i be 0
  while i < n
    push with out, (payload at i)
    let i be i + 1
  end
  return ["ok", out]
end

define parkWs with image, labels
  parkMsg with image, labels, "txt_ws_listen", "listening on 127.0.0.1:"
  parkMsg with image, labels, "txt_ws_101", "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "
  parkMsg with image, labels, "txt_ws_crlf2", "\r\n\r\n"
  parkMsg with image, labels, "txt_ws_guid", "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
  parkMsg with image, labels, "txt_ws_b64", "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  parkMsg with image, labels, "txt_ws_upg", "upgrade:"
  parkMsg with image, labels, "txt_ws_upgtok", "upgrade"
  parkMsg with image, labels, "txt_ws_sock", "websocket"
  parkMsg with image, labels, "txt_ws_conn", "connection:"
  parkMsg with image, labels, "txt_ws_ver", "sec-websocket-version:"
  parkMsg with image, labels, "txt_ws_key", "sec-websocket-key:"
  parkMsg with image, labels, "txt_ws_13", "13"
  parkMsg with image, labels, "txt_ws_400", "HTTP/1.1 400 Bad Request\r\nConnection: close\r\nContent-Length: 0\r\n\r\n"
  parkMsg with image, labels, "msg_ws_port", "port must be from 1024 to 65535"
  pin with labels, "ws_sock", image
  emitU64 with image, 0
  pin with labels, "ws_cli", image
  emitU64 with image, 0
  pin with labels, "ws_hbuf", image
  emitU64 with image, 0
  pin with labels, "ws_hlen", image
  emitU64 with image, 0
  return image
end

define emitWsIat with image, fixes, name
  let image be emitList with image, [255, 21]
  let image be emitRel with image, fixes, name
  return image
end

