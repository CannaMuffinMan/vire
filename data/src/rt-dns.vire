  let image be emitRel with image, fixes, "dns_sk_bad"
  let image be emitList with image, [68, 1, 208, 61]
  let image be emitU32 with image, 255
  let image be emitList with image, [15, 135]
  let image be emitRel with image, fixes, "dns_sk_bad"
  let image be emitList with image, [15, 182, 192, 1, 195, 15, 130]
  let image be emitRel with image, fixes, "dns_sk_bad"
  let image be emitList with image, [59, 93, 240, 15, 135]
  let image be emitRel with image, fixes, "dns_sk_bad"
  let image be emitJmpTo with image, fixes, "dns_sk_loop"
  pin with labels, "dns_sk_ptr", image
