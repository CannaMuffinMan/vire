  pin with labels, "dns_sk_j2", image
  let image be emitList with image, [137, 195]
  let image be emitJmpTo with image, fixes, "dns_sk_loop"
  pin with labels, "dns_sk_nul", image
  let image be emitList with image, [69, 133, 237, 15, 132]
  let image be emitRel with image, fixes, "dns_sk_ok"
  let image be emitList with image, [68, 137, 243]
  pin with labels, "dns_sk_ok", image
