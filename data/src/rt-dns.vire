~ UDP DNS stub (A/AAAA). Connected datagrams use the existing ws2 allowlist
~ (socket, bind, connect, send, recv, closesocket, GetTickCount). Linux reads
~ /etc/hosts and /etc/resolv.conf with open(2). Every packet byte is checked
~ against the received length before it is read. Compressed-name hops cap 16.

define emitDnsSkip with image, fixes, labels
  pin with labels, "dns_skip", image
  emitPro with image
  let image be emitList with image, [83, 65, 84, 65, 85, 65, 86, 72, 137, 77, 248, 137, 85, 240, 68, 137, 69, 232, 139, 93, 232, 69, 49, 228, 69, 49, 237, 69, 49, 246, 69, 49, 210]
  pin with labels, "dns_sk_loop", image
  let image be emitList with image, [133, 219, 15, 136]
  let image be emitRel with image, fixes, "dns_sk_bad"
  let image be emitList with image, [59, 93, 240, 15, 131]
  let image be emitRel with image, fixes, "dns_sk_bad"
  let image be emitList with image, [72, 139, 77, 248, 15, 182, 4, 25, 255, 195, 132, 192, 15, 132]
  let image be emitRel with image, fixes, "dns_sk_nul"
  let image be emitList with image, [137, 193, 129, 225]
