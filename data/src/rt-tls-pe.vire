~ Windows PE TLS via SChannel (secur32 + crypt32 IAT). TLS 1.2+ only.
~ Client: certificate chain + hostname (pszTargetName). No skip-verify flags.
~ Server: sandboxed PFX path; key is the PFX password (may be empty).
~ Linux ELF is unchanged. Any error fail-closes.

define emitTlsCopyFns with image, fixes, labels
  pin with labels, "tls_copy", image
  let image be emitHex with image, "4d85c0740f8a02880148ffc148ffc249ffc875f1c3"
  pin with labels, "tls_zero", image
  let image be emitHex with image, "85d27409c6000048ffc1ffc975f7c3"
  return image
end

