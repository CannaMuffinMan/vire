~ Unpacked ELF OpenSSL guest emit. Packed by tools/pack-tls-elf.py into
~ rt-tls-elf-blob.txt so gen1 stays under the compiler list cap.

define emitTlsGuest with image, fixes, labels
  pin with labels, "rt_tls_wrap", image
  emitPro with image
  emitPop2 with image
  ~ rax/rdx = ca, r8/r9 = checkHost
  emitList with image, [72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_wrap_bad"
  emitList with image, [73, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "tls_wrap_bad"
  emitList with image, [73, 131, 249, 1, 15, 135]
  emitRel with image, fixes, "tls_wrap_bad"
  emitList with image, [76, 137, 13]
  emitRel with image, fixes, "tls_checkhost"
  emitList with image, [72, 137, 21]
  emitRel with image, fixes, "tls_captr"
  emitPop2 with image
  ~ rax/rdx = handle, r8/r9 = name
  emitList with image, [72, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "tls_wrap_bad"
  emitList with image, [73, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_wrap_bad"
  emitList with image, [76, 137, 77, 208]
  emitList with image, [73, 141, 65, 8, 72, 137, 5]
  emitRel with image, fixes, "tls_nameptr"
  emitList with image, [72, 137, 85, 224]
  emitJmpTo with image, fixes, "tls_hs_start"

  pin with labels, "rt_tls_connect", image
  emitPro with image
  emitPop2 with image
  ~ rax/rdx = name, r8/r9 = ca
  emitList with image, [72, 137, 85, 208, 76, 137, 13]
  emitRel with image, fixes, "tls_captr"
  emitList with image, [72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitList with image, [73, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitPop2 with image
  ~ rax/rdx = host, r8/r9 = port
  emitList with image, [72, 137, 85, 240, 76, 137, 77, 232, 72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitList with image, [73, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitList with image, [72, 139, 85, 240]
  emitPushTag with image, 2
  emitList with image, [72, 139, 85, 232]
  emitPushTag with image, 1
  emitCallTo with image, fixes, "rt_connect"
  emitPop1 with image
  emitList with image, [72, 137, 85, 224]
  pin with labels, "tls_hs_start", image
  ~ TLS_client_method()
