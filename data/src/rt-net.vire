~ Prebuilt json encode/parse (rt-net-json-blob) holds the value in GPRs/rbp
~ across helper calls. Helpers (buf_*, push, map_put, to_text) are parked.
~ Packed blob parks those rbp slots on the VM stack (tag 2) so compact
~ updates them. tools/pack-rt-net-json.py regenerates blob/pins/fixes.
~ rt_net_statusof (appended to rt-net-blob) maps JSON "status":N the same way
~ host VireListen.StatusOf does. Route replies call it before sendhttp.
~ rt_net_ctype picks txt_hdrs (JSON), txt_hdrs_plain, or landing HTML/auth/redirect
~ prefixes (leading `{` / `[` / `<` after whitespace), matching host SendApi.
~ JSON Content-Type is application/json with no charset (Go writeJSON).
~ Request body is a heap text: length at [0], bytes at [8], capped by
~ Content-Length and HttpWire.MaxRequestBody (1000000). POST/PUT without
~ Content-Length is 411. Oversize is 413. Headers are scanned to the
~ terminator including the last line (any order, case-insensitive names).
~ Duplicate Content-Length is 400. The route `body` argument is never
~ a stale pointer. Native FCG_API_TOKEN uses iat_ev (GetEnvironmentVariableA
~ / ELF envp scan) and constant-time header compare before fn_route.
~ POST /block is deny-by-default Bearer (FCG_BLOCK_TOKEN else FCG_API_TOKEN,
~ length at least 16). GET/HEAD /health /info /chain stay open.

define emitNetRuntime with image, fixes, labels, has_route, need_net, route_nparams
  let base be length with image
  if need_net
    ~ r4 packed blob parks rt_resolve (and connect). 3-param listen stays on
    ~ the smaller blob plus emitTcpClient/emitLandingHttp. resolve-only guests
    ~ have route_nparams 0; without r4, finish dies: map has no key rt_resolve.
    ~ Do not pin r4's linux_flag cell (applyPackedPins skips it).
    if (route_nparams == 4) or (route_nparams == 0)
      let names be netNamesR4
      let image be emitHex with image, (read with "data/src/rt-net-r4-blob.txt")
      applyPackedPins with labels, base, (read with "data/src/rt-net-r4-pins.txt"), names
      applyPackedFixes with fixes, base, (read with "data/src/rt-net-r4-fixes.txt"), names
      return image
    end
    let names be netNames
    let image be emitHex with image, (read with "data/src/rt-net-blob.txt")
    applyPackedPins with labels, base, (read with "data/src/rt-net-pins.txt"), names
    applyPackedFixes with fixes, base, (read with "data/src/rt-net-fixes.txt"), names
    put (base + 8032) into labels at "land_ws_send"
    put (base + 7843) into labels at "land_ws_gate"
    let image be emitTcpClient with image, fixes, labels
    return emitLandingHttp with image, fixes, labels, base
  end
  let names be netNames
  let image be emitHex with image, (read with "data/src/rt-net-json-blob.txt")
  applyPackedPins with labels, base, (read with "data/src/rt-net-json-pins.txt"), names
  applyPackedFixes with fixes, base, (read with "data/src/rt-net-json-fixes.txt"), names
  return image
end

define parkDns with image, labels
  parkMsg with image, labels, "msg_resolve", "could not resolve"
  parkMsg with image, labels, "msg_dnsname", "that name is not valid"
  parkMsg with image, labels, "dns_loop_ip", "127.0.0.1"
  pin with labels, "dns_path_fix", image
  emitStr with image, "data/vire-dns"
  pin with labels, "dns_path_resolv", image
  emitStr with image, "/etc/resolv.conf"
  pin with labels, "dns_path_hosts", image
  emitStr with image, "/etc/hosts"
  return image
end

define parkNet with image, labels
  parkMsg with image, labels, "txt_listen", "listening on 127.0.0.1:"
  parkMsg with image, labels, "txt_http11", "HTTP/1.1 "
  parkMsg with image, labels, "txt_sp_ok", " OK\r\n"
  parkMsg with image, labels, "txt_sp_err", " Error\r\n"
  ~ JSON listen replies match Go writeJSON: Content-Type application/json, no charset.
  parkMsg with image, labels, "txt_hdrs", "Content-Type: application/json\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_plain", "Content-Type: text/plain; charset=utf-8\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_html", "Content-Type: text/html; charset=utf-8\r\nX-Payments-Enabled: off\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_auth", "Content-Type: text/plain; charset=utf-8\r\nWWW-Authenticate: Basic realm=\"Protected\"\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_pay", "Content-Type: application/json\r\nX-Payments-Enabled: off\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_locp", "Content-Type: application/json\r\nLocation: /partners\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_locs", "Content-Type: application/json\r\nLocation: /sop\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdrs_locm", "Content-Type: application/json\r\nLocation: /sop/access?next=/sop/media-lab\r\nContent-Length: "
  parkMsg with image, labels, "txt_held", "{\"reason\":\"data_held\"}"
  parkMsg with image, labels, "txt_suboff", "{\"enabled\":false}"
  parkMsg with image, labels, "txt_authreq", "Authentication required."
  parkMsg with image, labels, "txt_st307", "\"status\":307"
  parkMsg with image, labels, "txt_st405", "\"status\":405"
  parkMsg with image, labels, "txt_st502", "\"status\":502"
  parkMsg with image, labels, "txt_st101", "\"status\":101"
  parkMsg with image, labels, "txt_locp", "\"location\":\"/partners\""
  parkMsg with image, labels, "txt_locs", "\"location\":\"/sop\"}"
  parkMsg with image, labels, "txt_locm", "\"location\":\"/sop/access?next=/sop/media-lab\""
  parkMsg with image, labels, "txt_adsense", "\"adsenseClientId\""
  pin with labels, "txt_hdr2", image
  let hdr2 be "\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\nCache-Control: no-store\r\n\r\n"
  let image be emitU64 with image, (length with hdr2)
  let image be emitStr with image, hdr2
  let zhdr be 0
  while zhdr < 512
    let image be emitU8 with image, 0
    let zhdr be zhdr + 1
  end
  parkMsg with image, labels, "txt_crlf", "\r\n"
  parkMsg with image, labels, "txt_err500", "{\"error\":\"route failed\"}"
  parkMsg with image, labels, "txt_k_loc", "\"location\":\""
  parkMsg with image, labels, "txt_k_set", "\"set-cookie\":\""
  parkMsg with image, labels, "txt_k_www", "\"www-authenticate\":\""
  parkMsg with image, labels, "txt_k_cc", "\"cache-control\":\""
  parkMsg with image, labels, "txt_hn_loc", "Location: "
  parkMsg with image, labels, "txt_hn_set", "Set-Cookie: "
  parkMsg with image, labels, "txt_hn_www", "WWW-Authenticate: "
  parkMsg with image, labels, "txt_hn_cc", "Cache-Control: "
  parkMsg with image, labels, "txt_hn_cookie", "Cookie: "
  parkMsg with image, labels, "txt_hn_host", "Host: "
  parkMsg with image, labels, "txt_hn_authz", "Authorization: "
  parkMsg with image, labels, "txt_nm_cookie", "cookie"
  parkMsg with image, labels, "txt_nm_host", "host"
  parkMsg with image, labels, "txt_nm_authz", "authorization"
  pin with labels, "guest_extra", image
  emitU64 with image, 0
  pin with labels, "head_hold", image
  let z2 be 0
  while z2 < 4104
    let image be emitU8 with image, 0
    let z2 be z2 + 1
  end
  pin with labels, "head_out", image
  let z3 be 0
  while z3 < 1032
    let image be emitU8 with image, 0
    let z3 be z3 + 1
  end
  pin with labels, "extra_hold", image
  let z4 be 0
  while z4 < 1032
    let image be emitU8 with image, 0
    let z4 be z4 + 1
  end
  pin with labels, "park_full", image
  emitU64 with image, 0
  parkMsg with image, labels, "txt_GET", "GET"
  parkMsg with image, labels, "txt_POST", "POST"
  parkMsg with image, labels, "txt_HEAD", "HEAD"
  parkMsg with image, labels, "txt_PUT", "PUT"
  parkMsg with image, labels, "txt_http11v", "HTTP/1.1"
  parkMsg with image, labels, "txt_http10v", "HTTP/1.0"
  parkMsg with image, labels, "txt_empty", ""
  parkMsg with image, labels, "txt_clen", "content-length"
  parkMsg with image, labels, "txt_te", "transfer-encoding"
  parkMsg with image, labels, "txt_host", "host"
  parkMsg with image, labels, "txt_null", "null"
  parkMsg with image, labels, "txt_true", "true"
  parkMsg with image, labels, "txt_false", "false"
  parkMsg with image, labels, "txt_err400", "{\"error\":\"bad request\"}"
  parkMsg with image, labels, "txt_err404", "{\"error\":\"not found\"}"
  parkMsg with image, labels, "txt_err408", "{\"error\":\"timeout\"}"
  parkMsg with image, labels, "txt_err413", "{\"error\":\"body too large\"}"
  parkMsg with image, labels, "txt_err431", "{\"error\":\"headers too large\"}"
  parkMsg with image, labels, "txt_err501", "{\"error\":\"not implemented\"}"
  parkMsg with image, labels, "txt_err401", "{\"error\":\"unauthorized\"}"
  parkMsg with image, labels, "txt_err411", "{\"error\":\"content length required\"}"
  parkMsg with image, labels, "txt_portk", "\"port\":"
  parkMsg with image, labels, "txt_upg", "upgrade:"
  parkMsg with image, labels, "txt_wsock", "websocket"
  parkMsg with image, labels, "txt_xfctoken", "x-fcg-token"
  parkMsg with image, labels, "txt_healthp", "/health"
  parkMsg with image, labels, "txt_fcgenv", "FCG_API_TOKEN"
  let image be emitU8 with image, 0
  pin with labels, "envp_ptr", image
  let image be emitU64 with image, 0
  pin with labels, "token_env", image
  let z be 0
  while z < 256
    let image be emitU8 with image, 0
    let z be z + 1
  end
  pin with labels, "token_left", image
  let z be 0
  while z < 256
    let image be emitU8 with image, 0
    let z be z + 1
  end
  pin with labels, "token_right", image
  let z be 0
  while z < 256
    let image be emitU8 with image, 0
    let z be z + 1
  end
  pin with labels, "ws_iobuf", image
  let z be 0
  while z < 8192
    let image be emitU8 with image, 0
    let z be z + 1
  end
  pin with labels, "ws_tls_ptr", image
  let image be emitU64 with image, 0
  parkMsg with image, labels, "msg_net", "network setup failed"
  parkMsg with image, labels, "msg_port", "port must be from 1024 to 65535"
  parkMsg with image, labels, "msg_need_route", "listen needs define route with method, path, body"
  parkMsg with image, labels, "msg_json", "json is not valid"
  parkMsg with image, labels, "msg_conn_priv", "connect stays off this machine and private networks"
  parkMsg with image, labels, "msg_conn_addr", "that address is not allowed"
  parkMsg with image, labels, "msg_conn_port", "connect needs a port from 1 to 65535"
  parkMsg with image, labels, "msg_conn_host", "connect needs a host and a port"
  parkMsg with image, labels, "msg_conn_fail", "could not connect"
  let image be parkDns with image, labels
  parkMsg with image, labels, "msg_send_bad", "send needs a connection and text"
  parkMsg with image, labels, "msg_recv_bad", "recv needs a connection and a size"
  parkMsg with image, labels, "msg_conn_closed", "that connection is closed"
  pin with labels, "ws2_ready", image
  emitU64 with image, 0
  pin with labels, "tcp_socks", image
  emitU64 with image, 0
  return image
end

