~ Native Winsock HTTP/1.1 + JSON for compiled Windows x64 guests.

use "src/rt-server.vire"
~ Compact blob + packed reloc tables so the compiler PE stays under the hex cap.
~ RFC 9112: request lines and field lines end with CR LF. rt_net_hdrunsafe
~ returns unsafe (client answers 400 and closes) for NUL, bare LF, lone CR,
~ CR not followed by LF, controls other than HT, and obs-fold (SP / HT after LF).
~ Duplicate Content-Length is 400. Transfer-Encoding is 501 (not implemented).
~ hu_frame sliding-window scans [0, headerEnd) for those names (ci) so a last
~ field line whose CR is headerEnd itself cannot skip the count.

define hexNibble with ch
  return find with "0123456789abcdef", ch
end

define emitHex with image, raw
  let i be 0
  let n be length with raw
  while i + 1 < n
    let v be ((hexNibble with (raw at i)) * 16) + (hexNibble with (raw at (i + 1)))
    let image be emitU8 with image, v
    let i be i + 2
  end
  return image
end

define parseU16 with raw, i
  let lo be ((hexNibble with (raw at i)) * 16) + (hexNibble with (raw at (i + 1)))
  let hi be ((hexNibble with (raw at (i + 2))) * 16) + (hexNibble with (raw at (i + 3)))
  return lo + (hi * 256)
end

define parseU32 with raw, i
  return (parseU16 with raw, i) + ((parseU16 with raw, (i + 4)) * 65536)
end

define applyPackedPins with labels, base, raw, names
  let i be 0
  let n be length with raw
  while i + 11 < n
    let off be parseU32 with raw, i
    let id be parseU16 with raw, (i + 8)
    put (base + off) into labels at (names at id)
    let i be i + 12
  end
  return true
end

define applyPackedFixes with fixes, base, raw, names
  let i be 0
  let n be length with raw
  while i + 11 < n
    let off be parseU32 with raw, i
    let id be parseU16 with raw, (i + 8)
    push with fixes, {"at": (base + off), "to": (names at id)}
    let i be i + 12
  end
  return true
end

define netNames
  return ["rt_net_init", "net_init_done", "net_init_fail", "rt_net_mktext", "mktext_oom", "rt_net_sendall", "send_loop", "send_done", "rt_net_sendhttp", "sh_errph", "sh_ph", "rt_net_hdrend", "hdrend_loop", "hdrend_hit", "hdrend_none", "rt_net_hdrunsafe", "hu_loop", "hu_next", "hu_lf", "hu_cr", "hu_ok", "hu_bad", "rt_net_pathok", "po_loop", "po_next", "po_ok", "po_bad", "rt_net_prefixci", "px_loop", "px_d", "px_c", "px_colon", "px_no", "rt_net_clval", "cv_colon", "cv_after", "cv_sp", "cv_sk", "cv_num", "cv_d", "cv_end", "cv_bad", "rt_net_client", "cl_hdr", "cl_rl", "cl_rl_end", "cl_sp1", "cl_gotm", "cl_sp2", "cl_gotp", "cl_mok", "cl_verok", "cl_hd", "cl_hline", "cl_notecl", "cl_hdnext", "cl_readcl", "cl_hddone", "cl_body", "cl_more", "cl_gotbody", "cl_nobody", "cl_bodytxt", "cl_400", "cl_408", "cl_413", "cl_431", "cl_501", "rt_listen", "listen_port_ok", "listen_loop", "listen_bad_port", "listen_fail", "rt_json_skip", "js_loop", "js_adv", "js_done", "rt_json_kw", "kw_bad", "rt_json_enc", "je_null", "je_bool", "je_false", "je_boolw", "je_int", "je_str", "je_ch", "je_escq", "je_escb", "je_escn", "je_escr", "je_esct", "je_escc", "je_hx1", "je_hx2", "je_strend", "je_list", "je_li", "je_lit", "je_le", "je_map", "je_mi", "je_mit", "je_me", "je_badkey", "je_deep", "rt_json", "rt_json_val", "jv_num", "jv_nd", "jv_nl", "jv_nend", "jv_npos", "jv_nbad", "jv_null", "jv_true", "jv_false", "jv_str", "jv_sc", "jv_sx", "jv_sn", "jv_sr", "jv_st", "jv_sxx", "jv_sp", "jv_se", "jv_arr", "jv_ai", "jv_ac", "jv_ae", "jv_obj", "jv_oi", "jv_oc", "jv_oe", "jv_bad", "rt_parse", "jp_bad", "ws2_ready", "rt_alloc", "iat_wsa", "msg_net", "rt_fail", "rt_memcpy", "msg_oom", "iat_sd", "rt_buf_new", "txt_http11", "rt_buf_text", "rt_int_text", "txt_sp_ok", "txt_sp_err", "txt_hdrs", "txt_hdr2", "rt_buf_finish", "iat_ss", "iat_gt", "iat_rv", "txt_GET", "rt_texteq", "txt_POST", "txt_HEAD", "txt_PUT", "txt_http11v", "txt_http10v", "txt_empty", "txt_clen", "txt_te", "txt_host", "rt_save_frame", "fn_route", "rt_restore_frame", "rt_to_text", "txt_err400", "txt_err408", "txt_err413", "txt_err431", "txt_err501", "iat_sk", "iat_bd", "iat_ln", "iat_gn", "txt_listen", "rt_text_cat", "rt_say", "iat_ac", "iat_cs", "msg_port", "rt_memeq", "msg_json", "txt_null", "txt_true", "txt_false", "rt_buf_byte", "rt_push_none", "rt_push_bool", "rt_list_new", "rt_push", "rt_map_new", "rt_map_put", "hu_fold", "hu_frame", "rt_alloc_leaf"]
end

define emitNetRuntime with image, fixes, labels, has_route, need_net
  let base be length with image
  let names be netNames
  if need_net
    let image be emitHex with image, (read with "data/src/rt-net-blob.txt")
    applyPackedPins with labels, base, (read with "data/src/rt-net-pins.txt"), names
    applyPackedFixes with fixes, base, (read with "data/src/rt-net-fixes.txt"), names
    let image be emitTcpClient with image, fixes, labels
    return emitServerRuntime with image, fixes, labels
  end
  let image be emitHex with image, (read with "data/src/rt-net-json-blob.txt")
  applyPackedPins with labels, base, (read with "data/src/rt-net-json-pins.txt"), names
  applyPackedFixes with fixes, base, (read with "data/src/rt-net-json-fixes.txt"), names
  return image
end

define parkNet with image, labels
  parkMsg with image, labels, "txt_listen", "listening on 127.0.0.1:"
  parkMsg with image, labels, "txt_http11", "HTTP/1.1 "
  parkMsg with image, labels, "txt_sp_ok", " OK\r\n"
  parkMsg with image, labels, "txt_sp_err", " Error\r\n"
  parkMsg with image, labels, "txt_hdrs", "Content-Type: application/json; charset=utf-8\r\nContent-Length: "
  parkMsg with image, labels, "txt_hdr2", "\r\nConnection: close\r\nX-Content-Type-Options: nosniff\r\nCache-Control: no-store\r\n\r\n"
  parkMsg with image, labels, "txt_GET", "GET"
  parkMsg with image, labels, "txt_POST", "POST"
  parkMsg with image, labels, "txt_HEAD", "HEAD"
  parkMsg with image, labels, "txt_PUT", "PUT"
  parkMsg with image, labels, "txt_http11v", "HTTP/1.1"
  parkMsg with image, labels, "txt_http10v", "HTTP/1.0"
  parkMsg with image, labels, "txt_empty", ""
  parkMsg with image, labels, "txt_clen", "content-length"
  parkMsg with image, labels, "txt_te", "transfer-encoding"
  parkMsg with image, labels, "txt_host", "host"
  parkMsg with image, labels, "txt_null", "null"
  parkMsg with image, labels, "txt_true", "true"
  parkMsg with image, labels, "txt_false", "false"
  parkMsg with image, labels, "txt_err400", "{\"error\":\"bad request\"}"
  parkMsg with image, labels, "txt_err404", "{\"error\":\"not found\"}"
  parkMsg with image, labels, "txt_err408", "{\"error\":\"timeout\"}"
  parkMsg with image, labels, "txt_err413", "{\"error\":\"body too large\"}"
  parkMsg with image, labels, "txt_err431", "{\"error\":\"headers too large\"}"
  parkMsg with image, labels, "txt_err501", "{\"error\":\"not implemented\"}"
  parkMsg with image, labels, "msg_net", "network setup failed"
  parkMsg with image, labels, "msg_port", "port must be from 1024 to 65535"
  parkMsg with image, labels, "msg_need_route", "listen needs define route with method, path, body"
  parkMsg with image, labels, "msg_json", "json is not valid"
  parkMsg with image, labels, "msg_conn_priv", "connect stays off this machine and private networks"
  parkMsg with image, labels, "msg_conn_addr", "that address is not allowed"
  parkMsg with image, labels, "msg_conn_port", "connect needs a port from 1 to 65535"
  parkMsg with image, labels, "msg_conn_host", "connect needs a host and a port"
  parkMsg with image, labels, "msg_conn_fail", "could not connect"
  parkMsg with image, labels, "msg_send_bad", "send needs a connection and text"
  parkMsg with image, labels, "msg_recv_bad", "recv needs a connection and a size"
  parkMsg with image, labels, "msg_conn_closed", "that connection is closed"
  pin with labels, "ws2_ready", image
  emitU64 with image, 0
  pin with labels, "tcp_socks", image
  emitU64 with image, 0
  pin with labels, "server_cap", image
  emitU64 with image, 0
  pin with labels, "srv_listen", image
  emitU64 with image, 0
  pin with labels, "srv_tv", image
  emitU64 with image, 0
  pin with labels, "srv_born", image
  let bi be 0
  while bi < 64
    emitU32 with image, 0
    let bi be bi + 1
  end
  pin with labels, "srv_slots", image
  let si be 0
  while si < 64
    emitU64 with image, 0
    let si be si + 1
  end
  pin with labels, "srv_fdset", image
  emitU64 with image, 0
  let fi be 0
  while fi < 65
    emitU64 with image, 0
    let fi be fi + 1
  end
  pin with labels, "srv_slen", image
  let li be 0
  while li < 64
    emitU32 with image, 0
    let li be li + 1
  end
  pin with labels, "srv_sbuf", image
  let pi be 0
  while pi < 65536
    emitU64 with image, 0
    let pi be pi + 1
  end
  return image
end

define emitIat with image, fixes, name
  let image be emitList with image, [255, 21]
  let image be emitRel with image, fixes, name
  return image
end

define emitTcpClient with image, fixes, labels
  ~ Guest connect/send/recv/close. Loopback 127.0.0.1 only. No TLS. Check
  ~ the IPv4 literal before socket+connect. Recv cap 1000000.
  ~ WSAStartup via rt_net_init (same as listen). Send via rt_net_sendall.
  ~ Host still applies 5s send/recv timeouts; native send uses rt_net_sendall.
  pin with labels, "rt_connect", image
  emitPro with image
  emitPop2 with image
  emitList with image, [72, 137, 85, 248, 76, 137, 77, 232, 72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "conn_host"
  emitList with image, [73, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "conn_host"
  emitList with image, [77, 133, 201, 15, 142]
  emitRel with image, fixes, "conn_port"
  emitList with image, [73, 129, 249]
  emitU32 with image, 65535
  emitJcc with image, fixes, 135, "conn_port"
  emitList with image, [72, 139, 85, 248, 72, 139, 10, 72, 131, 249, 9, 15, 133]
  emitRel with image, fixes, "conn_notloop"
  emitList with image, [129, 122, 8, 49, 50, 55, 46]
  emitJcc with image, fixes, 133, "conn_notloop"
  emitList with image, [129, 122, 12, 48, 46, 48, 46]
  emitJcc with image, fixes, 133, "conn_notloop"
  emitList with image, [128, 122, 16, 49, 15, 133]
  emitRel with image, fixes, "conn_notloop"
  emitCallTo with image, fixes, "rt_net_init"
  emitList with image, [185]
  emitU32 with image, 2
  emitList with image, [186]
  emitU32 with image, 1
  emitList with image, [65, 184]
  emitU32 with image, 6
  let image be emitIat with image, fixes, "iat_sk"
  emitList with image, [72, 131, 248, 255, 15, 132]
  emitRel with image, fixes, "conn_fail"
  ~ Same sockaddr layout as rt_listen (rbp-48). htons via xchg al,ah.
  emitList with image, [72, 137, 69, 240, 72, 199, 69, 208, 0, 0, 0, 0]
  emitList with image, [72, 199, 69, 216, 0, 0, 0, 0, 198, 69, 208, 2]
  emitList with image, [139, 69, 232, 102, 134, 224, 102, 137, 69, 210]
  emitList with image, [198, 69, 212, 127, 198, 69, 213, 0, 198, 69, 214, 0, 198, 69, 215, 1]
  emitList with image, [72, 139, 77, 240, 72, 141, 85, 208, 65, 184]
  emitU32 with image, 16
  let image be emitIat with image, fixes, "iat_cn"
  emitList with image, [133, 192, 15, 133]
  emitRel with image, fixes, "conn_close"
  emitList with image, [72, 139, 77, 240]
  emitCallTo with image, fixes, "rt_sock_timeouts"
  emitList with image, [72, 141, 13]
  emitRel with image, fixes, "tcp_socks"
  emitList with image, [72, 139, 85, 240, 72, 137, 17, 186]
  emitU32 with image, 1
  emitPushTag with image, 1
  emitEpi with image
  pin with labels, "conn_close", image
  emitList with image, [72, 139, 77, 240]
  let image be emitIat with image, fixes, "iat_cs"
  emitJmpTo with image, fixes, "conn_fail"
  pin with labels, "conn_notloop", image
  emitList with image, [72, 139, 85, 248, 72, 139, 10, 72, 133, 201, 15, 132]
  emitRel with image, fixes, "conn_addr"
  emitList with image, [15, 182, 66, 8, 131, 248, 48, 15, 130]
  emitRel with image, fixes, "conn_addr"
  emitList with image, [131, 248, 57, 15, 135]
  emitRel with image, fixes, "conn_addr"
  emitJmpTo with image, fixes, "conn_priv"
  pin with labels, "conn_host", image
  emitFail with image, fixes, "msg_conn_host"
  pin with labels, "conn_port", image
  emitFail with image, fixes, "msg_conn_port"
  pin with labels, "conn_addr", image
  emitFail with image, fixes, "msg_conn_addr"
  pin with labels, "conn_priv", image
  emitFail with image, fixes, "msg_conn_priv"
  pin with labels, "conn_fail", image
  emitFail with image, fixes, "msg_conn_fail"

  pin with labels, "rt_send", image
  emitPro with image
  emitPop2 with image
  emitList with image, [72, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "send_bad"
  emitList with image, [73, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "send_bad"
  emitList with image, [72, 131, 250, 1, 15, 133]
  emitRel with image, fixes, "send_closed"
  emitList with image, [76, 137, 77, 240]
  emitList with image, [72, 139, 13]
  emitRel with image, fixes, "tcp_socks"
  emitList with image, [72, 133, 201, 15, 132]
  emitRel with image, fixes, "send_closed"
  emitList with image, [72, 131, 249, 255, 15, 132]
  emitRel with image, fixes, "send_closed"
  emitList with image, [72, 139, 85, 240, 76, 139, 2, 72, 141, 82, 8]
  emitCallTo with image, fixes, "rt_net_sendall"
  emitList with image, [133, 192, 15, 136]
  emitRel with image, fixes, "send_fail"
  emitList with image, [72, 139, 85, 240, 72, 139, 18]
  emitPushTag with image, 1
  emitEpi with image
  pin with labels, "send_fail", image
  emitFail with image, fixes, "msg_conn_fail"
  pin with labels, "send_bad", image
  emitFail with image, fixes, "msg_send_bad"
  pin with labels, "send_closed", image
  emitFail with image, fixes, "msg_conn_closed"

  pin with labels, "rt_recv", image
  emitPro with image
  emitPop2 with image
  emitList with image, [72, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "recv_bad"
  emitList with image, [73, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "recv_bad"
  emitList with image, [72, 131, 250, 1, 15, 133]
  emitRel with image, fixes, "recv_closed"
  emitList with image, [72, 139, 13]
  emitRel with image, fixes, "tcp_socks"
  emitList with image, [72, 133, 201, 15, 132]
  emitRel with image, fixes, "recv_closed"
  emitList with image, [72, 131, 249, 255, 15, 132]
  emitRel with image, fixes, "recv_closed"
  emitList with image, [72, 137, 77, 248, 77, 133, 201, 15, 136]
  emitRel with image, fixes, "recv_bad"
  emitList with image, [73, 129, 249]
  emitU32 with image, 1000000
  emitJcc with image, fixes, 134, "recv_cap"
  emitList with image, [73, 199, 193]
  emitU32 with image, 1000000
  pin with labels, "recv_cap", image
  emitList with image, [76, 137, 77, 232, 139, 77, 232, 72, 131, 193, 16, 15, 130]
  emitRel with image, fixes, "recv_bad"
  emitCallTo with image, fixes, "rt_alloc"
  emitLeaf with image
  emitList with image, [72, 137, 69, 224, 72, 139, 77, 248, 72, 141, 80, 8, 139, 69, 232, 76, 99, 192, 69, 49, 201]
  let image be emitIat with image, fixes, "iat_rv"
  emitList with image, [133, 192, 15, 136]
  emitRel with image, fixes, "recv_fail"
  emitList with image, [72, 139, 85, 224, 72, 99, 200, 72, 137, 10, 198, 68, 10, 8, 0]
  emitPushTag with image, 2
  emitEpi with image
  pin with labels, "recv_fail", image
  emitFail with image, fixes, "msg_conn_fail"
  pin with labels, "recv_bad", image
  emitFail with image, fixes, "msg_recv_bad"
  pin with labels, "recv_closed", image
  emitFail with image, fixes, "msg_conn_closed"

  pin with labels, "rt_close", image
  emitPro with image
  emitPop1 with image
  emitList with image, [72, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "close_bad"
  emitList with image, [72, 131, 250, 1, 15, 133]
  emitRel with image, fixes, "close_bad"
  emitList with image, [72, 139, 13]
  emitRel with image, fixes, "tcp_socks"
  emitList with image, [72, 133, 201, 15, 132]
  emitRel with image, fixes, "close_bad"
  emitList with image, [72, 141, 21]
  emitRel with image, fixes, "tcp_socks"
  emitList with image, [72, 199, 2, 0, 0, 0, 0]
  let image be emitIat with image, fixes, "iat_cs"
  emitCallTo with image, fixes, "rt_push_none"
  emitEpi with image
  pin with labels, "close_bad", image
  emitFail with image, fixes, "msg_conn_closed"
  return image
end


