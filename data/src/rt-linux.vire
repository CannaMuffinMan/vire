~ Linux x86-64 syscall shims. Win64 callers, raw syscalls, no libc.

define emitLeaRdi with image, fixes, name
  let image be emitList with image, [72, 141, 61]
  let image be emitRel with image, fixes, name
  return image
end

define emitLeaRax with image, fixes, name
  let image be emitList with image, [72, 141, 5]
  let image be emitRel with image, fixes, name
  return image
end

define emitSaveRbx with image, fixes
  let image be emitList with image, [72, 137, 29]
  let image be emitRel with image, fixes, "saved_rbx"
  return image
end

define emitLoadRbx with image, fixes
  let image be emitList with image, [72, 139, 29]
  let image be emitRel with image, fixes, "saved_rbx"
  return image
end

define emitSys with image, n
  let image be emitList with image, [184]
  let image be emitU32 with image, n
  let image be emitList with image, [15, 5]
  return image
end

define emitSysNeg1 with image
  ~ cmp rax, -4096; jb ok; mov rax, -1
  let image be emitList with image, [72, 61]
  let image be emitU32 with image, -4096
  let image be emitList with image, [114, 7, 72, 199, 192, 255, 255, 255, 255]
  return image
end

define emitLinuxStart with image, fixes, labels
  pin with labels, "linux_start", image
  let image be emitList with image, [49, 237, 76, 139, 36, 36, 76, 141, 108, 36, 8, 72, 131, 228, 240]
  let image be emitLeaRdi with image, fixes, "cmdline_buf"
  let image be emitList with image, [73, 137, 254, 69, 49, 255]
  pin with labels, "ls_arg", image
  let image be emitList with image, [77, 57, 252, 15, 142]
  let image be emitRel with image, fixes, "ls_done"
  let image be emitList with image, [75, 139, 116, 253, 0]
  pin with labels, "ls_copy", image
  let image be emitList with image, [138, 6, 136, 7, 72, 255, 198, 72, 255, 199, 132, 192, 15, 133]
  let image be emitRel with image, fixes, "ls_copy"
  let image be emitList with image, [72, 255, 207, 198, 7, 32, 72, 255, 199, 73, 255, 199, 233]
  let image be emitRel with image, fixes, "ls_arg"
  pin with labels, "ls_done", image
  let image be emitList with image, [76, 57, 247, 15, 132]
  let image be emitRel with image, fixes, "ls_nul"
  let image be emitList with image, [72, 255, 207]
  pin with labels, "ls_nul", image
  let image be emitList with image, [198, 7, 0]
  let image be emitLeaRax with image, fixes, "cmdline_buf"
  let image be emitList with image, [72, 137, 5]
  let image be emitRel with image, fixes, "cmdline_ptr"
  let image be emitList with image, [233]
  let image be emitRel with image, fixes, "code"
  return image
end

define emitIatThunk with image, fixes, labels, thunk, stub
  pin with labels, thunk, image
  let image be emitList with image, [83, 232]
  let image be emitRel with image, fixes, stub
  let image be emitList with image, [91, 195]
  return image
end

