~ Linux x86-64 syscall shims. Win64 callers, raw syscalls, no libc.

define emitLeaRdi with image, fixes, name
  let image be emitHex with image, "488d3d"
  let image be emitRel with image, fixes, name
  return image
end

define emitLeaRax with image, fixes, name
  let image be emitHex with image, "488d05"
  let image be emitRel with image, fixes, name
  return image
end

define emitSaveRbx with image, fixes
  let image be emitHex with image, "48891d"
  let image be emitRel with image, fixes, "saved_rbx"
  return image
end

define emitLoadRbx with image, fixes
  let image be emitHex with image, "488b1d"
  let image be emitRel with image, fixes, "saved_rbx"
  return image
end

define emitSys with image, n
  let image be emitHex with image, "b8"
  let image be emitU32 with image, n
  let image be emitHex with image, "0f05"
  return image
end

define emitSysNeg1 with image
  ~ cmp rax, -4096; jb ok; mov rax, -1
  let image be emitHex with image, "483d"
  let image be emitU32 with image, 4294963200
  let image be emitHex with image, "720748c7c0ffffffff"
  return image
end

define emitLinuxStart with image, fixes, labels
  pin with labels, "linux_start", image
  let image be emitHex with image, "31ed4c8b24244c8d6c24084883e4f0"
  let image be emitLeaRdi with image, fixes, "cmdline_buf"
  let image be emitHex with image, "4989fe4531ff"
  pin with labels, "ls_arg", image
  let image be emitHex with image, "4d39fc0f8e"
  let image be emitRel with image, fixes, "ls_done"
  let image be emitHex with image, "4b8b74fd00"
  pin with labels, "ls_copy", image
  let image be emitHex with image, "8a06880748ffc648ffc784c00f85"
  let image be emitRel with image, fixes, "ls_copy"
  let image be emitHex with image, "48ffcfc6072048ffc749ffc7e9"
  let image be emitRel with image, fixes, "ls_arg"
  pin with labels, "ls_done", image
  let image be emitHex with image, "4c39f70f84"
  let image be emitRel with image, fixes, "ls_nul"
  let image be emitHex with image, "48ffcf"
  pin with labels, "ls_nul", image
  let image be emitHex with image, "c60700"
  let image be emitLeaRax with image, fixes, "cmdline_buf"
  let image be emitHex with image, "488905"
  let image be emitRel with image, fixes, "cmdline_ptr"
  let image be emitHex with image, "e9"
  let image be emitRel with image, fixes, "code"
  return image
end

define emitIatThunk with image, fixes, labels, thunk, stub
  pin with labels, thunk, image
  let image be emitHex with image, "53e8"
  let image be emitRel with image, fixes, stub
  let image be emitHex with image, "5bc3"
  return image
end

define emitLinuxThunks with image, fixes, labels
  let image be emitIatThunk with image, fixes, labels, "thunk_gs", "stub_gs"
  let image be emitIatThunk with image, fixes, labels, "thunk_wf", "stub_wf"
  let image be emitIatThunk with image, fixes, labels, "thunk_ep", "stub_ep"
  let image be emitIatThunk with image, fixes, labels, "thunk_va", "stub_va"
  let image be emitIatThunk with image, fixes, labels, "thunk_cf", "stub_cf"
  let image be emitIatThunk with image, fixes, labels, "thunk_rf", "stub_rf"
  let image be emitIatThunk with image, fixes, labels, "thunk_sz", "stub_sz"
  let image be emitIatThunk with image, fixes, labels, "thunk_ch", "stub_ch"
  let image be emitIatThunk with image, fixes, labels, "thunk_cl", "stub_cl"
  let image be emitIatThunk with image, fixes, labels, "thunk_ga", "stub_ga"
  let image be emitIatThunk with image, fixes, labels, "thunk_fi", "stub_fi"
  let image be emitIatThunk with image, fixes, labels, "thunk_ue", "stub_ue"
  let image be emitIatThunk with image, fixes, labels, "thunk_vh", "stub_vh"
  let image be emitIatThunk with image, fixes, labels, "thunk_sp", "stub_sp"
  let image be emitIatThunk with image, fixes, labels, "thunk_se", "stub_se"
  let image be emitIatThunk with image, fixes, labels, "thunk_fp", "stub_fp"
  return image
end

define emitLinuxNetThunks with image, fixes, labels
  let image be emitLinuxThunks with image, fixes, labels
  let image be emitIatThunk with image, fixes, labels, "thunk_gt", "stub_gt"
  let image be emitIatThunk with image, fixes, labels, "thunk_wsa", "stub_wsa"
  let image be emitIatThunk with image, fixes, labels, "thunk_sk", "stub_sk"
  let image be emitIatThunk with image, fixes, labels, "thunk_bd", "stub_bd"
  let image be emitIatThunk with image, fixes, labels, "thunk_ln", "stub_ln"
  let image be emitIatThunk with image, fixes, labels, "thunk_ac", "stub_ac"
  let image be emitIatThunk with image, fixes, labels, "thunk_rv", "stub_rv"
  let image be emitIatThunk with image, fixes, labels, "thunk_sd", "stub_sd"
  let image be emitIatThunk with image, fixes, labels, "thunk_cs", "stub_cs"
  let image be emitIatThunk with image, fixes, labels, "thunk_ss", "stub_ss"
  let image be emitIatThunk with image, fixes, labels, "thunk_gn", "stub_gn"
  let image be emitIatThunk with image, fixes, labels, "thunk_cn", "stub_cn"
  return image
end

define emitLinuxRtLinux with image, fixes, labels
  pin with labels, "rt_linux", image
  let image be emitHex with image, "554889e54881ec80000000b9"
  let image be emitU32 with image, 1
  let image be emitHex with image, "e8"
  let image be emitRel with image, fixes, "rt_push_bool"
  let image be emitHex with image, "c9c3"
  return image
end

