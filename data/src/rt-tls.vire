~ Native outbound HTTPS via Windows Schannel (secur32). Opt-in needTls only.
~ connect stays 127.0.0.1. fetch/post resolve public A records and verify the cert.
~ DecryptMessage uses four SecBuffers (DATA + EMPTY*3) and copies SECBUFFER_EXTRA;
~ PR #59's 0x80090330 was incomplete-record / leftover framing.

define emitTlsRuntime with image, fixes, labels
  return (emitTlsClient with image, fixes, labels)
end

define parkTls with image, labels
  parkMsg with image, labels, "msg_tls_need", "fetch needs an http or https address"
  parkMsg with image, labels, "msg_tls_postneed", "post needs an http or https address"
  parkMsg with image, labels, "msg_tls_addr", "that address is not allowed"
  parkMsg with image, labels, "msg_tls_priv", "fetch stays off this machine and private networks"
  parkMsg with image, labels, "msg_tls_https", "fetch allows https only"
  parkMsg with image, labels, "msg_tls_check", "could not check that address"
  parkMsg with image, labels, "msg_tls_reach", "could not reach that address"
  parkMsg with image, labels, "msg_tls_big", "the response is too large"
  parkMsg with image, labels, "msg_tls_sendbig", "text is too large to send"
  parkMsg with image, labels, "msg_tls_ret", "the address returned "
  parkMsg with image, labels, "txt_tls_pkg", "Microsoft Unified Security Protocol Provider"
  parkMsg with image, labels, "txt_tls_get", "GET "
  parkMsg with image, labels, "txt_tls_post", "POST "
  parkMsg with image, labels, "txt_tls_mid", " HTTP/1.1\r\nHost: "
  parkMsg with image, labels, "txt_tls_cl", "\r\nContent-Length: "
  parkMsg with image, labels, "txt_tls_ct", "\r\nContent-Type: text/plain; charset=utf-8"
  parkMsg with image, labels, "txt_tls_end", "\r\nConnection: close\r\n\r\n"
  parkMsg with image, labels, "txt_tls_443", "443"
  parkMsg with image, labels, "txt_tls_slash", "/"
  pin with labels, "tls_wsa", image
  let image be zeros with 512
  pin with labels, "tls_cred", image
  let image be zeros with 16
  pin with labels, "tls_ctx", image
  let image be zeros with 16
  pin with labels, "tls_sizes", image
  let image be zeros with 32
