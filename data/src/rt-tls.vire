  emitList with image, [73, 129, 249]
  emitU32 with image, 1000000
  emitJcc with image, fixes, 134, "tls_recv_cap"
  emitList with image, [73, 199, 193]
  emitU32 with image, 1000000
  pin with labels, "tls_recv_cap", image
  emitList with image, [76, 137, 77, 232, 139, 77, 232, 72, 131, 193, 16]
  emitCallTo with image, fixes, "rt_alloc"
  emitLeaf with image
  emitList with image, [72, 137, 69, 224, 72, 139, 13]
  emitRel with image, fixes, "tls_ssl"
  emitList with image, [72, 141, 80, 8, 139, 69, 232, 76, 99, 192]
  let image be emitIat with image, fixes, "iat_sslrd"
  emitList with image, [133, 192, 15, 136]
  emitRel with image, fixes, "tls_hs_fail"
  emitList with image, [72, 139, 85, 224, 72, 99, 200, 72, 137, 10, 198, 68, 10, 8, 0]
  emitPushTag with image, 2
  emitEpi with image
  pin with labels, "tls_recv_bad", image
