define emitTlsWrapAccept with image, fixes, labels
  ~ After a successful accept fd in rax: if tls_ctx, SSL_new/set_fd/accept.
  pin with labels, "tls_after_accept", image
  let image be emitHex with image, "488905"
  let image be emitRel with image, fixes, "tls_fd"
  let image be emitHex with image, "488b05"
  let image be emitRel with image, fixes, "tls_ctx"
  let image be emitHex with image, "4885c074"
