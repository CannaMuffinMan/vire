  let image be emitHex with image, "ff15"
  let image be emitRel with image, fixes, "iat_setfd"
  let image be emitHex with image, "488b0d"
  let image be emitRel with image, fixes, "tls_ssl"
  let image be emitHex with image, "ff15"
  let image be emitRel with image, fixes, "iat_sslacc"
  let image be emitHex with image, "83f80175"
  let image be emitU8 with image, 14
  let image be emitHex with image, "488b05"
  let image be emitRel with image, fixes, "tls_fd"
  let image be emitHex with image, "c348c7c0ffffffffc3"
  return image
end

define emitTlsGuest with image, fixes, labels
  pin with labels, "rt_tls_connect", image
  emitPro with image
  emitPop2 with image
  ~ rax/rdx = name, r8/r9 = ca
  emitList with image, [72, 137, 85, 208, 76, 137, 13]
  emitRel with image, fixes, "tls_captr"
  emitList with image, [72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitList with image, [73, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitPop2 with image
  ~ rax/rdx = host, r8/r9 = port
  emitList with image, [72, 137, 85, 240, 76, 137, 77, 232, 72, 131, 248, 2, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitList with image, [73, 131, 248, 1, 15, 133]
  emitRel with image, fixes, "tls_conn_bad"
  emitList with image, [72, 139, 85, 240]
  emitPushTag with image, 2
  emitList with image, [72, 139, 85, 232]
  emitPushTag with image, 1
  emitCallTo with image, fixes, "rt_connect"
  emitPop1 with image
  emitList with image, [72, 137, 85, 224]
  ~ TLS_client_method()
  emitList with image, [49, 201]
  let image be emitIat with image, fixes, "iat_tcm"
  emitList with image, [72, 137, 193, 72, 133, 192, 15, 132]
  emitRel with image, fixes, "tls_hs_fail"
  let image be emitIat with image, fixes, "iat_ctxnew"
  emitList with image, [72, 133, 192, 15, 132]
  emitRel with image, fixes, "tls_hs_fail"
  emitList with image, [72, 137, 5]
  emitRel with image, fixes, "tls_ctx"
  emitList with image, [49, 201]
  let image be emitIat with image, fixes, "iat_vernum"
  emitList with image, [72, 61]
  emitU32 with image, 805306368
  emitList with image, [15, 130]
  emitRel with image, fixes, "tls_ver_fail"
