end

define emitTlsPeRefuse with image, fixes, labels
  pin with labels, "rt_tls_connect", image
  emitPro with image
  emitFail with image, fixes, "msg_tls_pe"
  pin with labels, "rt_tls_send", image
  emitPro with image
  emitFail with image, fixes, "msg_tls_pe"
  pin with labels, "rt_tls_recv", image
  emitPro with image
  emitFail with image, fixes, "msg_tls_pe"
  pin with labels, "rt_tls_close", image
  emitPro with image
  emitFail with image, fixes, "msg_tls_pe"
  pin with labels, "rt_tls_listen", image
  emitPro with image
  emitFail with image, fixes, "msg_tls_pe"
  return image
end

define emitTlsRuntime with image, fixes, labels, elf
  if elf
    let image be emitTlsGuest with image, fixes, labels
    return image
  end
  return (emitTlsPeRefuse with image, fixes, labels)
end

define parkTls with image, labels
  parkMsg with image, labels, "msg_tls_args", "tls_connect needs a host, a port, a name, and a ca file"
  parkMsg with image, labels, "msg_tls_hs", "tls handshake failed"
  parkMsg with image, labels, "msg_tls_send", "tls_send needs a connection and text"
  parkMsg with image, labels, "msg_tls_recv", "tls_recv needs a connection and a size"
  parkMsg with image, labels, "msg_tls_listen", "native tls_listen is fail-closed; outbound tls_connect is the FCG path"
  parkMsg with image, labels, "msg_tls_pe", "native tls on windows pe uses Schannel; prove that handshake on a Windows box"
  parkMsg with image, labels, "msg_tls_ver", "openssl must be 3.0 or newer"
  let image be alignTo with image, 8
  pin with labels, "tls_ctx", image
  let image be emitU64 with image, 0
  pin with labels, "tls_ssl", image
  let image be emitU64 with image, 0
  pin with labels, "tls_fd", image
  let image be emitU64 with image, 0
  pin with labels, "tls_captr", image
  let image be emitU64 with image, 0
  pin with labels, "tls_got_head", image
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let image be emitU64 with image, 0
  let names be tlsGotNames
  let i be 0
  while i < (length with names)
    pin with labels, (names at i), image
    let image be emitU64 with image, 0
    let i be i + 1
  end
  return image
end
