~ Two guests, one instruction each slice. Shared cell 0 must become 5.
~ Opcodes: 1 load-immediate, 2 add cell, 3 store cell, 4 halt.

define main
  let mem be [0]
  let tasks be [{"code": [1, 2, 3, 0, 4], "ip": 0, "acc": 0, "halt": 0}, {"code": [1, 3, 2, 0, 3, 0, 4], "ip": 0, "acc": 0, "halt": 0}]
  let turn be 0
  let running be 2
  while running > 0
    let task be tasks at turn
    if (task at "halt") == 0
      let code be task at "code"
      let ip be task at "ip"
      let op be code at ip
      if op == 1
        let acc be code at (ip + 1)
        put acc into task at "acc"
        put (ip + 2) into task at "ip"
      else if op == 2
        let cell be code at (ip + 1)
        let acc be (task at "acc") + (mem at cell)
        put acc into task at "acc"
        put (ip + 2) into task at "ip"
      else if op == 3
        let cell be code at (ip + 1)
        put task at "acc" into mem at cell
        put (ip + 2) into task at "ip"
      else if op == 4
        put 1 into task at "halt"
        put (ip + 1) into task at "ip"
        let running be running - 1
      end
    end
    let turn be turn + 1
    if turn == 2
      let turn be 0
    end
  end
  if (mem at 0) == 5
    say "cpu pass"
  else
    say "cpu fail"
  end
end
