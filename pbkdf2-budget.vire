use "src/rt-crypto.vire"

define main
  let xs be args
  let n be length with xs
  let rounds be 1
  if n > 0
    let rounds be number with (xs at 0)
  end
  let tab be make_xor_tab
  let p be ascii_bytes with "passwd"
  let s be ascii_bytes with "salt"
  let got be pbkdf2_sha256_hex_tab with tab, (p at 1), (s at 1), rounds, 64
  if (got at 0) != "ok"
    say "bad " + (got at 1)
    halt with 1
  end
  say "rounds " + (text with rounds) + " " + (got at 1)
end
