~ Native FCG unauth JSON: GET /health, /api/health, /info, /connect (PE and ELF).
~ Body fields follow in-tree api/fcgcpa.vire (fcgcpa-prod main 5cc11020 is private
~ to this token). These paths are unauthenticated in the Node inventory.
~ Recorded contracts: tests/rebuild/contracts/fcg-*.json
~ Differential harness: tools/rebuild-health-diff.sh
~ Native HTTP status follows JSON "status" via rt_net_statusof (host StatusOf).

define route with method, path, body
  if method == "GET"
    if path == "/health"
      return "{\"ok\":true,\"service\":\"fcgcpa\",\"payments\":false}"
    end
    if path == "/api/health"
      return "{\"ok\":true,\"service\":\"fcgcpa\",\"payments\":false}"
    end
    if path == "/info"
      return "{\"service\":\"fcgcpa\",\"role\":\"web2-frontdoor\",\"shell\":\"skinned-browser\",\"connect\":[\"twitch\",\"youtube\"],\"chain\":\"local\",\"chainId\":\"local-demo\",\"mining\":\"local\",\"miningNetwork\":false,\"payments\":false}"
    end
    if path == "/connect"
      return "{\"twitch\":\"https://www.twitch.tv\",\"youtube\":\"https://www.youtube.com\"}"
    end
  end
  return "{\"ok\":false,\"status\":404,\"error\":\"not found\"}"
end

define main
  listen with 18080
end
