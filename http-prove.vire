~ Library proof (no listen). Host interpreter and native PE must print
~ the same lines. Exercises query decode, path params, headers, cookies,
~ chunked bodies, CORS, auth middleware, and wire rejects.
use "src/http.vire"

define main
  say (http_pct_decode with "hello%20world")
  say (http_pct_decode with "a%2Fb%2Bc")
  let t be http_target with "/api/search?q=hello%20world"
  say (t at "path")
  say ((t at "query") at "q")
  let u be http_match with "/api/users/:id", "/api/users/42"
  if u == none
    say "no-id"
  end
  if u != none
    say (u at "id")
  end
  let unmatched be http_match with "/api/users/:id", "/api/posts/42"
  if unmatched == none
    say "unmatched"
  end
  let hdrs be http_parse_headers with "GET /x HTTP/1.1\r\nHost: x\r\nX-Foo: Bar\r\nCookie: sid=abc; k=v\r\n\r\n"
  say (http_header_get with hdrs, "x-foo")
  say (http_header_get with hdrs, "HOST")
  let jar be http_parse_cookies with (hdrs at "cookie")
  say (jar at "sid")
  say (http_set_cookie with "sid", "abc")
  let cors be http_cors with "https://example.com"
  say (cors at "allowOrigin")
  let ch be http_decode_chunked with "5\r\nhello\r\n0\r\n\r\n"
  say ch
  let badch be http_decode_chunked with "zz\r\n"
  if badch == none
    say "badchunk"
  end
  let smuggle be http_parse_headers with "POST /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\n"
  say (http_reject_wire with smuggle)
  let dup be http_parse_headers with "POST /x HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\n"
  say (http_reject_wire with dup)
  say (http_app with "GET", "/health", "")
  say (http_app with "GET", "/api/users/7", "")
  say (http_app with "GET", "/api/search?q=hi%20there", "")
  say (http_app with "POST", "/api/echo", "xyz")
  say (http_app with "GET", "/api/secure?token=demo", "")
  say (http_app with "GET", "/api/secure", "")
  say (http_app with "GET", "/api/who?cookie=sid%3Dabc", "")
  say (http_app with "POST", "/api/login", "")
  say (http_app with "GET", "/api/cors?origin=https%3A%2F%2Fex.test", "")
  say (http_app with "POST", "/api/chunk", "4\r\nping\r\n0\r\n\r\n")
  say (http_text_wrap with "plain")
end
